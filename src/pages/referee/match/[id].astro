---
import Layout from '@/layouts/Layout.astro'
import { getMatchByIdWithTeams, getMatchById, getMatchEvents, getDb, getTeamSquadByTeamId, isMatchEditable } from '../../../../server/db'

const { id } = Astro.params

if (!id) {
  return Astro.redirect('/referee')
}

const match = await getMatchByIdWithTeams(id)
if (!match) {
  return Astro.redirect('/referee')
}

const events = await getMatchEvents(id)

const matchData = await getMatchById(id)
const matchDuration = matchData?.tournament_id
  ? (await (await getDb()).execute({ sql: 'SELECT match_duration FROM tournaments WHERE id = ?', args: [matchData.tournament_id] })).rows[0]?.match_duration ?? 90
  : 90
const halfTimeSecs = Math.floor((matchDuration * 60) / 2)
// Load squads for both teams so referee can select players
let homeSquad: any[] = []
let awaySquad: any[] = []
if (match.home_team_id) {
  try { homeSquad = await getTeamSquadByTeamId(match.home_team_id) } catch {}
}
if (match.away_team_id) {
  try { awaySquad = await getTeamSquadByTeamId(match.away_team_id) } catch {}
}

const homeGoals = events.filter(e => e.type === 'goal' && e.team === 'A').length
const awayGoals = events.filter(e => e.type === 'goal' && e.team === 'B').length

const isLive = match.status === 'live'
const isFinished = match.status === 'completed' || match.status === 'finished'
const isCancelled = match.status === 'cancelled'

let isEditable = true
if (isFinished) {
  try { isEditable = await isMatchEditable(id) } catch {}
}

let statusLabel = 'PROGRAMADO'
if (isLive) statusLabel = 'EN VIVO'
if (isFinished) statusLabel = isEditable ? 'FINALIZADO (editable)' : 'FINALIZADO'
if (isCancelled) statusLabel = 'CANCELADO'

const teamAName = match.home_team_name || 'LOCAL'
const teamBName = match.away_team_name || 'VISITA'
const teamAColor = match.home_team_color || '#00ff88'
const teamBColor = match.away_team_color || '#f59e0b'

const serializedEvents = JSON.stringify(events.map(e => ({
  id: e.id,
  minute: e.minute,
  team: e.team,
  type: e.type,
  player: e.player,
  player2: e.player2 || '',
  detail: e.detail || '',
  team_request_id: e.team_request_id || '',
})))

const serializedHomeSquad = JSON.stringify(homeSquad.map(s => ({
  id: s.id,
  name: s.player_name,
  player_image_card: s.player_image_card,
  position: s.player_position,
})))
const serializedAwaySquad = JSON.stringify(awaySquad.map(s => ({
  id: s.id,
  name: s.player_name,
  player_image_card: s.player_image_card,
  position: s.player_position,
})))
---

<Layout>
  <div id="mo-app" class="mo-root">

    <!-- ════ FONDO ESPACIAL ════ -->
    <div class="mo-bg" aria-hidden="true">
      <div class="mo-bg-glow-top"></div>
      <div class="mo-bg-stars"></div>
      <div class="mo-bg-scanlines"></div>
      <div class="mo-field-arc"></div>
    </div>

    <!-- ════ VISTA: PARTIDO ACTIVO ════ -->
    <div id="mo-view-match" class="mo-page">

      <header class="mo-topbar">
        <a href="/referee" id="mo-back-btn" class="mo-back-btn" aria-label="Volver a partidos">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
          Volver
        </a>
        <span class="mo-section-label truncate text-center flex-1 !mb-0 !mt-0" id="mo-match-round">
          {match.round_label || `Jornada ${match.round}`}
        </span>
        <span class="mo-role-chip" id="mo-match-role-chip">Árbitro</span>
      </header>

      <!-- ─── START / END MATCH ─── -->
      {!isLive && !isFinished && !isCancelled && (
        <div class="flex justify-center mt-4 mb-2">
          <button id="mo-start-match" class="mo-start-btn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            COMENZAR PARTIDO
          </button>
        </div>
      )}
      {isLive && (
        <div class="flex justify-center mt-4 mb-2">
          <button id="mo-end-match" class="mo-end-btn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
            FINALIZAR PARTIDO
          </button>
        </div>
      )}

      <!-- ─── Marcador ─── -->
      <div id="mo-scoreboard" class="mo-scoreboard mt-5">
        <div id="mo-sb-topbar" class="mo-sb-topbar" style="background:linear-gradient(90deg,{teamAColor} 0%,transparent 50%,{teamBColor} 100%)"></div>
        <div class="mo-sb-scanlines" aria-hidden="true"></div>

        <div class="mo-sb-team">
          <div class="mo-sb-color-bar" id="mo-sb-color-a" style="background:{teamAColor}"></div>
          <span class="mo-sb-name" id="mo-sb-name-a">{teamAName}</span>
          <span class="mo-sb-score" id="mo-sb-score-a">{homeGoals}</span>
        </div>

        <div class="mo-sb-center">
          <span class="mo-timer-display font-mono" id="mo-timer-display">00:00</span>
          <button id="mo-timer-btn" class="mo-timer-btn">
            <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            <span id="mo-timer-label">Iniciar</span>
          </button>
          <span class="mo-vs-text">VS</span>
        </div>

        <div class="mo-sb-team mo-sb-team--right">
          <div class="mo-sb-color-bar mo-sb-color-bar--right" id="mo-sb-color-b" style="background:{teamBColor}"></div>
          <span class="mo-sb-name" id="mo-sb-name-b">{teamBName}</span>
          <span class="mo-sb-score" id="mo-sb-score-b">{awayGoals}</span>
        </div>
      </div>

      <!-- ─── Indicador de tiempo ─── -->
      <div id="mo-half-indicator" class="mo-half-indicator mt-5" style="display:none">
        <span class="mo-section-label !mb-0">DESCANSO</span>
        <button id="mo-start-second-half" class="mo-start-btn mt-2">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          INICIAR SEGUNDO TIEMPO
        </button>
      </div>

      <!-- ─── Acciones ─── -->
      <p class="mo-section-label mt-7 mb-3">Registrar evento</p>
      <div class="mo-actions-grid">

        <button data-type="yellow" class="mo-action-btn">
          <span class="mo-action-icon" style="background:rgba(120,53,15,.5);border-color:rgba(251,191,36,.2);color:#fbbf24">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/></svg>
          </span>
          <span class="mo-action-label">Amarilla</span>
        </button>

        <button data-type="red" class="mo-action-btn">
          <span class="mo-action-icon" style="background:rgba(127,29,29,.5);border-color:rgba(248,113,113,.2);color:#f87171">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/></svg>
          </span>
          <span class="mo-action-label">Roja</span>
        </button>

        <button data-type="goal" class="mo-action-btn">
          <span class="mo-action-icon" style="background:rgba(6,78,59,.5);border-color:rgba(0,255,136,.2);color:#00ff88">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
          </span>
          <span class="mo-action-label">Gol</span>
        </button>

        <button data-type="change" class="mo-action-btn">
          <span class="mo-action-icon" style="background:rgba(76,29,149,.5);border-color:rgba(196,181,253,.2);color:#c4b5fd">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
          </span>
          <span class="mo-action-label">Cambio</span>
        </button>

        <button data-type="shot" class="mo-action-btn">
          <span class="mo-action-icon" style="background:rgba(12,74,110,.5);border-color:rgba(125,211,252,.2);color:#7dd3fc">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </span>
          <span class="mo-action-label">Tiro</span>
        </button>

        <button data-type="foul" class="mo-action-btn">
          <span class="mo-action-icon" style="background:rgba(39,39,42,.7);border-color:rgba(161,161,170,.15);color:#a1a1aa">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          </span>
          <span class="mo-action-label">Falta</span>
        </button>

      </div>

      <!-- ─── Log ─── -->
      <div class="flex items-center justify-between mt-7 mb-3">
        <p class="mo-section-label !mb-0 !mt-0">Eventos del partido</p>
        <button id="mo-log-clear" class="mo-clear-btn">Limpiar todo</button>
      </div>
      <div class="flex flex-col gap-2 pb-12 p-2" id="mo-log-list"></div>

    </div>

    <!-- ════ MODAL ════ -->
    <div id="mo-modal-overlay" class="hidden fixed inset-0 bg-black/85 backdrop-blur-sm z-50 items-end justify-center" aria-modal="true" role="dialog" aria-label="Registrar evento">
      <div class="mo-modal">
        <div class="mo-modal-handle"></div>
        <span class="hud-corner hud-corner--tl"></span>
        <span class="hud-corner hud-corner--tr"></span>
        <span class="hud-corner hud-corner--bl"></span>
        <span class="hud-corner hud-corner--br"></span>

        <div class="px-5 pt-5 pb-3 flex flex-col gap-1.5">
          <span id="mo-modal-badge" class="mo-event-badge w-fit"></span>
          <h3 id="mo-modal-title" class="text-base font-bold text-[var(--cream)] font-cinzel tracking-wide uppercase"></h3>
        </div>

        <div class="px-5 pb-4 flex flex-col gap-4">
          <div class="mo-field-group">
            <label class="mo-field-label" for="mo-m-team">Equipo</label>
            <select id="mo-m-team" class="mo-select"></select>
          </div>
          <div class="mo-field-group">
            <label class="mo-field-label" for="mo-m-player">Jugador</label>
            <input id="mo-m-player" type="text" placeholder="Nombre o dorsal" autocomplete="off" class="mo-input" />
            <div id="mo-player-results" class="flex flex-col gap-[2px] max-h-[140px] overflow-y-auto mt-1"></div>
          </div>
          <div id="mo-m-extra"></div>
          <div class="mo-field-group">
            <label class="mo-field-label">Minuto</label>
            <div class="flex items-center gap-3">
              <button id="mo-min-minus" class="mo-min-adj" type="button">−</button>
              <input id="mo-m-minute" type="number" min="0" max="150" placeholder="0" class="mo-input text-center text-xl font-black flex-1" />
              <button id="mo-min-plus" class="mo-min-adj" type="button">+</button>
            </div>
          </div>
        </div>

        <div class="px-5 justify-between pb-5 pt-4 flex gap-2.5 border-t border-[rgba(199,168,107,.12)]">
          <button id="mo-modal-cancel" class="mo-btn-ghost">Cancelar</button>
          <button id="mo-modal-save" class="mo-btn-primary">Guardar evento</button>
        </div>
      </div>
    </div>

    <!-- ════ SSR DATA BRIDGE ════ -->
    <div id="mo-ssr-data"   data-match-id={id}
  data-team-a={teamAName}
  data-team-b={teamBName}
  data-team-a-color={teamAColor}
  data-team-b-color={teamBColor}
  data-events={serializedEvents}
  data-elapsed-seconds={matchData?.elapsed_seconds ?? 0}
  data-match-duration={matchDuration}
  data-half-time={halfTimeSecs}
  data-home-squad={serializedHomeSquad}
  data-away-squad={serializedAwaySquad}
  data-editable={isEditable ? 'true' : 'false'}
  style="display:none"></div>
  </div>

<style>
  /* ════════════════════════════════
     TOKENS
  ════════════════════════════════ */
  #mo-app {
    --gold:     var(--color-theme-gold,    #c7a86b);
    --cream:    var(--color-theme-cream,   #e8dcc8);
    --midnight: var(--color-theme-midnight,#0a0e1a);
    --green:    #00ff88;
    --border:   rgba(199,168,107,.14);
    --surface:  rgba(255,255,255,.03);
  }
  .mo-min-adj {
    width: 44px; height: 44px;
    border-radius: 12px;
    font-size: 1.2rem;
    font-weight: 900;
    border: 1px solid rgba(255,255,255,.12);
    background: rgba(255,255,255,.06);
    color: rgba(232,220,200,.6);
    cursor: pointer;
    transition: all .15s;
  }
  .mo-min-adj:hover {
    background: rgba(255,255,255,.12);
    color: var(--cream);
  }

  /* ════════════════════════════════
     ROOT
  ════════════════════════════════ */
  .mo-root {
    position: relative;
    min-height: 100svh;
    background: radial-gradient(ellipse at 50% -10%,#0b2a1a 0%,#050d08 55%,#03080e 100%);
    overflow-x: hidden;
    padding: 6rem 1.5rem 5rem;
  }
  .mo-page {
    position: relative; z-index: 1;
    max-width: 500px; margin: 0 auto;
    padding: 1.25rem 1rem 2rem;
  }

  /* ════════════════════════════════
     FONDO
  ════════════════════════════════ */
  .mo-bg { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
  .mo-bg-glow-top {
    position: absolute; top: -15%; left: 50%; transform: translateX(-50%);
    width: 65%; height: 55%;
    background: radial-gradient(ellipse,rgba(0,255,136,.14) 0%,transparent 70%);
    filter: blur(70px);
    animation: glowPulse 6s ease-in-out infinite alternate;
  }
  @keyframes glowPulse { 0%{opacity:.35} 100%{opacity:.85} }

  .mo-bg-stars {
    position: absolute; inset: 0;
    background-image:
      radial-gradient(1.5px 1.5px at 8%  15%,#fff,transparent),
      radial-gradient(1px   1px   at 25% 60%,#aaffcc,transparent),
      radial-gradient(2px   2px   at 51% 10%,#a855f7,transparent),
      radial-gradient(1px   1px   at 70% 78%,#fff,transparent),
      radial-gradient(2px   2px   at 87% 35%,#00ff88,transparent),
      radial-gradient(1px   1px   at 17% 84%,#c084fc,transparent),
      radial-gradient(1.5px 1.5px at 61% 49%,#fff,transparent);
    background-size: 260px 260px; opacity:.35;
    animation: twinkle 7s ease-in-out infinite alternate;
  }
  @keyframes twinkle { 0%{opacity:.15} 100%{opacity:.5} }

  .mo-bg-scanlines {
    position: absolute; inset: 0;
    background: repeating-linear-gradient(
      0deg,transparent,transparent 3px,
      rgba(0,255,136,.007) 3px,rgba(0,255,136,.007) 4px
    );
  }
  .mo-field-arc {
    position: absolute; bottom: -6vw; left: 50%; transform: translateX(-50%);
    width: 60vw; height: 15vw;
    border-radius: 50% 50% 0 0/100% 100% 0 0;
    border: 1px solid rgba(0,255,136,.06);
  }

  /* ════════════════════════════════
     TOPBAR
  ════════════════════════════════ */
  .mo-topbar {
    display: flex; align-items: center; justify-content: space-between; gap: .75rem;
    padding: .85rem 1.1rem;
    background: rgba(0,0,0,.3);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(255,255,255,.07);
    border-radius: 16px; margin-bottom: .5rem;
  }
  .mo-eyebrow { font-size: .44rem; font-weight: 700; letter-spacing: .25em; text-transform: uppercase; color: rgba(0,255,136,.5); }
  .mo-topbar-title { font-size: .82rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; color: var(--cream); }
  .mo-live-dot {
    width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0;
    background: var(--green); box-shadow: 0 0 12px var(--green);
    animation: blink 1.2s ease-in-out infinite;
  }
  @keyframes liveBlink { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.3;transform:scale(.7)} }

  .mo-role-chip {
    display: flex; align-items: center; gap: .35rem;
    font-size: .5rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
    color: rgba(232,220,200,.5);
    border: 1px solid var(--border);
    border-radius: 99px; padding: .25rem .7rem;
    background: var(--surface);
    white-space: nowrap;
  }

  .mo-back-btn {
    display: flex; align-items: center; gap: .4rem;
    font-size: .55rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
    color: rgba(232,220,200,.4); background: none; border: none; cursor: pointer; text-decoration: none;
    transition: color .2s;
  }
  .mo-back-btn:hover { color: var(--green); }

  .mo-logout-btn {
    display: flex; align-items: center; justify-content: center;
    width: 30px; height: 30px; border-radius: 8px;
    color: rgba(239,68,68,.6);
    background: rgba(239,68,68,.08);
    border: 1px solid rgba(239,68,68,.15);
    cursor: pointer;
    transition: all .2s;
    flex-shrink: 0;
  }
  .mo-logout-btn:hover {
    background: rgba(239,68,68,.2);
    color: #ef4444;
    box-shadow: 0 0 12px rgba(239,68,68,.1);
  }

  /* ════════════════════════════════
     SECTION LABEL
  ════════════════════════════════ */
  .mo-section-label {
    display: block;
    font-size: .5rem; font-weight: 700; letter-spacing: .25em; text-transform: uppercase;
    color: rgba(0,255,136,.6);
    margin-bottom: .5rem;
  }

  /* ════════════════════════════════
     MATCH CARDS (from list)
  ════════════════════════════════ */
  .mo-card {
    background: linear-gradient(160deg, color-mix(in srgb, var(--midnight) 88%, var(--green)) 0%, var(--midnight) 100%);
    border: 1px solid rgba(199,168,107,.12);
    transition: all 0.4s cubic-bezier(0.4,0,0.2,1);
  }
  .mo-card:hover { border-color: rgba(199,168,107,.3); }
  .mo-card-topline { position: absolute; top:0;left:0;right:0;height:2px; }
  .mo-card-glow {
    position: absolute; inset:0; pointer-events:none;
    background: radial-gradient(ellipse at 50% 0%,rgba(0,255,136,.06),transparent 55%);
    opacity:0; transition:opacity .25s;
  }
  .mo-card:hover .mo-card-glow { opacity:1; }

  .hud-corner {
    position: absolute;
    width: 12px; height: 12px;
    border-style: solid;
    border-color: rgba(199,168,107,.25);
    pointer-events: none;
    z-index: 2;
    transition: all .3s ease;
  }
  .hud-corner--tl{top:6px;left:6px;border-width:1.5px 0 0 1.5px}
  .hud-corner--tr{top:6px;right:6px;border-width:1.5px 1.5px 0 0}
  .hud-corner--bl{bottom:6px;left:6px;border-width:0 0 1.5px 1.5px}
  .hud-corner--br{bottom:6px;right:6px;border-width:0 1.5px 1.5px 0}
  .mo-card:hover .hud-corner {
    border-color: rgba(0,255,136,.5);
    width: 16px; height: 16px;
  }

  .mo-modal .hud-corner { border-color:color-mix(in srgb,var(--gold) 35%,transparent); }

  .mo-status-live     { background:rgba(6,78,59,.8);     color:#34d399; border:1px solid rgba(52,211,153,.3); }
  .mo-status-upcoming { background:rgba(39,39,42,.8);    color:#a1a1aa; border:1px solid rgba(161,161,170,.2); }
  .mo-status-finished { background:rgba(76,29,149,.8);   color:#c4b5fd; border:1px solid rgba(196,181,253,.3); }

  .mo-modal-handle {
    width: 40px; height: 4px;
    border-radius: 99px;
    background: rgba(255,255,255,.12);
    margin: 12px auto 0;
  }
  .hud-corner--tl { top: 12px; left: 12px; border-width: 2px 0 0 2px; }
  .hud-corner--tr { top: 12px; right: 12px; border-width: 2px 2px 0 0; }
  .hud-corner--bl { bottom: 12px; left: 12px; border-width: 0 0 2px 2px; }
  .hud-corner--br { bottom: 12px; right: 12px; border-width: 0 2px 2px 0; }

  /* ════════════════════════════════
     START / END BUTTONS
  ════════════════════════════════ */
  .mo-start-btn {
    display: flex; align-items: center; gap: .5rem;
    padding: .6rem 1.4rem;
    border-radius: 12px;
    font-size: .6rem; font-weight: 900; letter-spacing: .15em; text-transform: uppercase;
    background: linear-gradient(135deg,#00ff88,#00cc6a);
    color: #050d08;
    border: none;
    cursor: pointer;
    box-shadow: 0 0 24px rgba(0,255,136,.25);
    transition: all .3s;
  }
  .mo-start-btn:hover {
    box-shadow: 0 0 40px rgba(0,255,136,.4);
    transform: scale(1.02);
  }
  .mo-end-btn {
    display: flex; align-items: center; gap: .5rem;
    padding: .6rem 1.4rem;
    border-radius: 12px;
    font-size: .6rem; font-weight: 900; letter-spacing: .15em; text-transform: uppercase;
    background: linear-gradient(135deg,#ef4444,#dc2626);
    color: #fff;
    border: none;
    cursor: pointer;
    box-shadow: 0 0 24px rgba(239,68,68,.25);
    transition: all .3s;
  }
  .mo-end-btn:hover {
    box-shadow: 0 0 40px rgba(239,68,68,.4);
    transform: scale(1.02);
  }

  /* ════════════════════════════════
     SCOREBOARD
  ════════════════════════════════ */
  .mo-scoreboard {
    position: relative;
    display: grid; grid-template-columns: 1fr auto 1fr;
    align-items: center; gap: .75rem;
    background: linear-gradient(160deg,
      color-mix(in srgb,var(--midnight) 88%,#00ff88) 0%,
      var(--midnight) 100%
    );
    border: 1px solid var(--border);
    border-radius: 18px; padding: 1.1rem 1rem;
    overflow: hidden;
  }
  .mo-sb-topbar {
    position:absolute;top:0;left:0;right:0;height:2px;opacity:.65;
  }
  .mo-sb-scanlines {
    position:absolute;inset:0;pointer-events:none;
    background:repeating-linear-gradient(
      0deg,transparent,transparent 3px,
      rgba(0,255,136,.008) 3px,rgba(0,255,136,.008) 4px
    );
  }
  .mo-sb-team { display:flex;flex-direction:column;gap:.35rem;position:relative;z-index:1; }
  .mo-sb-team--right { align-items:flex-end; }
  .mo-sb-color-bar { height:3px;width:24px;border-radius:99px; }
  .mo-sb-color-bar--right { margin-left:auto; }
  .mo-sb-name {
    font-size:.6rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;
    color:rgba(232,220,200,.55);
  }
  .mo-sb-score {
    font-size:2.8rem;font-weight:900;line-height:1;
    color:var(--cream);
  }
  .mo-sb-center {
    display:flex;flex-direction:column;align-items:center;gap:.45rem;
    position:relative;z-index:1;
  }
  .mo-timer-display {
    font-size:1.3rem;font-weight:700;letter-spacing:.04em;color:var(--cream);
  }
  .mo-timer-btn {
    display:flex;align-items:center;gap:.35rem;
    font-family:var(--font-cinzel,'Cinzel'),serif;
    font-size:.48rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;
    color:rgba(0,255,136,.7);
    background:rgba(0,255,136,.07);
    border:1px solid rgba(0,255,136,.25);
    border-radius:99px;padding:.3rem .7rem;
    cursor:pointer;transition:background .2s,border-color .2s,color .2s,box-shadow .2s;
  }
  .mo-timer-btn:hover,.mo-timer-btn.active {
    background:rgba(0,255,136,.14);border-color:rgba(0,255,136,.55);
    color:var(--green);box-shadow:0 0 14px rgba(0,255,136,.2);
  }
  .mo-vs-text {
    font-size:.55rem;font-weight:900;letter-spacing:.15em;
    color:rgba(0,255,136,.4);
  }

  /* ════════════════════════════════
     ACTION BUTTONS
  ════════════════════════════════ */
  .mo-actions-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:.6rem; }
  .mo-action-btn {
    display:flex;flex-direction:column;align-items:center;gap:.55rem;
    padding:.9rem .5rem;
    background:linear-gradient(160deg,
      color-mix(in srgb,var(--midnight) 88%,#00ff88) 0%,
      var(--midnight) 100%
    );
    border:1px solid var(--border);border-radius:14px;
    cursor:pointer;transition:border-color .2s,transform .15s,box-shadow .2s,background .2s;
    position:relative;overflow:hidden;
  }
  .mo-action-btn:hover {
    border-color:rgba(0,255,136,.3);transform:translateY(-2px);
    box-shadow:0 0 16px rgba(0,255,136,.08);
  }
  .mo-action-btn:active { transform:scale(.96); }
  .mo-action-icon {
    width:40px;height:40px;border-radius:10px;border:1px solid;
    display:flex;align-items:center;justify-content:center;
    transition:transform .2s,box-shadow .2s;
  }
  .mo-action-btn:hover .mo-action-icon { transform:scale(1.08); }
  .mo-action-label {
    font-size:.52rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;
    color:rgba(232,220,200,.55);transition:color .2s;
  }
  .mo-action-btn:hover .mo-action-label { color:rgba(232,220,200,.85); }

  /* ════════════════════════════════
     LOG
  ════════════════════════════════ */
  .mo-clear-btn {
    font-size:.5rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;
    color:rgba(232,220,200,.25);background:none;border:none;cursor:pointer;
    transition:color .2s;
  }
  .mo-clear-btn:hover { color:#ef4444; }

  .mo-log-entry {
    display:flex;align-items:flex-start;gap:.75rem;
    background:linear-gradient(160deg,
      color-mix(in srgb,var(--midnight) 90%,#00ff88) 0%,
      var(--midnight) 100%
    );
    border:1px solid var(--border);border-radius:12px;
    padding:.7rem .85rem;
    animation:logIn .2s ease both;
  }
  @keyframes logIn { from{opacity:0;transform:translateY(-4px)} to{opacity:1;transform:none} }

  .mo-log-min {
    font-family:monospace;font-size:.62rem;font-weight:700;
    color:rgba(0,255,136,.6);min-width:26px;padding-top:.05rem;
  }
  .mo-log-icon {
    width:26px;height:26px;border-radius:8px;
    display:flex;align-items:center;justify-content:center;
    font-size:.85rem;flex-shrink:0;border:1px solid;
  }
  .mo-log-info { flex:1;min-width:0; }
  .mo-log-event-title {
    font-size:.65rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;
    color:var(--cream);line-height:1.3;
  }
  .mo-log-event-sub {
    font-size:.55rem;color:rgba(232,220,200,.4);margin-top:.15rem;
    white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  }
  .mo-log-del {
    color:rgba(232,220,200,.2);background:none;border:none;cursor:pointer;
    flex-shrink:0;padding-top:.1rem;transition:color .2s;
  }
  .mo-log-del:hover { color:#ef4444; }

  /* ════════════════════════════════
     MODAL
  ════════════════════════════════ */
  .mo-modal {
    position:relative;
    background:linear-gradient(160deg,
      color-mix(in srgb,var(--midnight) 88%,#00ff88) 0%,
      var(--midnight) 100%
    );
    border:1px solid color-mix(in srgb,var(--gold) 22%,transparent);
    border-radius:18px;width:100%;max-width:360px;overflow:hidden;
    animation:modalIn .22s cubic-bezier(.22,1,.36,1) both;
    border-radius: 24px 24px 0 0;
  }
  @keyframes modalIn {
    from{opacity:0;transform:translateY(60px)}
    to{opacity:1;transform:none}
  }
  .mo-event-badge {
    display:inline-block;
    font-size:.48rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;
    padding:.2rem .65rem;border-radius:99px;border:1px solid;
  }
  .mo-field-group { display:flex;flex-direction:column;gap:.35rem; }
  .mo-field-label {
    font-size:.48rem;font-weight:700;letter-spacing:.2em;text-transform:uppercase;
    color:rgba(232,220,200,.4);
  }
  .mo-input, .mo-select {
    width:100%;
    padding:.65rem .85rem;
    border-radius:10px;
    border:1px solid color-mix(in srgb,var(--gold) 18%,transparent);
    background:rgba(255,255,255,.03);
    color:var(--cream);
    font-size:.68rem;letter-spacing:.04em;
    outline:none;caret-color:var(--green);
    transition:border-color .2s,box-shadow .2s,background .2s;
  }
  .mo-input::placeholder { color:rgba(232,220,200,.2);font-size:.62rem; }
  .mo-input:focus,.mo-select:focus {
    border-color:rgba(0,255,136,.4);background:rgba(0,255,136,.025);
    box-shadow:0 0 0 3px rgba(0,255,136,.06);
  }
  .mo-select option { background:var(--midnight);color:var(--cream); }
  .mo-btn-ghost {
    font-size:.58rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;
    color:rgba(232,220,200,.45);
    background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);
    border-radius:99px;padding:.5rem 1rem;cursor:pointer;
    transition:background .2s,color .2s;
  }
  .mo-btn-ghost:hover { background:rgba(255,255,255,.07);color:rgba(232,220,200,.75); }
  .mo-btn-primary {
    font-size:.58rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase;
    color:var(--midnight);
    background:var(--gold);
    border:none;border-radius:99px;padding:.5rem 1.25rem;cursor:pointer;
    transition:filter .2s,transform .15s,box-shadow .2s;
  }
  .mo-btn-primary:hover {
    filter:brightness(1.1);transform:translateY(-1px);
    box-shadow:0 0 20px rgba(199,168,107,.3);
  }
  .mo-btn-primary:active { transform:scale(.97); }

  .mo-half-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .25rem;
    padding: 1.5rem 1rem;
    border-radius: 14px;
    background: linear-gradient(160deg, rgba(251,191,36,.06) 0%, transparent 100%);
    border: 1px solid rgba(251,191,36,.15);
  }
  .mo-half-indicator + .mo-actions-grid { margin-top: 1.5rem; }
</style>

<script>
(function () {
  const SSR = document.getElementById('mo-ssr-data')?.dataset;
  const MATCH_ID = SSR?.matchId;
  const TEAM_A = SSR?.teamA || 'LOCAL';
  const TEAM_B = SSR?.teamB || 'VISITA';
  const COLOR_A = SSR?.teamAColor || '#00ff88';
  const COLOR_B = SSR?.teamBColor || '#f59e0b';
  const MATCH_DURATION = parseInt(SSR?.matchDuration || '90', 10);
  const MAX_SECONDS = MATCH_DURATION * 60;
  const HALF_TIME = parseInt(SSR?.halfTime || '0', 10) || Math.floor(MAX_SECONDS / 2);
  const IS_EDITABLE = SSR?.editable !== 'false';

  // Parse squad data
  let homeSquad = [], awaySquad = [];
  try { homeSquad = JSON.parse(SSR?.homeSquad || '[]'); } catch {}
  try { awaySquad = JSON.parse(SSR?.awaySquad || '[]'); } catch {}
  const squadMap = { 'a': homeSquad, 'b': awaySquad };

  function renderPlayerSuggestions(query) {
    const container = $('mo-player-results');
    if (!container) return;
    const teamVal = $('mo-m-team')?.value || 'a';
    const players = squadMap[teamVal] || [];
    if (!query.trim()) { container.innerHTML = ''; return; }
    const q = query.toLowerCase().trim();
    const results = players.filter(p => p.name.toLowerCase().includes(q) || p.position?.toLowerCase().includes(q));
    if (!results.length) {
      container.innerHTML = '<div class="text-[0.48rem] text-white/20 text-center py-1">Sin resultados</div>';
      return;
    }
    container.innerHTML = results.map(p => {
      const sel = p.id === selectedPlayerTrid;
      return `<button type="button" class="w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg border border-transparent bg-white/[.04] text-cream/65 cursor-pointer font-body text-[0.6rem] leading-tight text-left transition-all duration-100 hover:bg-green-500/10 hover:border-green-500/20 hover:text-cream ${sel ? 'bg-green-500/15 border-green-500/30 text-cream' : ''}" data-trid="${p.id}" data-name="${p.name.replace(/"/g,'&quot;')}">
        ${p.player_image_card ? `<img class="w-[22px] h-[22px] rounded object-cover shrink-0 border border-theme-gold/15" src="${p.player_image_card}" />` : ''}
        <span class="font-semibold tracking-wide uppercase flex-1 min-w-0 text-theme-gold">${p.name}</span>
        <span class="text-[0.45rem] text-cream/25 uppercase tracking-wide shrink-0 text-white">${p.position || ''}</span>
        ${sel ? '<span class="text-green-400 text-[0.6rem] shrink-0">✓</span>' : ''}
      </button>`;
    }).join('');
    container.querySelectorAll('button').forEach(btn => {
      btn.addEventListener('click', () => {
        selectedPlayerTrid = btn.dataset.trid;
        $('mo-m-player').value = btn.dataset.name;
        $('mo-player-results').innerHTML = '';
      });
    });
  }

  function disableTimer() {
    const btn = $('mo-timer-btn');
    if (btn) {
      btn.disabled = true;
      btn.classList.remove('active');
      btn.style.opacity = '0.4';
      btn.style.cursor = 'not-allowed';
      btn.style.pointerEvents = 'none';
    }
    const lbl = $('mo-timer-label');
    if (lbl) lbl.textContent = 'FINALIZADO';
  }

  const EVENT_META = {
    yellow:{label:'Amarilla',icon:'🟨',iconBg:'rgba(120,53,15,.6)',  iconColor:'#fbbf24',iconBorder:'rgba(251,191,36,.25)'},
    red:   {label:'Roja',    icon:'🟥',iconBg:'rgba(127,29,29,.6)',  iconColor:'#f87171',iconBorder:'rgba(248,113,113,.25)'},
    goal:  {label:'Gol',     icon:'⚽',iconBg:'rgba(6,78,59,.6)',    iconColor:'#00ff88',iconBorder:'rgba(0,255,136,.3)'},
    change:{label:'Cambio',  icon:'🔄',iconBg:'rgba(76,29,149,.6)',  iconColor:'#c4b5fd',iconBorder:'rgba(196,181,253,.25)'},
    shot:  {label:'Tiro',    icon:'🎯',iconBg:'rgba(12,74,110,.6)',  iconColor:'#7dd3fc',iconBorder:'rgba(125,211,252,.25)'},
    foul:  {label:'Falta',   icon:'⚠️',iconBg:'rgba(39,39,42,.8)',   iconColor:'#a1a1aa',iconBorder:'rgba(161,161,170,.15)'},
  };

  const tKey  = id => 'velada_timer_' + id;

  let timerSec = 0, timerRunning = false, timerStartedAt = null, timerBase = 0;
  let timerInterval = null, currentEventType = null, selectedPlayerTrid = '';
  let isHalfTime = false, secondHalfStarted = false;

  const $ = id => document.getElementById(id);

  /* ── TIMER ── */
  function renderTimerDisplay(){
    const m = Math.floor(timerSec/60).toString().padStart(2,'0');
    const s = (timerSec%60).toString().padStart(2,'0');
    const halfLabel = isHalfTime ? 'DESC' : (secondHalfStarted || timerSec >= HALF_TIME ? '2T' : '1T');
    $('mo-timer-display').textContent = halfLabel + ' ' + m+':'+s;
  }
  function saveTimerState(){
    try {
      localStorage.setItem(tKey(MATCH_ID), JSON.stringify({
        elapsed: timerSec,
        running: timerRunning,
        startedAt: timerStartedAt,
        baseElapsed: timerBase,
      }));
    } catch {}
  }
  function loadTimerState(){
    try {
      const saved = localStorage.getItem(tKey(MATCH_ID));
      if (!saved) return { elapsed: 0, running: false, startedAt: null, baseElapsed: 0 };
      const st = JSON.parse(saved);
      if (st.running && st.startedAt && st.baseElapsed !== undefined) {
        const now = Date.now();
        st.elapsed = st.baseElapsed + Math.floor((now - st.startedAt) / 1000);
      }
      return st;
    } catch { return { elapsed: 0, running: false, startedAt: null, baseElapsed: 0 }; }
  }

  const savedState = loadTimerState();
  const ssrElapsed = parseInt(SSR?.elapsedSeconds || '0', 10);
  timerSec = savedState.elapsed || ssrElapsed;
  timerRunning = savedState.running;
  timerStartedAt = savedState.startedAt;
  timerBase = savedState.baseElapsed || 0;
  renderTimerDisplay();

  // Auto-resume if was running
  if (timerRunning && timerStartedAt) {
    $('mo-timer-btn').classList.add('active');
    $('mo-timer-label').textContent = 'Pausar';
    timerInterval = setInterval(tick, 1000);
  }

  let lastServerSave = 0;
  function saveElapsedToServer(){
    const now = Date.now();
    if (now - lastServerSave < 5000) return;
    lastServerSave = now;
    try {
      fetch('/api/matches', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'update', id: MATCH_ID, elapsedSeconds: timerSec }),
      });
    } catch {}
  }

  function tick(){
    if (timerRunning && timerStartedAt) {
      timerSec = timerBase + Math.floor((Date.now() - timerStartedAt) / 1000);
      // Half-time check
      if (!isHalfTime && !secondHalfStarted && timerSec >= HALF_TIME && timerSec < MAX_SECONDS) {
        timerSec = HALF_TIME;
        timerRunning = false;
        timerStartedAt = null;
        clearInterval(timerInterval);
        timerInterval = null;
        isHalfTime = true;
        renderTimerDisplay();
        saveTimerState();
        saveElapsedToServer();
        $('mo-half-indicator').style.display = 'flex';
        $('mo-timer-btn')?.classList.remove('active');
        $('mo-timer-label').textContent = 'DESCANSO';
        return;
      }
      if (timerSec >= MAX_SECONDS) {
        timerSec = MAX_SECONDS;
        timerRunning = false;
        timerStartedAt = null;
        clearInterval(timerInterval);
        timerInterval = null;
        disableTimer();
        renderTimerDisplay();
        saveTimerState();
        saveElapsedToServer();
        return;
      }
      renderTimerDisplay();
      saveTimerState();
      saveElapsedToServer();
    }
  }

  $('mo-timer-btn').addEventListener('click', () => {
    if (timerRunning) {
      // Pause
      timerRunning = false;
      timerStartedAt = null;
      clearInterval(timerInterval);
      timerInterval = null;
      $('mo-timer-btn').classList.remove('active');
      $('mo-timer-label').textContent = 'Reanudar';
      saveTimerState();
      return;
    }
    // Start / Resume
    timerBase = timerSec;
    timerRunning = true;
    timerStartedAt = Date.now();
    $('mo-timer-btn').classList.add('active');
    $('mo-timer-label').textContent = 'Pausar';
    timerInterval = setInterval(tick, 1000);
    saveTimerState();
  });

  /* ── LOAD EVENTS ── */
  async function loadEvents(){
    try {
      const res = await fetch('/api/matches/' + MATCH_ID + '/events');
      const data = await res.json();
      if (data.success) renderLog(data.events || []);
    } catch {}
  }

  /* ── RENDER LOG ── */
  function renderLog(events){
    const list = $('mo-log-list');
    if (!events || !events.length) {
      list.innerHTML = '<div class="text-center py-8"><p class="text-xs text-green-400/30 tracking-wider uppercase">Sin eventos registrados</p><p class="text-[0.52rem] text-cream/15 mt-2">Registra el primer evento del partido</p></div>';
      return;
    }

    list.innerHTML = events.map(e => {
      const m = EVENT_META[e.type] || EVENT_META.foul;
      const teamVal = e.team === 'B' ? 'b' : 'a';
      const teamColor = teamVal === 'a' ? COLOR_A : COLOR_B;
      const teamName = teamVal === 'a' ? TEAM_A : TEAM_B;
      let detail = e.detail || '';
      if (e.type === 'change' && e.player && e.player2) {
        detail = 'Sale: ' + e.player + '  ·  Entra: ' + e.player2;
      }
      return `
        <div class="mo-log-entry group relative flex items-start gap-3 p-3 rounded-xl border transition-all duration-200 hover:translate-x-0.5"
             style="background: linear-gradient(160deg, color-mix(in srgb, var(--midnight) 92%, var(--gold)) 0%, var(--midnight) 100%); border-color: var(--border);">
          <div class="absolute left-0 top-0 bottom-0 w-1 rounded-l-xl" style="background: ${teamColor};"></div>
          <span class="mo-log-min font-mono text-sm font-extrabold min-w-[2.5rem] text-center py-0.5 px-1.5 rounded-md"
                style="color: var(--gold); background: rgba(199,168,107,0.12);">${e.minute}'</span>
          <span class="mo-log-icon w-8 h-8 rounded-lg flex items-center justify-center text-base flex-shrink-0 border transition-transform duration-150 group-hover:scale-105 group-hover:shadow-md"
                style="background: ${m.iconBg}; color: ${m.iconColor}; border-color: ${m.iconBorder}; box-shadow: 0 0 8px ${teamColor}40;">${m.icon}</span>
          <div class="mo-log-info flex-1 min-w-0">
            <p class="mo-log-event-title text-xs font-extrabold tracking-wide uppercase" style="color: var(--cream);">${m.label} · ${teamName}</p>
            <p class="mo-log-event-sub text-[0.58rem] font-medium mt-0.5 truncate" style="color: rgba(232,220,200,0.5);">${e.player}${detail ? ' · ' + detail : ''}</p>
          </div>
          <button data-eid="${e.id}" class="mo-log-del flex-shrink-0 w-7 h-7 rounded-lg flex items-center justify-center transition-all duration-200 hover:scale-105"
                  style="color: rgba(232,220,200,0.25); background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05);"
                  aria-label="Eliminar evento">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>
        </div>`;
    }).join('');

    list.querySelectorAll('.mo-log-del').forEach(btn =>
      btn.addEventListener('click', async () => {
        if (!IS_EDITABLE) return;
        const eventId = btn.dataset.eid;
        try {
          await fetch('/api/matches/' + MATCH_ID + '/events', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'delete', eventId }),
          });
          await loadEvents();
          await updateScore();
        } catch {}
      })
    );
  }

  async function updateScore(){
    try {
      const res = await fetch('/api/matches/' + MATCH_ID + '/events');
      const data = await res.json();
      if (!data.success) return;
      const events = data.events || [];
      const ga = events.filter(e => e.type === 'goal' && e.team === 'A').length;
      const gb = events.filter(e => e.type === 'goal' && e.team === 'B').length;
      $('mo-sb-score-a').textContent = ga;
      $('mo-sb-score-b').textContent = gb;
    } catch {}
  }

  /* ── MODAL ── */
  function openModal(type){
    currentEventType = type;
    const meta = EVENT_META[type];
    const badge = $('mo-modal-badge');
    badge.textContent = meta.label;
    badge.style.background = meta.iconBg;
    badge.style.color = meta.iconColor;
    badge.style.borderColor = meta.iconBorder;
    $('mo-modal-title').textContent = 'Registrar · ' + meta.label;
    $('mo-m-team').innerHTML = `
      <option value="a">${TEAM_A}</option>
      <option value="b">${TEAM_B}</option>`;
    $('mo-m-player').value = '';
    selectedPlayerTrid = '';
    $('mo-player-results').innerHTML = '';
    $('mo-m-minute').value = Math.floor(timerSec / 60) || '';

    const extra = $('mo-m-extra');
    if (type === 'change') {
      extra.innerHTML = `
        <div class="mo-field-group flex flex-col gap-0.5 relative">
          <label class="text-xs gap-2 uppercase text-[rgba(232,220,200,.4)]" for="mo-m-out">Sale</label>
          <input id="mo-m-out" type="text" placeholder="Nombre o número" autocomplete="off" class="w-full px-[0.85rem] py-[0.65rem] rounded-[10px] border border-[color-mix(in_srgb,var(--gold)_18%,transparent)] bg-white/[0.03] text-[var(--cream)] text-xs tracking-[0.04em] outline-none caret-[var(--green)] transition-all duration-200">
        </div>
        <div class="mo-field-group flex flex-col gap-0.5 relative" style="margin-top:.75rem">
          <label class="text-xs gap-2 uppercase text-[rgba(232,220,200,.4)]" for="mo-m-in">Entra</label>
          <input id="mo-m-in" type="text" placeholder="Nombre o número" autocomplete="off" class="w-full px-[0.85rem] py-[0.65rem] rounded-[10px] border border-[color-mix(in_srgb,var(--gold)_18%,transparent)] bg-white/[0.03] text-[var(--cream)] text-xs tracking-[0.04em] outline-none caret-[var(--green)] transition-all duration-200">
        </div>`;
    } else if (type === 'shot') {
      extra.innerHTML = `
        <div class="mo-field-group flex flex-col gap-0.5 relative">
          <label class="text-xs gap-2 uppercase text-[rgba(232,220,200,.4)]" for="mo-m-shottype">Tipo de tiro</label>
          <select id="mo-m-shottype" class="w-full px-[0.85rem] py-[0.65rem] rounded-[10px] border border-[color-mix(in_srgb,var(--gold)_18%,transparent)] bg-white/[0.03] text-[var(--cream)] text-xs tracking-[0.04em] outline-none caret-[var(--green)] transition-all duration-200">
            <option>Al arco</option>
            <option>Gol (suma marcador)</option>
            <option>Bloqueado</option>
            <option>Afuera</option>
          </select>
        </div>`;
    } else {
      extra.innerHTML = '';
    }

    const overlay = $('mo-modal-overlay');
    overlay.classList.remove('hidden');
    overlay.classList.add('flex');
  }

  function closeModal(){
    $('mo-modal-overlay').classList.add('hidden');
    $('mo-modal-overlay').classList.remove('flex');
    currentEventType = null;
  }

  $('mo-modal-cancel').addEventListener('click', closeModal);

  // Player search on input
  $('mo-m-player')?.addEventListener('input', () => {
    selectedPlayerTrid = '';
    renderPlayerSuggestions($('mo-m-player').value);
  });

  // Re-populate player list when team changes
  $('mo-m-team')?.addEventListener('change', () => {
    $('mo-m-player').value = '';
    selectedPlayerTrid = '';
    $('mo-player-results').innerHTML = '';
  });

  // Close suggestions on outside click
  document.addEventListener('click', e => {
    const container = $('mo-player-results');
    const input = $('mo-m-player');
    if (container && input && !input.contains(e.target) && !container.contains(e.target)) {
      container.innerHTML = '';
    }
  });

  $('mo-modal-save').addEventListener('click', async () => {
    if (!IS_EDITABLE) return;
    const teamVal = $('mo-m-team').value;
    const player = ($('mo-m-player').value || '').trim() || '—';
    const teamRequestId = selectedPlayerTrid;
    const rawMin = parseInt($('mo-m-minute').value, 10);
    const minute = isNaN(rawMin) ? Math.floor(timerSec / 60) : rawMin;
    const type = currentEventType;

    let detail = '';
    if (type === 'change') {
      const out = ($('mo-m-out')?.value || '').trim() || '—';
      const inp = ($('mo-m-in')?.value || '').trim() || '—';
      detail = 'Sale: ' + out + '  ·  Entra: ' + inp;
    } else if (type === 'shot') {
      detail = $('mo-m-shottype')?.value || 'Al arco';
    }

    try {
      const body = { type, team: teamVal.toUpperCase(), player, minute, detail, team_request_id: teamRequestId };
      if (type === 'change') {
        const out = ($('mo-m-out')?.value || '').trim() || '—';
        const inp = ($('mo-m-in')?.value || '').trim() || '—';
        body.player = out;
        body.player2 = inp;
      }
      const res = await fetch('/api/matches/' + MATCH_ID + '/events', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const data = await res.json();
      if (data.success) {
        closeModal();
        await loadEvents();
        await updateScore();
      }
    } catch {}
  });

  $('mo-min-minus')?.addEventListener('click', () => {
    const input = $('mo-m-minute');
    if (input) {
      let v = parseInt(input.value || '0', 10);
      if (v > 0) input.value = v - 1;
    }
  });
  $('mo-min-plus')?.addEventListener('click', () => {
    const input = $('mo-m-minute');
    if (input) {
      let v = parseInt(input.value || '0', 10);
      input.value = v + 1;
    }
  });

  /* ── ACTION BUTTONS ── */
  document.querySelectorAll('.mo-action-btn').forEach(btn =>
    btn.addEventListener('click', () => openModal(btn.dataset.type))
  );

  /* ── CLEAR ALL ── */
  $('mo-log-clear').addEventListener('click', async () => {
    if (!IS_EDITABLE) return;
    if (!confirm('¿Eliminar todos los eventos de este partido?')) return;
    try {
      await fetch('/api/matches/' + MATCH_ID + '/events', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'clear' }),
      });
      await loadEvents();
      await updateScore();
    } catch {}
  });

  /* ── START SECOND HALF ── */
  const secondHalfBtn = $('mo-start-second-half');
  if (secondHalfBtn) {
    secondHalfBtn.addEventListener('click', async () => {
      isHalfTime = false;
      secondHalfStarted = true;
      $('mo-half-indicator').style.display = 'none';
      timerBase = timerSec;
      timerRunning = true;
      timerStartedAt = Date.now();
      $('mo-timer-btn').classList.add('active');
      $('mo-timer-label').textContent = 'Pausar';
      timerInterval = setInterval(tick, 1000);
      saveTimerState();
    });
  }

  /* ── START MATCH ── */
  const startBtn = $('mo-start-match');
  if (startBtn) {
    startBtn.addEventListener('click', async () => {
      startBtn.disabled = true;
      startBtn.textContent = 'INICIANDO...';
      try {
        await fetch('/api/matches', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'update', id: MATCH_ID, status: 'live' }),
        });
        window.location.reload();
      } catch {}
      startBtn.disabled = false;
    });
  }

  /* ── END MATCH ── */
  const endBtn = $('mo-end-match');
  if (endBtn) {
    endBtn.addEventListener('click', async () => {
      if (!confirm('¿Finalizar el partido?')) return;
      endBtn.disabled = true;
      endBtn.textContent = 'FINALIZANDO...';
      try {
        const evRes = await fetch('/api/matches/' + MATCH_ID + '/events');
        const evData = await evRes.json();
        const events = evData.success ? (evData.events || []) : [];
        const homeScore = events.filter(e => e.type === 'goal' && e.team === 'A').length;
        const awayScore = events.filter(e => e.type === 'goal' && e.team === 'B').length;
        await fetch('/api/matches', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'update', id: MATCH_ID, status: 'finished', homeScore, awayScore }),
        });
        window.location.reload();
      } catch {}
      endBtn.disabled = false;
    });
  }

  /* ── INIT ── */
  // If the end match button is not rendered, match is finished → disable timer
  if (!$('mo-end-match')) {
    disableTimer();
  }

  // If match is finished and the 2-hour edit window has expired, lock editing
  if (!IS_EDITABLE) {
    document.querySelectorAll('.mo-action-btn').forEach(btn => {
      btn.style.opacity = '0.35';
      btn.style.pointerEvents = 'none';
      btn.style.cursor = 'not-allowed';
    });
    const clearBtn = $('mo-log-clear');
    if (clearBtn) {
      clearBtn.style.opacity = '0.35';
      clearBtn.style.pointerEvents = 'none';
      clearBtn.style.cursor = 'not-allowed';
    }
    const editLocked = document.createElement('div');
    editLocked.style.cssText = 'text-align:center;padding:.75rem;margin-top:.5rem;border-radius:10px;background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.25);color:#fca5a5;font-size:.7rem;letter-spacing:.04em;';
    editLocked.textContent = 'El plazo de 2 horas para editar el partido ha expirado. No se pueden realizar más cambios.';
    const actionsGrid = document.querySelector('.mo-actions-grid');
    if (actionsGrid && actionsGrid.parentNode) actionsGrid.parentNode.insertBefore(editLocked, actionsGrid.nextSibling);
  }

  // Half-time state on page load (runs regardless of match status)
  if (timerSec >= HALF_TIME && timerSec < MAX_SECONDS && timerSec > 0) {
    isHalfTime = true;
    secondHalfStarted = timerSec > HALF_TIME;
    if (isHalfTime && !secondHalfStarted) {
      $('mo-half-indicator').style.display = 'flex';
      $('mo-timer-label').textContent = 'DESCANSO';
    }
    renderTimerDisplay();
  }

  // Load SSR events if available
  const ssrData = document.getElementById('mo-ssr-data');
  if (ssrData) {
    try {
      const events = JSON.parse(ssrData.dataset.events || '[]');
      if (events.length) renderLog(events);
    } catch {}
  }
  // Then poll fresh data
  loadEvents();
})();
</script>
