---
import Layout from "@/layouts/Layout.astro";
import FighterSelector from "@/components/FighterSelector.astro";
import { TEAMS } from "@/consts/teams";
import { getTeamById, getTeamSquadByTeamId } from "../../../server/db";

export async function getStaticPaths() {
  return TEAMS.map((team) => ({
    params: { equipo: team.id },
  }));
}

const { equipo } = Astro.params;
const staticTeam = TEAMS.find((t) => t.id === equipo);
const dbTeam = staticTeam ? null : await getTeamById(equipo || '');
const team = staticTeam || dbTeam;

let players: any[] = [];
let error: string | null = null;
if (team && 'id' in team) {
  try {
    players = await getTeamSquadByTeamId(team.id);
  } catch (e: any) {
    error = e?.message || 'Error al cargar jugadores';
  }
}

const teamLogo = team && 'logo' in team ? (team.logo || '/images/Logo_Default.webp') : '/images/Logo_Default.webp';
const teamName = team?.name || equipo;
const hasPlayers = players.length > 0;
const playerCount = players.length;
const pluralLabel = playerCount === 1 ? 'JUGADOR' : 'JUGADORES';
const defaultLogo = '/images/Logo_Default.webp';
---

<Layout>
  <section class="relative flex min-h-screen w-full">
    <div class="mask-fade-bottom absolute inset-0 w-full bg-[url('/images/fondo2.webp')] bg-cover bg-center"></div>
    <div class="group/hero relative flex w-full flex-col items-center p-2 md:p-8 text-center">
      <div
        id="landing"
        class:list={[
          'absolute top-0 flex w-full flex-col items-center py-16',
          'group-has-[a[data-fighter-card]:hover]/hero:hidden group-has-[a[data-fighter-card]:focus]/hero:hidden group-has-[a[data-fighter-card]:focus-visible]/hero:hidden',
        ]}
      >
        <h3 class="text-theme-seashell animate-fade-in animate-delay-300 mt-4 leading-[100%] font-light">
          <strong>{teamName}</strong>
        </h3>
        <figure class="animate-fade-in relative mt-8">
          <img class="relative z-20 h-auto w-48" src={teamLogo} fetchpriority="high" alt={teamName} decoding="async" />
          <div class="absolute top-0 z-0 size-48 bg-emerald-500/80 blur-2xl"></div>
        </figure>
        {hasPlayers && (
          <div class="relative z-50">
            <h3 class="text-theme-seashell animate-fade-in animate-delay-500 z-0 mt-4 leading-[100%] font-light">
              {playerCount} {pluralLabel}
            </h3>
            <div class="absolute -inset-2 -z-10 h-full w-full bg-pink-400/80 blur-2xl"></div>
          </div>
        )}
        {!hasPlayers && !error && (
          <div class="relative z-50">
            <h3 class="text-theme-seashell animate-fade-in animate-delay-500 z-0 mt-4 leading-[100%] font-light">
              SIN JUGADORES
            </h3>
            <div class="absolute -inset-2 -z-10 h-full w-full bg-pink-400/80 blur-2xl"></div>
          </div>
        )}
      </div>

      {error && (
        <div class="text-center p-4 text-red-400 font-cinzel text-sm absolute top-4">
          {error}
        </div>
      )}

      {hasPlayers ? (
        <div class="mt-auto flex w-full flex-col items-center justify-end gap-4 p-4 md:p-8">
          <div class="hidden w-full flex-wrap justify-center gap-4 md:flex">
            {players.map((p) => (
              <FighterSelector
                id={p.player_id}
                name={p.player_shirt_name || p.player_name}
                cardLink={p.user_id ? `/player/${p.player_id}` : '#'}
                cardImage={p.player_image_card || '/images/fighters/cards/jugador_mistery_card.png'}
                bigImageSrc={p.player_image || '/images/fighters/big/jugador_mistery.webp'}
                boxerCardClass="animate-fade-in-up animate-delay-700"
              />
            ))}
          </div>
          <div class="flex w-full md:hidden">
            <div class="w-full overflow-x-auto overflow-y-visible pb-2">
              <div class="flex min-w-max items-center justify-start gap-4 px-2">
                {players.map((p) => (
                  <FighterSelector
                    id={p.player_id}
                    name={p.player_shirt_name || p.player_name}
                    cardLink={p.user_id ? `/player/${p.player_id}` : '#'}
                    cardImage={p.player_image_card || '/images/fighters/cards/jugador_mistery_card.png'}
                    bigImageSrc={p.player_image || '/images/fighters/big/jugador_mistery.webp'}
                    boxerCardClass="flex-shrink-0"
                  />
                ))}
              </div>
            </div>
          </div>
          <a
            href="/jugadores"
            class="boxer-detail-cta boxer-detail-cta-ghost relative z-10 mt-1"
          >
            VER TODOS LOS JUGADORES
          </a>
        </div>
      ) : (
        !error && (
          <div class="teamplayers-empty" id="empty-state">
            <div id="lottie-container" class="teamplayers-lottie"></div>
            <h2 class="text-lg font-bold tracking-widest text-theme-cream/80 uppercase mt-4">Aún no hay jugadores registrados</h2>
            <p class="text-xs tracking-wide text-theme-cream/40 max-w-xs mt-2">Los jugadores aparecerán aquí cuando se unan al equipo.</p>
          </div>
        )
      )}
    </div>
  </section>
</Layout>

{!hasPlayers && !error ? (
  <script>
    import lottie from 'lottie-web';
    document.addEventListener('astro:page-load', function initLottie() {
      var container = document.getElementById('lottie-container');
      if (!container) return;
      lottie.loadAnimation({
        container: container,
        renderer: 'svg',
        loop: true,
        autoplay: true,
        path: '/lottie/SoccerNot_People.json',
      });
    });
    window.addEventListener('pageshow', function(e) {
      if (e.persisted) {
        var container = document.getElementById('lottie-container');
        if (!container) return;
        lottie.loadAnimation({
          container: container,
          renderer: 'svg',
          loop: true,
          autoplay: true,
          path: '/lottie/SoccerNot_People.json',
        });
      }
    });
  </script>
) : null}

<style>
  .mask-fade-text {
    mask-image: linear-gradient(to bottom, transparent 5%, black 6%, black 95%, transparent 100%);
  }

  @media (max-width: 768px) {
    .overflow-x-auto {
      scrollbar-width: thin;
      -webkit-overflow-scrolling: touch;
    }
    .overflow-x-auto::-webkit-scrollbar {
      height: 3px;
    }
    .overflow-x-auto::-webkit-scrollbar-track {
      background: rgba(251, 191, 36, 0.1);
      border-radius: 10px;
    }
    .overflow-x-auto::-webkit-scrollbar-thumb {
      background: var(--color-theme-gold);
      border-radius: 10px;
    }
  }

  .teamplayers-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-top: auto;
    padding: 3rem 1rem 1rem;
    text-align: center;
  }
  .teamplayers-lottie {
    width: 250px;
    height: 250px;
  }
  @media (min-width: 768px) {
    .teamplayers-lottie { width: 350px; height: 350px; }
  }

  .boxer-detail-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1.3rem;
    border-radius: 9999px;
    font-family: 'Cinzel', var(--font-fallback);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 250ms ease, background-color 250ms ease, color 250ms ease, box-shadow 250ms ease;
  }
  @media (min-width: 640px) {
    .boxer-detail-cta {
      font-size: 0.5rem;
      padding: 0.8rem 1.5rem;
    }
  }
  .boxer-detail-cta-ghost {
    background: transparent;
    color: color-mix(in srgb, var(--color-theme-cream) 80%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-theme-gold) 35%, transparent);
  }
  .boxer-detail-cta-ghost:hover,
  .boxer-detail-cta-ghost:focus-visible {
    color: var(--color-theme-cream);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-theme-gold) 70%, transparent);
    transform: translateY(-1px);
    outline: none;
  }
</style>
