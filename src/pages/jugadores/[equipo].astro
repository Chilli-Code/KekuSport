---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import { TEAMS } from "@/consts/teams";
import { getTeamById } from "../../../server/db";

export async function getStaticPaths() {
  return TEAMS.map((team) => ({
    params: { equipo: team.id },
  }));
}

const { equipo } = Astro.params;
const staticTeam = TEAMS.find((t) => t.id === equipo);
const dbTeam = staticTeam ? null : await getTeamById(equipo || '');

const team = staticTeam || dbTeam;
const teamLogo = team && 'logo' in team ? (team.logo || '/images/Logo_Default.webp') : '/images/Logo_Default.webp'
---

<Layout>
  <Hero teamLogo={teamLogo} />
</Layout>
