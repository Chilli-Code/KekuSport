---
import Layout from '@/layouts/Layout.astro'
import DuelCard from '@/components/DuelCard.astro'
import { getActiveTournamentsWithMatches } from '../../server/db'
import { TEAMS } from '@/consts/teams'
import { COMBATS } from '@/consts/combats'

let tournaments = await getActiveTournamentsWithMatches()

const fallbackTournament = {
  id: 'mock-tournament',
  name: 'Torneo PES',
  description: null, logo: null,
  venue: 'CANCHA LA 93', city: null,
  start_date: '2025-07-12', end_date: null,
  format: 'liga', num_teams: 12, players_per_team: 1,
  match_duration: null, points_per_win: 3, rules: '[]',
  open_registration: 0, reg_deadline: null, registration_fee: null,
  min_age: null, max_age: null, requirements: null,
  prizes: '{}', awards: '[]', notes: null,
  num_groups: null, advancers_per_group: null,
  two_legged: 0, playoffs_two_legged: 0, single_final_match: 1,
  status: 'active', created_by: 'system', created_at: '2025-01-01',
  matches: COMBATS.map(c => {
    const teamA = TEAMS.find(t => t.id === c.fighters[0])
    const teamB = TEAMS.find(t => t.id === c.fighters[1])
    const simulated = ({
      "1-thunder-vs-blaze": { hour: "18:00", date: "SÁB 12 JUL", scheduled_date: "2025-07-12", venue: "CANCHA LA 93", stage: "CUARTOS DE FINAL", status: "live" },
      "2-shadow-vs-frost":  { hour: "18:45", date: "SÁB 12 JUL", scheduled_date: "2025-07-12", venue: "CANCHA LA 93", stage: "CUARTOS DE FINAL", status: "finished" },
      "3-iron-vs-storm":    { hour: "19:30", date: "SÁB 12 JUL", scheduled_date: "2025-07-12", venue: "CANCHA LA 93", stage: "CUARTOS DE FINAL", status: "cancelled" },
      "4-night-vs-golden":  { hour: "20:15", date: "SÁB 12 JUL", scheduled_date: "2025-07-12", venue: "CANCHA LA 93", stage: "CUARTOS DE FINAL", status: "scheduled" },
      "5-red-vs-dark":      { hour: "21:00", date: "DOM 13 JUL", scheduled_date: "2025-07-13", venue: "CANCHA LA 93", stage: "SEMIFINALES", status: "scheduled" },
      "6-wild-vs-steel":    { hour: "21:45", date: "DOM 13 JUL", scheduled_date: "2025-07-13", venue: "CANCHA LA 93", stage: "SEMIFINALES", status: "scheduled" },
    } as Record<string, { hour: string; date: string; scheduled_date: string; venue: string; stage: string; status: string }>)
    return {
      id: c.id, tournament_id: 'mock-tournament', round: 1,
      home_team_id: c.fighters[0], away_team_id: c.fighters[1],
      home_score: null, away_score: null,
      scheduled_date: simulated[c.id]?.scheduled_date || null, venue: null, status: simulated[c.id]?.status || 'pending',
      created_at: '', round_label: null,
      home_team_name: teamA?.name ?? null, home_team_logo: null, home_team_color: null,
      away_team_name: teamB?.name ?? null, away_team_logo: null, away_team_color: null,
      title: c.title,
      _hour: simulated[c.id]?.hour,
      _date: simulated[c.id]?.date,
      _venue: simulated[c.id]?.venue,
      _stage: simulated[c.id]?.stage,
    }
  }),
}

if (tournaments.length === 0) {
  tournaments = [fallbackTournament as any]
}

const typedTournaments = tournaments as any[]
const totalCombates = typedTournaments.reduce((acc: number, t: any) => acc + t.matches.length, 0)
const formats = [...new Set(typedTournaments.map((t: any) => t.format))] as string[]

function extractHour(scheduledDate: string | null | undefined): string | undefined {
  if (!scheduledDate) return undefined
  const parts = scheduledDate.split(/[T ]/)
  if (parts.length < 2) return undefined
  return parts[1].slice(0, 5)
}

function formatDisplayDate(scheduledDate: string | null | undefined): string | undefined {
  if (!scheduledDate) return undefined
  const datePart = scheduledDate.split(/[T ]/)[0]
  if (!datePart) return undefined
  const d = new Date(datePart + 'T12:00:00')
  if (isNaN(d.getTime())) return undefined
  return d.toLocaleDateString('es-ES', { weekday: 'short', day: 'numeric', month: 'short' }).toUpperCase().replace(/\./g, '')
}

type MatchInfo = {
  id: string
  home_team_id: string
  away_team_id: string
  title: string
  _hour?: string
  _date?: string
  _venue?: string
  _stage?: string
  home_team_name?: string | null
  away_team_name?: string | null
  scheduled_date?: string | null
  venue?: string | null
  round_label?: string | null
  status?: string
}

const tournamentsJson = JSON.stringify(typedTournaments.map((t: any) => ({
  id: t.id,
  name: t.name,
  logo: t.logo,
  venue: t.venue,
  start_date: t.start_date,
  format: t.format,
  matches: t.matches.map((m: MatchInfo) => ({
    id: m.id,
    home_team_id: m.home_team_id,
    away_team_id: m.away_team_id,
    home_team_name: m.home_team_name,
    away_team_name: m.away_team_name,
    scheduled_date: m.scheduled_date,
    venue: m.venue,
    round_label: m.round_label,
    _hour: m._hour,
    _date: m._date,
    _stage: m._stage,
    status: m.status,
  }))
})))
---

<Layout>
  <section class="combates-root">
    <div class="combates-bg" aria-hidden="true">
      <div class="combates-glow combates-glow--green"></div>
      <div class="combates-glow combates-glow--purple"></div>
      <div class="combates-stars"></div>
    </div>

    <div class="combates-content">
      <header class="combates-header">
        <div class="combates-ornament">
          <span class="combates-orn-line"></span>
          <span class="combates-orn-diamond combates-orn-diamond--gold"></span>
          <span class="combates-orn-diamond combates-orn-diamond--sm combates-orn-diamond--purple"></span>
          <span class="combates-orn-diamond combates-orn-diamond--gold"></span>
          <span class="combates-orn-line"></span>
        </div>
        <h1 class="combates-h1">COMBATES</h1>
        <p class="combates-desc" id="combates-desc">{totalCombates} DUELOS PROGRAMADOS</p>
      </header>

    </div>

    <div class="flex w-full flex-1 gap-5 combates-layout">
      <!-- FILTER PANEL -->
      <aside class="filter-panel" id="filter-panel">
        <div class="filter-corner filter-corner--tl"></div>
        <div class="filter-corner filter-corner--tr"></div>
        <div class="filter-corner filter-corner--bl"></div>
        <div class="filter-corner filter-corner--br"></div>
  
        <div class="filter-header">
          <span class="filter-diamond"></span>
          <span class="filter-eyebrow" id="filter-eyebrow">FILTROS</span>
          <span class="filter-line"></span>
        </div>
  
        <!-- Tournament filters (default) -->
        <div class="filter-body flex flex-col items-center" id="filter-body-tournament">
          <div class="filter-group">
            <label class="filter-label" for="filter-search">BUSCAR TORNEO</label>
            <div class="filter-input-wrap">
              <svg class="filter-input-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <input id="filter-search" class="filter-input" type="text" placeholder="Nombre o sede..." />
            </div>
          </div>
          <div class="filter-group">
            <label class="filter-label" for="filter-format">FORMATO</label>
            <select id="filter-format" class="filter-select">
              <option value="all">TODOS</option>
              {formats.map(f => (
                <option value={f}>{f.toUpperCase()}</option>
              ))}
            </select>
          </div>
          <button id="filter-reset" class="filter-reset">LIMPIAR</button>
        </div>
  
        <!-- Match filters (shown when a tournament is selected) -->
        <div class="filter-body flex-col" id="filter-body-match" style="display:none">
          <div class="filter-group">
            <label class="filter-label" for="filter-match-search">BUSCAR EQUIPO</label>
            <div class="filter-input-wrap">
              <svg class="filter-input-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <input id="filter-match-search" class="filter-input" type="text" placeholder="Nombre del equipo..." />
            </div>
          </div>
          <div class="filter-divider"></div>
          <div class="filter-group">
            <label class="filter-label" for="filter-date">
              <span class="filter-label-diamond"></span>
              FECHA
            </label>
            <input id="filter-date" class="filter-input filter-date-input" type="date" />
          </div>
          <div class="filter-divider"></div>
          <div class="filter-group">
            <label class="filter-label">
              <span class="filter-label-diamond"></span>
              ESTADO
            </label>
            <div id="filter-status-pills" class="comb-filter-pills" role="group" aria-label="Filtrar por estado">
              <button type="button" data-filter="status" data-value="all" aria-pressed="true" class="comb-filter-pill">
                <span class="comb-filter-pill-label">TODOS</span>
              </button>
              <button type="button" data-filter="status" data-value="live" aria-pressed="false" class="comb-filter-pill">
                <span class="comb-filter-pill-label">EN VIVO</span>
              </button>
              <button type="button" data-filter="status" data-value="finished" aria-pressed="false" class="comb-filter-pill">
                <span class="comb-filter-pill-label">FINALIZADOS</span>
              </button>
              <button type="button" data-filter="status" data-value="cancelled" aria-pressed="false" class="comb-filter-pill">
                <span class="comb-filter-pill-label">CANCELADOS</span>
              </button>
            </div>
          </div>
          <div class="filter-divider"></div>
          <div id="filter-group-section" class="filter-group" style="display:none">
            <label class="filter-label">
              <span class="filter-label-diamond"></span>
              GRUPO
            </label>
            <div id="filter-group-pills" class="comb-filter-pills" role="group" aria-label="Filtrar por grupo">
              <button type="button" data-filter="group" data-value="all" aria-pressed="true" class="comb-filter-pill">
                <span class="comb-filter-pill-label">TODOS</span>
              </button>
            </div>
          </div>
          <button id="filter-match-reset" class="filter-reset">LIMPIAR</button>
        </div>

        <!-- BACK BUTTON (inside filter panel) -->
        <div id="back-wrap" class="back-wrap" style="display:none">
          <button id="back-btn" class="back-btn">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
              <path d="M10 13L5 8l5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            VOLVER A TORNEOS
          </button>
        </div>
      </aside>
      
            <div class="combates-main w-full">
              <!-- TOURNAMENT GRID -->
              <div id="tournament-grid" class="combates-grid">
                {typedTournaments.map((t: any, i: number) => (
                  <button class="tcard" data-tid={t.id} style={`animation-delay:${i * 0.06}s`}>
                    <span class="tcard-corner tcard-corner--tl"></span>
                    <span class="tcard-corner tcard-corner--tr"></span>
                    <span class="tcard-corner tcard-corner--bl"></span>
                    <span class="tcard-corner tcard-corner--br"></span>
                    <div class="tcard-glow" aria-hidden="true"></div>
                    <div class="tcard-logo-wrap">
                      {t.logo ? <img src={t.logo} alt={t.name} class="tcard-logo" /> : <span class="tcard-logo-fallback">🏆</span>}
                    </div>
                    <div class="tcard-body">
                      <span class="tcard-name">{t.name}</span>
                      <div class="tcard-meta">
                        <span class="tcard-meta-item">
                          <svg class="tcard-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                          </svg>
                          {t.venue}
                        </span>
                        <span class="tcard-meta-item">
                          <svg class="tcard-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                          </svg>
                          {new Date(t.start_date).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' }).toUpperCase().replace(/\./g, '')}
                        </span>
                        <span class="tcard-meta-item">
                          <svg class="tcard-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                          </svg>
                          {t.matches.length} DUELOS
                        </span>
                      </div>
                      <span class="tcard-format-badge">{t.format.toUpperCase()}</span>
                      <a href={`/estadisticas/${t.id}`} class="tcard-stats-link" onclick="event.stopPropagation()">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/></svg>
                        ESTADÍSTICAS
                      </a>
                    </div>
                  </button>
                ))}
              </div>
      
              <!-- Pre-rendered match grids (hidden) -->
              {typedTournaments.map((t: any) => (
                <div id={`match-grid-${t.id}`} class="combates-grid" style="display:none" data-tgrid={t.id}>
                  {t.matches.map((m: MatchInfo) => {
                    const derivedHour = (m as any)._hour || extractHour(m.scheduled_date)
                    const derivedDate = (m as any)._date || formatDisplayDate(m.scheduled_date)
                    const derivedVenue = (m as any)._venue || m.venue || undefined
                    const derivedStage = (m as any)._stage || m.round_label || undefined
                    return (
                    <DuelCard
                        id={m.id}
                        team1Id={m.home_team_id}
                        team2Id={m.away_team_id}
                        team1Name={m.home_team_name || undefined}
                        team2Name={m.away_team_name || undefined}
                        title={m.title}
                        hour={derivedHour}
                        date={derivedDate}
                        venue={derivedVenue}
                        stage={derivedStage}
                        status={m.status}
                        tournamentName={t.name}
                      />
                    )
                  })}
                </div>
              ))}
      
              <!-- NO RESULTS -->
              <div id="no-results" class="no-results" style="display:none">
                <span class="no-results-icon">🔍</span>
                <p class="no-results-text">No se encontraron resultados</p>
              </div>
            </div>

    </div>
      
      <script id="combates-data" type="application/json" set:html={tournamentsJson}></script>
  </section>
</Layout>

<script>
function initCombates() {
  var dataEl = document.getElementById('combates-data');
  if (!dataEl) return;
  var tournaments = JSON.parse(dataEl.textContent);
  var tournamentGrid = document.getElementById('tournament-grid');
  var matchGrids = document.querySelectorAll('[data-tgrid]');
  var backWrap = document.getElementById('back-wrap');
  var descEl = document.getElementById('combates-desc');
  var noResults = document.getElementById('no-results');
  var filterEyebrow = document.getElementById('filter-eyebrow');
  var filterBodyTournament = document.getElementById('filter-body-tournament');
  var filterBodyMatch = document.getElementById('filter-body-match');
  var filterSearch = document.getElementById('filter-search');
  var filterFormat = document.getElementById('filter-format');
  var filterReset = document.getElementById('filter-reset');
  var filterMatchSearch = document.getElementById('filter-match-search');
  var filterDateInput = document.getElementById('filter-date');
  var filterGroupSection = document.getElementById('filter-group-section');
  var filterGroupPills = document.getElementById('filter-group-pills');
  var filterMatchReset = document.getElementById('filter-match-reset');
  var filterStatusPills = document.getElementById('filter-status-pills');

  if (!tournamentGrid || !filterSearch) return;

  // Reset to tournament view on re-init
  var currentTournamentId = null;
  var activeMatchGrid = null;
  matchGrids.forEach(function(g) { g.style.display = 'none'; });
  tournamentGrid.style.display = '';
  if (backWrap) backWrap.style.display = 'none';
  if (noResults) noResults.style.display = 'none';
  if (filterEyebrow) filterEyebrow.textContent = 'FILTROS';
  if (filterBodyTournament) filterBodyTournament.style.display = '';
  if (filterBodyMatch) filterBodyMatch.style.display = 'none';
  if (filterSearch) filterSearch.value = '';
  if (filterFormat) filterFormat.value = 'all';
  if (filterMatchSearch) filterMatchSearch.value = '';
  if (filterDateInput) filterDateInput.value = '';

  function filterTournaments() {
    var q = filterSearch.value.toLowerCase().trim();
    var fmt = filterFormat.value;
    var cards = tournamentGrid.querySelectorAll('.tcard');
    var visible = 0;
    cards.forEach(function(card) {
      var tid = card.dataset.tid;
      var t = tournaments.find(function(t) { return t.id === tid; });
      if (!t) return;
      var matchName = t.name.toLowerCase().includes(q);
      var matchVenue = (t.venue || '').toLowerCase().includes(q);
      var matchFormat = fmt === 'all' || t.format === fmt;
      var show = matchFormat && (q === '' || matchName || matchVenue);
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    noResults.style.display = visible === 0 ? '' : 'none';
    return visible;
  }

  function extractGroup(label) {
    var m = label.match(/(Grupo\s+\w+)/i);
    return m ? m[1] : null;
  }

  function dateToDisplay(iso) {
    if (!iso) return '';
    var d = new Date(iso + 'T12:00:00');
    return d.toLocaleDateString('es-ES', { weekday: 'short', day: 'numeric', month: 'short' }).toUpperCase().replace(/\./g, '');
  }

  function filterMatches() {
    var q = filterMatchSearch.value.toLowerCase().trim();
    var selectedDate = filterDateInput.value;
    var selectedDisplay = dateToDisplay(selectedDate);
    var activeGroupPill = filterGroupPills.querySelector('[aria-pressed="true"]');
    var selectedGroup = activeGroupPill ? activeGroupPill.dataset.value : 'all';
    var activeStatusPill = filterStatusPills.querySelector('[aria-pressed="true"]');
    var selectedStatus = activeStatusPill ? activeStatusPill.dataset.value : 'all';
    if (!activeMatchGrid) return 0;
    var cards = activeMatchGrid.querySelectorAll('.duel-card');
    var t = tournaments.find(function(t) { return t.id === currentTournamentId; });
    var matchData = t ? t.matches : [];
    var visible = 0;
    cards.forEach(function(card, i) {
      var show = true;
      if (q) {
        var nameEls = card.querySelectorAll('.duel-name');
        var match = Array.from(nameEls).some(function(el) { return el.textContent && el.textContent.toLowerCase().includes(q); });
        if (!match) show = false;
      }
      if (selectedDate) {
        var m = matchData[i];
        var dateRaw = m ? (m.scheduled_date || '') : '';
        var datePart = dateRaw.split('T')[0] || dateRaw;
        var dateDisplay = m ? (m._date || '') : '';
        if (datePart !== selectedDate && dateDisplay !== selectedDisplay) show = false;
      }
      if (selectedGroup !== 'all') {
        var m = matchData[i];
        var label = m ? (m.round_label || '') : '';
        var group = extractGroup(label);
        if (!group || group !== selectedGroup) show = false;
      }
      if (selectedStatus !== 'all') {
        var m = matchData[i];
        var st = m ? (m.status || '').toLowerCase() : '';
        if (st !== selectedStatus) show = false;
      }
      card.setAttribute('style', show ? '' : 'display:none');
      if (show) visible++;
    });
    noResults.style.display = visible === 0 ? '' : 'none';
    return visible;
  }

  function showTournamentFilters() {
    filterEyebrow.textContent = 'FILTROS';
    filterBodyTournament.style.display = '';
    filterBodyMatch.style.display = 'none';
  }

  function showMatchFilters() {
    filterEyebrow.textContent = 'FILTRAR DUELOS';
    filterBodyTournament.style.display = 'none';
    filterBodyMatch.style.display = '';
    filterDateInput.value = '';
    filterMatchSearch.value = '';

    filterStatusPills.querySelectorAll('[data-filter="status"]').forEach(function(b) {
      b.setAttribute('aria-pressed', b.dataset.value === 'all' ? 'true' : 'false');
    });

    var t = tournaments.find(function(t) { return t.id === currentTournamentId; });
    var groups = new Set();
    if (t) {
      t.matches.forEach(function(m) {
        var label = m.round_label || '';
        var g = extractGroup(label);
        if (g) groups.add(g);
      });
    }
    if (groups.size > 0) {
      filterGroupSection.style.display = '';
      filterGroupPills.innerHTML = '<button type="button" data-filter="group" data-value="all" aria-pressed="true" class="comb-filter-pill"><span class="comb-filter-pill-label">TODOS</span></button>';
      Array.from(groups).sort().forEach(function(g) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.dataset.filter = 'group';
        btn.dataset.value = g;
        btn.setAttribute('aria-pressed', 'false');
        btn.className = 'comb-filter-pill';
        btn.innerHTML = '<span class="comb-filter-pill-label">' + g + '</span>';
        filterGroupPills.appendChild(btn);
      });
    } else {
      filterGroupSection.style.display = 'none';
    }
  }

  function showMatches(tid) {
    currentTournamentId = tid;
    var t = tournaments.find(function(t) { return t.id === tid; });
    if (!t) return;

    tournamentGrid.style.display = 'none';
    matchGrids.forEach(function(g) { g.style.display = g.dataset.tgrid === tid ? '' : 'none'; });
    activeMatchGrid = document.querySelector('[data-tgrid="' + tid + '"]') || null;
    backWrap.style.display = '';
    noResults.style.display = 'none';

    descEl.textContent = t.matches.length + ' DUELOS \u00B7 ' + t.name;
    showMatchFilters();
  }

  function showTournaments() {
    currentTournamentId = null;
    activeMatchGrid = null;
    matchGrids.forEach(function(g) { g.style.display = 'none'; });
    tournamentGrid.style.display = '';
    backWrap.style.display = 'none';
    showTournamentFilters();
    descEl.textContent = tournaments.reduce(function(a, t) { return a + t.matches.length; }, 0) + ' DUELOS PROGRAMADOS';
    filterTournaments();
  }

  // Remove old handlers to prevent duplicates
  document.removeEventListener('input', window._combFilterInput);
  document.removeEventListener('change', window._combFilterChange);
  document.removeEventListener('click', window._combFilterClick);

  // Input delegation
  window._combFilterInput = function(e) {
    if (e.target === filterSearch) filterTournaments();
    if (e.target === filterMatchSearch) filterMatches();
  };
  document.addEventListener('input', window._combFilterInput);

  // Change delegation
  window._combFilterChange = function(e) {
    if (e.target === filterFormat) filterTournaments();
    if (e.target === filterDateInput) filterMatches();
  };
  document.addEventListener('change', window._combFilterChange);

  // Click delegation
  window._combFilterClick = function(e) {
    if (e.target === filterReset) {
      filterSearch.value = '';
      filterFormat.value = 'all';
      filterTournaments();
      return;
    }
    if (e.target === filterMatchReset) {
      filterMatchSearch.value = '';
      filterDateInput.value = '';
      filterGroupPills.querySelectorAll('[data-filter="group"]').forEach(function(b) {
        b.setAttribute('aria-pressed', b.dataset.value === 'all' ? 'true' : 'false');
      });
      filterStatusPills.querySelectorAll('[data-filter="status"]').forEach(function(b) {
        b.setAttribute('aria-pressed', b.dataset.value === 'all' ? 'true' : 'false');
      });
      filterMatches();
      return;
    }
    var groupBtn = e.target.closest('[data-filter="group"]');
    if (groupBtn && filterGroupPills.contains(groupBtn)) {
      filterGroupPills.querySelectorAll('[data-filter="group"]').forEach(function(b) { b.setAttribute('aria-pressed', 'false'); });
      groupBtn.setAttribute('aria-pressed', 'true');
      filterMatches();
      return;
    }
    var statusBtn = e.target.closest('[data-filter="status"]');
    if (statusBtn && filterStatusPills.contains(statusBtn)) {
      filterStatusPills.querySelectorAll('[data-filter="status"]').forEach(function(b) { b.setAttribute('aria-pressed', 'false'); });
      statusBtn.setAttribute('aria-pressed', 'true');
      filterMatches();
      return;
    }
    if (e.target.id === 'back-btn' || e.target.closest('#back-btn')) {
      showTournaments();
      return;
    }
    var card = e.target.closest('.tcard[data-tid]');
    if (card) {
      showMatches(card.dataset.tid);
      return;
    }
  };
  document.addEventListener('click', window._combFilterClick);

  filterTournaments();
}

document.addEventListener('astro:page-load', initCombates);
window.addEventListener('pageshow', function(e) { if (e.persisted) initCombates(); });
</script>

