---
import Layout from '../../layouts/Layout.astro'

const user = Astro.locals.user
if (user) return Astro.redirect('/admin/dashboard')
---

<Layout>
<main class="login-root">

  <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <div class="login-stars"></div>
    <div class="absolute -top-20 left-1/2 -translate-x-1/2 w-[60%] h-[55%] rounded-full blur-[90px] opacity-20" style="background:radial-gradient(ellipse,#00ff88,transparent 70%)"></div>
    <div class="absolute top-0 left-0 w-[35%] h-[60%] rounded-full blur-[110px] opacity-15" style="background:radial-gradient(ellipse,#00ff88,transparent 70%)"></div>
    <div class="absolute top-0 right-0 w-[35%] h-[60%] rounded-full blur-[110px] opacity-12" style="background:radial-gradient(ellipse,#7c3aed,transparent 70%)"></div>
  </div>

  <div class="relative z-10 flex min-h-svh w-full items-center justify-center px-4 py-16">
    <div class="w-full max-w-md">

      <div class="mb-8 text-center">
        <div class="mb-3 flex justify-center gap-1.5">
          <span class="inline-block w-1.5 h-1.5 rotate-45 bg-[var(--color-theme-gold)] opacity-70"></span>
          <span class="inline-block w-1.5 h-1.5 rotate-45 bg-[var(--color-theme-gold)] opacity-70"></span>
          <span class="inline-block w-1.5 h-1.5 rotate-45 bg-[var(--color-theme-gold)] opacity-70"></span>
        </div>
        <h1 class="font-cinzel text-3xl font-black uppercase tracking-[0.12em] text-white md:text-4xl">REGISTRO</h1>
        <p class="mt-2 text-[0.6rem] font-semibold uppercase tracking-[0.25em] text-white/35">CREA TU CUENTA</p>
      </div>

      <div class="login-card">
        <span class="hud-corner hud-corner--tl"></span>
        <span class="hud-corner hud-corner--tr"></span>
        <span class="hud-corner hud-corner--bl"></span>
        <span class="hud-corner hud-corner--br"></span>
        <div class="absolute inset-0 rounded-2xl pointer-events-none" style="background:radial-gradient(ellipse at 50% 0%,rgba(0,255,136,.05),transparent 60%)"></div>

        <div class="relative z-10 p-7 md:p-8">

          <!-- Role selector -->
          <p class="mb-5 text-center font-cinzel text-[0.55rem] font-bold uppercase tracking-[0.22em] text-[rgba(0,255,136,.7)]">SELECCIONA TU ROL</p>
          <div class="grid grid-cols-2 gap-3">
            {[
              { id: 'tecnico', icon: '📋', label: 'Técnico', desc: 'Diriges un equipo' },
              { id: 'jugador', icon: '⚽', label: 'Jugador', desc: 'Compites en torneos' },
            ].map(role => (
              <button class="role-btn" data-role={role.id} type="button" aria-pressed="false">
                <span class="role-icon">{role.icon}</span>
                <span class="role-label">{role.label}</span>
                <span class="role-desc">{role.desc}</span>
                <span class="role-check">✓</span>
              </button>
            ))}
          </div>

          <!-- Form -->
          <form id="register-form" class="flex flex-col gap-4 mt-6">
            <div class="form-group">
              <label for="name" class="form-label">Nombre</label>
              <div class="input-wrap">
                <input type="text" id="name" placeholder="Tu nombre" class="form-input" required />
              </div>
            </div>
            <div class="form-group">
              <label for="email" class="form-label">Correo electrónico</label>
              <div class="input-wrap">
                <input type="email" id="email" placeholder="tucorreo@ejemplo.com" class="form-input" required />
              </div>
              <span id="email-status" class="email-status"></span>
            </div>
            <div class="form-group">
              <label for="password" class="form-label">Contraseña</label>
              <div class="input-wrap">
                <input type="password" id="password" placeholder="••••••••" class="form-input" required />
              </div>
            </div>

            <div id="register-error" class="hidden rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-2.5 text-[0.58rem] font-medium text-red-400"></div>

            <button type="submit" class="cta-primary mt-1 w-full" id="btn-register">
              <span id="btn-register-text">CREAR CUENTA</span>
              <span id="btn-register-loader" class="hidden login-loader"></span>
            </button>
          </form>

          <p class="mt-6 text-center text-[0.55rem] text-white/30">
            ¿Ya tienes cuenta?
            <a href="/login" class="ml-1 font-bold text-[var(--color-theme-gold)]/80 hover:text-[var(--color-theme-gold)] transition-colors">Inicia sesión</a>
          </p>

        </div>
      </div>

    </div>
  </div>
</main>
</Layout>

<script>
  let selectedRole = 'jugador'
  let emailAvailable = true

  document.querySelectorAll('.role-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.role-btn').forEach(b => { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false') })
      btn.classList.add('active'); btn.setAttribute('aria-pressed', 'true')
      selectedRole = btn.dataset.role
    })
  })
  document.querySelector('.role-btn[data-role="jugador"]')?.classList.add('active')

  const form = document.getElementById('register-form')
  const errorEl = document.getElementById('register-error')
  const btnText = document.getElementById('btn-register-text')
  const btnLoader = document.getElementById('btn-register-loader')
  const btn = document.getElementById('btn-register')
  const emailInput = document.getElementById('email')
  const emailStatus = document.getElementById('email-status')

  let emailCheckTimer = null

  async function checkEmail(email) {
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      emailStatus.textContent = ''
      emailStatus.className = 'email-status'
      emailAvailable = true
      return
    }
    emailStatus.textContent = 'Verificando...'
    emailStatus.className = 'email-status email-status--checking'
    try {
      const res = await fetch(`/api/auth/check-email?email=${encodeURIComponent(email)}`)
      const data = await res.json()
      if (data.available) {
        emailStatus.textContent = 'Email disponible'
        emailStatus.className = 'email-status email-status--available'
        emailAvailable = true
      } else {
        emailStatus.textContent = 'Este email ya está registrado'
        emailStatus.className = 'email-status email-status--taken'
        emailAvailable = false
      }
    } catch {
      emailStatus.textContent = ''
      emailStatus.className = 'email-status'
      emailAvailable = true
    }
  }

  emailInput.addEventListener('blur', () => checkEmail(emailInput.value.trim()))
  emailInput.addEventListener('input', () => {
    clearTimeout(emailCheckTimer)
    if (!emailInput.value.trim()) {
      emailStatus.textContent = ''
      emailStatus.className = 'email-status'
      emailAvailable = true
      return
    }
    emailCheckTimer = setTimeout(() => checkEmail(emailInput.value.trim()), 400)
  })

  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    errorEl.classList.add('hidden')
    const name = document.getElementById('name').value.trim()
    const email = document.getElementById('email').value.trim()
    const password = document.getElementById('password').value

    if (!name || !email || !password) {
      errorEl.textContent = 'Todos los campos son obligatorios'
      errorEl.classList.remove('hidden')
      return
    }

    if (!emailAvailable) {
      errorEl.textContent = 'Este email ya está registrado. Usa otro o inicia sesión.'
      errorEl.classList.remove('hidden')
      return
    }

    btnText.classList.add('hidden')
    btnLoader.classList.remove('hidden')
    btn.disabled = true

    try {
      const res = await fetch('/api/auth/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, password, role: selectedRole }),
      })
      const data = await res.json()
      if (data.success) {
        window.location.href = data.redirect || '/'
      } else {
        errorEl.textContent = data.error || 'Error al registrar'
        errorEl.classList.remove('hidden')
      }
    } catch {
      errorEl.textContent = 'Error de conexión'
      errorEl.classList.remove('hidden')
    } finally {
      btnText.classList.remove('hidden')
      btnLoader.classList.add('hidden')
      btn.disabled = false
    }
  })
</script>

<style>
  .login-root { position: relative; min-height: 100vh; background: #050d08; overflow: hidden; }
  .login-stars { position: absolute; inset: 0; background-image: radial-gradient(1.5px 1.5px at 10% 20%, #fff, transparent), radial-gradient(1px 1px at 30% 65%, #aaffcc, transparent), radial-gradient(2px 2px at 55% 15%, #a855f7, transparent), radial-gradient(1px 1px at 70% 80%, #fff, transparent), radial-gradient(2px 2px at 85% 40%, #00ff88, transparent), radial-gradient(1px 1px at 20% 90%, #c084fc, transparent), radial-gradient(1.5px 1.5px at 60% 55%, #fff, transparent), radial-gradient(1px 1px at 45% 35%, #aaffcc, transparent), radial-gradient(2px 2px at 92% 10%, #fff, transparent); background-size: 300px 300px; opacity: 0.4; animation: twinkle 7s ease-in-out infinite alternate; }
  @keyframes twinkle { 0%{opacity:.25} 100%{opacity:.65} }
  .login-card { position: relative; border-radius: 18px; border: 1px solid rgba(255,255,255,.08); background: rgba(255,255,255,.025); overflow: hidden; }
  .hud-corner { position: absolute; width: 12px; height: 12px; border-style: solid; border-color: rgba(0,255,136,.25); pointer-events: none; }
  .hud-corner--tl { top: 8px; left: 8px; border-width: 1.5px 0 0 1.5px; }
  .hud-corner--tr { top: 8px; right: 8px; border-width: 1.5px 1.5px 0 0; }
  .hud-corner--bl { bottom: 8px; left: 8px; border-width: 0 0 1.5px 1.5px; }
  .hud-corner--br { bottom: 8px; right: 8px; border-width: 0 1.5px 1.5px 0; }
  .role-btn { position: relative; display: flex; flex-direction: column; align-items: center; gap: .3rem; padding: 1rem .5rem; border-radius: 12px; border: 1px solid rgba(255,255,255,.08); background: rgba(255,255,255,.025); color: rgba(232,220,200,.6); cursor: pointer; transition: all .25s; font-family: inherit; }
  .role-btn:hover { border-color: rgba(0,255,136,.25); background: rgba(0,255,136,.05); }
  .role-btn.active { border-color: #00ff88; background: rgba(0,255,136,.08); box-shadow: 0 0 20px rgba(0,255,136,.08); }
  .role-icon { font-size: 1.5rem; }
  .role-label { font-family: 'Cinzel', serif; font-size: .6rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--color-theme-cream); }
  .role-desc { font-size: .45rem; letter-spacing: .05em; color: rgba(232,220,200,.3); }
  .role-check { position: absolute; top: 6px; right: 8px; font-size: .6rem; color: #00ff88; opacity: 0; transition: opacity .2s; }
  .role-btn.active .role-check { opacity: 1; }
  .cta-primary { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; padding: .75rem 2rem; border-radius: 10px; font-family: 'Cinzel', serif; font-size: .6rem; font-weight: 800; letter-spacing: .2em; text-transform: uppercase; text-decoration: none; background: var(--color-theme-gold); color: var(--color-theme-midnight); border: none; cursor: pointer; transition: transform .2s, filter .2s, box-shadow .2s; }
  .cta-primary:hover { transform: scale(1.02); filter: brightness(1.1); box-shadow: 0 0 28px rgba(199,168,107,.35); }
  .cta-primary:disabled { opacity: .5; cursor: not-allowed; transform: none; filter: none; box-shadow: none; }
  .form-group { display: flex; flex-direction: column; gap: .35rem; }
  .form-label { font-size: .5rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: rgba(232,220,200,.4); }
  .input-wrap { position: relative; display: flex; align-items: center; }
  .input-icon { position: absolute; left: 12px; color: rgba(255,255,255,.2); pointer-events: none; }
  .form-input { width: 100%; padding: .7rem .8rem .7rem 2.2rem; border-radius: 8px; border: 1px solid rgba(255,255,255,.08); background: rgba(255,255,255,.03); color: var(--color-theme-cream); font-size: .8rem; outline: none; transition: border-color .2s; box-sizing: border-box; font-family: inherit; }
  .form-input:focus { border-color: var(--color-theme-gold); }
  .login-loader { display: inline-block; width: 14px; height: 14px; border-radius: 50%; border: 2px solid var(--color-theme-midnight); border-top-color: transparent; animation: spin .6s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg) } }
  .email-status { font-size: .48rem; font-weight: 600; letter-spacing: .05em; min-height: 1rem; margin-top: .2rem; transition: color .2s; }
  .email-status--available { color: #00ff88; }
  .email-status--taken { color: #f87171; }
  .email-status--checking { color: #fbbf24; }
</style>
