---
import Layout from '../../layouts/Layout.astro';
import MenuAndroid from '../../components/ui/menuAndroid.astro';

const POSITIONS = [
  { value: 'GK', label: 'Portero' },
  { value: 'CB', label: 'Defensa Central' },
  { value: 'LB', label: 'Lateral Izquierdo' },
  { value: 'RB', label: 'Lateral Derecho' },
  { value: 'LWB', label: 'Carrilero Izquierdo' },
  { value: 'RWB', label: 'Carrilero Derecho' },
  { value: 'CDM', label: 'Medio Defensivo' },
  { value: 'CM', label: 'Medio Centro' },
  { value: 'CAM', label: 'Medio Ofensivo' },
  { value: 'LM', label: 'Medio Izquierdo' },
  { value: 'RM', label: 'Medio Derecho' },
  { value: 'LW', label: 'Extremo Izquierdo' },
  { value: 'RW', label: 'Extremo Derecho' },
  { value: 'CF', label: 'Segundo Delantero' },
  { value: 'ST', label: 'Delantero Centro' },
];
---

<Layout title="Agregar Jugador" hideFooter={true}>
<div
  class="relative min-h-screen font-[family-name:var(--font-cinzel)] text-[var(--color-theme-cream)] pt-20"
  style="background:radial-gradient(ellipse at 50% -10%,#0b2a1a 0%,#050d08 55%,#03080e 100%)"
>
  <div class="fixed inset-0 pointer-events-none z-0" style="background:radial-gradient(ellipse 90% 60% at 50% -5%,rgba(0,255,136,.07) 0%,transparent 70%),radial-gradient(ellipse 50% 40% at 80% 80%,rgba(168,85,247,.04) 0%,transparent 60%)">
    <div class="absolute inset-0" style="background-image:linear-gradient(rgba(0,255,136,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(0,255,136,.03) 1px,transparent 1px);background-size:48px 48px;mask-image:radial-gradient(ellipse 80% 70% at 50% 30%,#000 30%,transparent 70%);-webkit-mask-image:radial-gradient(ellipse 80% 70% at 50% 30%,#000 30%,transparent 70%)"></div>
  </div>

  <header class="fixed top-0 left-0 right-0 z-50" style="background:rgba(6,11,18,.93);backdrop-filter:blur(20px);border-bottom:1px solid rgba(199,168,107,.14)">
    <div class="max-w-[720px] mx-auto flex items-center gap-2 px-3 py-2.5">
      <span class="inline-block w-2 h-2 rounded-full bg-[#00ff88] shrink-0" style="box-shadow:0 0 10px #00ff88,0 0 20px rgba(0,255,136,.3);animation:blink2 1.2s ease-in-out infinite"></span>
      <span class="font-[family-name:var(--font-cinzel)] text-[.55rem] font-bold tracking-[.18em] text-[rgba(232,220,200,.7)] whitespace-nowrap uppercase">AGREGAR <span style="background:linear-gradient(90deg,var(--color-theme-gold,#fbbf24),#f59e0b);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">JUGADOR</span></span>
      <span class="ml-auto font-mono text-[.4rem] text-[rgba(251,191,36,.3)] border border-[rgba(251,191,36,.12)] rounded px-1.5 py-px tracking-wide">v1.0</span>
    </div>
    <div class="h-px" style="background:linear-gradient(90deg,transparent,var(--color-theme-gold,#fbbf24) 20%,#00ff88 80%,transparent);opacity:.3"></div>
  </header>

  <main class="relative z-10 max-w-[720px] mx-auto px-3 pt-20 pb-28">
    <a href="/tecnico" class="inline-flex items-center gap-1.5 mb-4 font-[family-name:var(--font-cinzel)] text-[.45rem] font-semibold tracking-[.1em] text-[rgba(232,220,200,.4)] uppercase no-underline bg-[rgba(255,255,255,.03)] border border-[rgba(255,255,255,.06)] rounded-full px-3 py-1.5 transition-all hover:text-[rgba(232,220,200,.7)]">
      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
      VOLVER
    </a>

    <form id="add-player-form" class="relative p-5 rounded-xl border" style="background:rgba(255,255,255,.02);border-color:rgba(199,168,107,.14);backdrop-filter:blur(4px);box-shadow:0 4px 30px rgba(0,0,0,.2)">
      <p class="font-[family-name:var(--font-cinzel)] text-[.48rem] font-semibold tracking-[.22em] text-[rgba(251,191,36,.5)] uppercase pb-2.5 mb-4" style="border-bottom:1px solid rgba(199,168,107,.14)">NUEVO JUGADOR</p>
      <p class="text-[.45rem] text-white/30 tracking-wider mb-4">El jugador se agregará directamente a la plantilla sin necesidad de invitación.</p>

      <div class="flex flex-col gap-3">
        <div>
          <label class="block text-[.45rem] font-semibold tracking-[.18em] text-[rgba(232,220,200,.3)] uppercase mb-1.5 font-[family-name:var(--font-cinzel)]" for="player-name">NOMBRE *</label>
          <input id="player-name" type="text" maxlength="50" placeholder="Nombre del jugador" class="w-full px-3.5 py-2.5 rounded-lg text-[.55rem] tracking-wider text-[var(--color-theme-cream)] bg-[rgba(255,255,255,.03)] border border-[rgba(199,168,107,.14)] placeholder:text-[rgba(232,220,200,.12)] focus:outline-none focus:border-[rgba(0,255,136,.35)] focus:bg-[rgba(0,255,136,.03)] transition-all" required />
        </div>

        <div>
          <label class="block text-[.45rem] font-semibold tracking-[.18em] text-[rgba(232,220,200,.3)] uppercase mb-1.5 font-[family-name:var(--font-cinzel)]" for="player-real-name">NOMBRE REAL</label>
          <input id="player-real-name" type="text" maxlength="50" placeholder="Ej: Alejandro García" class="w-full px-3.5 py-2.5 rounded-lg text-[.55rem] tracking-wider text-[var(--color-theme-cream)] bg-[rgba(255,255,255,.03)] border border-[rgba(199,168,107,.14)] placeholder:text-[rgba(232,220,200,.12)] focus:outline-none focus:border-[rgba(0,255,136,.35)] focus:bg-[rgba(0,255,136,.03)] transition-all" />
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-[.45rem] font-semibold tracking-[.18em] text-[rgba(232,220,200,.3)] uppercase mb-1.5 font-[family-name:var(--font-cinzel)]" for="player-age">EDAD</label>
            <input id="player-age" type="number" min="10" max="99" placeholder="Ej: 24" class="w-full px-3.5 py-2.5 rounded-lg text-[.55rem] tracking-wider text-[var(--color-theme-cream)] bg-[rgba(255,255,255,.03)] border border-[rgba(199,168,107,.14)] placeholder:text-[rgba(232,220,200,.12)] focus:outline-none focus:border-[rgba(0,255,136,.35)] focus:bg-[rgba(0,255,136,.03)] transition-all" />
          </div>
          <div>
            <label class="block text-[.45rem] font-semibold tracking-[.18em] text-[rgba(232,220,200,.3)] uppercase mb-1.5 font-[family-name:var(--font-cinzel)]" for="player-number">DORSAL</label>
            <input id="player-number" type="number" min="1" max="99" placeholder="Ej: 10" class="w-full px-3.5 py-2.5 rounded-lg text-[.55rem] tracking-wider text-[var(--color-theme-cream)] bg-[rgba(255,255,255,.03)] border border-[rgba(199,168,107,.14)] placeholder:text-[rgba(232,220,200,.12)] focus:outline-none focus:border-[rgba(0,255,136,.35)] focus:bg-[rgba(0,255,136,.03)] transition-all" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-[.45rem] font-semibold tracking-[.18em] text-[rgba(232,220,200,.3)] uppercase mb-1.5 font-[family-name:var(--font-cinzel)]" for="player-city">CIUDAD</label>
            <input id="player-city" type="text" maxlength="50" placeholder="Ej: Barranquilla" class="w-full px-3.5 py-2.5 rounded-lg text-[.55rem] tracking-wider text-[var(--color-theme-cream)] bg-[rgba(255,255,255,.03)] border border-[rgba(199,168,107,.14)] placeholder:text-[rgba(232,220,200,.12)] focus:outline-none focus:border-[rgba(0,255,136,.35)] focus:bg-[rgba(0,255,136,.03)] transition-all" />
          </div>
          <div>
            <label class="block text-[.45rem] font-semibold tracking-[.18em] text-[rgba(232,220,200,.3)] uppercase mb-1.5 font-[family-name:var(--font-cinzel)]" for="player-neighborhood">BARRIO</label>
            <input id="player-neighborhood" type="text" maxlength="50" placeholder="Ej: El Prado" class="w-full px-3.5 py-2.5 rounded-lg text-[.55rem] tracking-wider text-[var(--color-theme-cream)] bg-[rgba(255,255,255,.03)] border border-[rgba(199,168,107,.14)] placeholder:text-[rgba(232,220,200,.12)] focus:outline-none focus:border-[rgba(0,255,136,.35)] focus:bg-[rgba(0,255,136,.03)] transition-all" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-[.45rem] font-semibold tracking-[.18em] text-[rgba(232,220,200,.3)] uppercase mb-1.5 font-[family-name:var(--font-cinzel)]" for="player-position">POSICIÓN *</label>
            <select id="player-position" class="w-full px-3.5 py-2.5 rounded-lg text-[.55rem] tracking-wider text-[var(--color-theme-cream)] bg-[rgba(255,255,255,.03)] border border-[rgba(199,168,107,.14)] focus:outline-none focus:border-[rgba(0,255,136,.35)] focus:bg-[rgba(0,255,136,.03)] transition-all appearance-none" required>
              <option value="" class="bg-[#050d08]">Seleccionar posición...</option>
              {POSITIONS.map(p => (
                <option value={p.value} class="bg-[#050d08]">{p.value} — {p.label}</option>
              ))}
            </select>
          </div>
          <div>
            <label class="block text-[.45rem] font-semibold tracking-[.18em] text-[rgba(232,220,200,.3)] uppercase mb-1.5 font-[family-name:var(--font-cinzel)]" for="player-foot">PIE HÁBIL</label>
            <select id="player-foot" class="w-full px-3.5 py-2.5 rounded-lg text-[.55rem] tracking-wider text-[var(--color-theme-cream)] bg-[rgba(255,255,255,.03)] border border-[rgba(199,168,107,.14)] focus:outline-none focus:border-[rgba(0,255,136,.35)] focus:bg-[rgba(0,255,136,.03)] transition-all appearance-none">
              <option value="" class="bg-[#050d08]">Seleccionar...</option>
              <option value="Derecho" class="bg-[#050d08]">Derecho</option>
              <option value="Zurdo" class="bg-[#050d08]">Zurdo</option>
              <option value="Ambos" class="bg-[#050d08]">Ambos</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-[.45rem] font-semibold tracking-[.18em] text-[rgba(232,220,200,.3)] uppercase mb-1.5 font-[family-name:var(--font-cinzel)]" for="player-shirt-name">NOMBRE DE CAMISA</label>
          <input id="player-shirt-name" type="text" maxlength="30" placeholder="Ej: El Mago" class="w-full px-3.5 py-2.5 rounded-lg text-[.55rem] tracking-wider text-[var(--color-theme-cream)] bg-[rgba(255,255,255,.03)] border border-[rgba(199,168,107,.14)] placeholder:text-[rgba(232,220,200,.12)] focus:outline-none focus:border-[rgba(0,255,136,.35)] focus:bg-[rgba(0,255,136,.03)] transition-all" />
        </div>

        <div>
          <label class="block text-[.45rem] font-semibold tracking-[.18em] text-[rgba(232,220,200,.3)] uppercase mb-1.5 font-[family-name:var(--font-cinzel)]" for="player-bio">BIOGRAFÍA</label>
          <textarea id="player-bio" rows="3" placeholder="Cuéntanos sobre el jugador..." class="w-full px-3.5 py-2.5 rounded-lg text-[.55rem] tracking-wider text-[var(--color-theme-cream)] bg-[rgba(255,255,255,.03)] border border-[rgba(199,168,107,.14)] placeholder:text-[rgba(232,220,200,.12)] focus:outline-none focus:border-[rgba(0,255,136,.35)] focus:bg-[rgba(0,255,136,.03)] transition-all resize-vertical"></textarea>
        </div>

        <!-- <div>
          <label class="block text-[.45rem] font-semibold tracking-[.18em] text-[rgba(232,220,200,.3)] uppercase mb-1.5 font-[family-name:var(--font-cinzel)]">FOTO</label>
          <div id="upload-area" class="relative flex flex-col items-center justify-center gap-2 p-6 rounded-lg border-2 border-dashed cursor-pointer transition-all" style="border-color:rgba(199,168,107,.14);background:rgba(255,255,255,.015);min-height:100px" onclick="if(!event.target.closest('#btn-remove-image'))document.getElementById('player-image-upload').click()">
            <input type="file" id="player-image-upload" accept="image/*" class="hidden" />
            <div id="upload-placeholder" class="flex flex-col items-center gap-2 text-[rgba(232,220,200,.2)]">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              <span class="text-[.45rem] tracking-wider uppercase">TOCAR PARA SUBIR FOTO</span>
            </div>
            <div id="upload-preview" class="hidden relative">
              <img id="upload-preview-img" src="" alt="Foto" class="w-24 h-24 object-cover rounded-lg" />
              <button id="btn-remove-image" type="button" class="absolute -top-2 -right-2 w-5 h-5 rounded-full flex items-center justify-center bg-black/70 border border-white/20 text-white hover:bg-[#ef4444] transition-colors">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </div>
          </div>
        </div> -->

        <div id="form-error" class="hidden text-[#ef4444] text-[.5rem] tracking-wide py-1"></div>

        <button type="submit" id="btn-submit" class="w-full flex items-center justify-center gap-2 mt-2 font-[family-name:var(--font-cinzel)] text-[.48rem] font-bold tracking-[.18em] uppercase rounded-full px-5 py-3 border-0 cursor-pointer transition-all text-[var(--color-theme-midnight,#1e1b4b)]" style="background:linear-gradient(135deg,var(--color-theme-gold,#fbbf24),#f59e0b);box-shadow:0 0 20px rgba(251,191,36,.15)" onmouseover="this.style.filter='brightness(1.1)'" onmouseout="this.style.filter=''">
          AGREGAR JUGADOR
        </button>
      </div>
    </form>
  </main>
</div>
<MenuAndroid />
</Layout>

<style>
  @keyframes blink2 {
    0%,100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.3; transform: scale(0.8); }
  }
</style>

<script data-astro-rerun>
(function(){
  const $ = id => document.getElementById(id);
  const esc = str => { const d=document.createElement('div'); d.textContent=str; return d.innerHTML; };

  let uploadedImageUrl = '';

  const imageInput = $('player-image-upload');
  const removeBtn = $('btn-remove-image');
  if (imageInput && removeBtn) {
    removeBtn.addEventListener('click', e => {
      e.stopPropagation();
      uploadedImageUrl = '';
      $('upload-placeholder').classList.remove('hidden');
      $('upload-preview').classList.add('hidden');
      imageInput.value = '';
    });

    imageInput.addEventListener('change', async e => {
      const file = e.target.files[0];
      if (!file) return;
      if (file.size > 500 * 1024) { alert('Máximo 500KB'); return; }
      const formData = new FormData();
      formData.append('file', file);
      try {
        const res = await fetch('/api/teams/upload-logo', { method: 'POST', body: formData });
        const data = await res.json();
        if (!data.success) throw new Error(data.error || 'Error');
        uploadedImageUrl = data.url;
        $('upload-preview-img').src = data.url;
        $('upload-placeholder').classList.add('hidden');
        $('upload-preview').classList.remove('hidden');
      } catch (err) {
        alert('Error al subir imagen: ' + err.message);
      }
    });
  }

  $('add-player-form').addEventListener('submit', async e => {
    e.preventDefault();
    const errorEl = $('form-error');
    errorEl.classList.add('hidden');

    const name = $('player-name').value.trim();
    const realName = $('player-real-name').value.trim();
    const age = $('player-age').value.trim();
    const number = $('player-number').value.trim();
    const city = $('player-city').value.trim();
    const neighborhood = $('player-neighborhood').value.trim();
    const position = $('player-position').value;
    const preferredFoot = $('player-foot').value;
    const shirtName = $('player-shirt-name').value.trim();
    const bio = $('player-bio').value.trim();

    if (!name) { errorEl.textContent = 'El nombre es obligatorio'; errorEl.classList.remove('hidden'); return; }
    if (!position) { errorEl.textContent = 'La posición es obligatoria'; errorEl.classList.remove('hidden'); return; }

    const btn = $('btn-submit');
    btn.textContent = 'AGREGANDO...';
    btn.disabled = true;

    const teams = JSON.parse(localStorage.getItem('tec_teams') || '[]');
    const activeId = localStorage.getItem('tec_activeTeam');
    const team = teams.find(t => t.id === activeId);

    if (!team) {
      errorEl.textContent = 'No hay un equipo seleccionado. Ve a EQUIPOS y selecciona uno.';
      errorEl.classList.remove('hidden');
      btn.textContent = 'AGREGAR JUGADOR';
      btn.disabled = false;
      return;
    }

    try {
      const res = await fetch('/api/team-requests', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'add-player',
          teamId: team.id,
          name,
          realName: realName || null,
          age: age || null,
          number: number || null,
          city: city || null,
          neighborhood: neighborhood || null,
          position,
          preferredFoot: preferredFoot || null,
          shirtName,
          bio: bio || null,
          imageBig: uploadedImageUrl || null,
          imageCard: uploadedImageUrl || null,
        }),
      });
      const data = await res.json();
      if (data.success) {
        alert('Jugador agregado correctamente a la plantilla');
        window.location.href = '/tecnico';
      } else {
        errorEl.textContent = data.error || 'Error al agregar jugador';
        errorEl.classList.remove('hidden');
      }
    } catch (err) {
      errorEl.textContent = 'Error de red';
      errorEl.classList.remove('hidden');
    }

    btn.textContent = 'AGREGAR JUGADOR';
    btn.disabled = false;
  });
})();
</script>
