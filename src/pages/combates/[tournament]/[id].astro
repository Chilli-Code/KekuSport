---
import HeroEvent from '@/components/Heroevent.astro'
import Layout from '@/layouts/Layout.astro'
import { TEAMS } from '@/consts/teams'
import { PLAYERS } from '@/consts/fighters'
import Matchstats from '@/components/Matchstats.astro'
import { getDb, getMatchLineup, getTeamSquadByTeamId } from '../../../../server/db'

const { tournament, id } = Astro.params

if (!id) return Astro.redirect('/combates')

function slugify(text: string): string {
  return text.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '')
}

function formatDate(iso: string): string {
  if (!iso) return ''
  const d = new Date(iso.split('T')[0] + 'T12:00:00')
  if (isNaN(d.getTime())) return ''
  return d.toLocaleDateString('es-ES', { weekday: 'short', day: 'numeric', month: 'short' }).toUpperCase().replace(/\./g, '')
}

let matchDate = ''
let matchVenue = ''
let matchTournament = ''
let matchEdition = 'NO DEFINIDO'
let matchId = ''
let matchStatus = ''
let matchDuration = 90
let matchElapsedSeconds = 0
let ssrEvents: any[] = []
let team1Name = '', team2Name = '', team1Id = '', team2Id = ''
let team1Players: { id: string; name: string }[] = [], team2Players: { id: string; name: string }[] = []
let team1Logo: string | null = null, team2Logo: string | null = null
let team1Color = '#00ff88', team2Color = '#f59e0b'
let fieldPlayers = 5
let team1Lineup: { formation: string; players: Record<string, { playerId: string; playerName: string; playerImage: string | null }>; kit: number } | null = null
let team2Lineup: typeof team1Lineup = null
try {
  const db = await getDb()
  const result = await db.execute({
    sql: `SELECT m.id, m.scheduled_date, m.venue, m.status, m.elapsed_seconds,
                 t.name as tournament_name, t.match_duration, t.field_players,
                 ht.id as home_team_id, ht.name as home_name, ht.logo as home_logo, ht.color as home_color,
                 at.id as away_team_id, at.name as away_name, at.logo as away_logo, at.color as away_color
          FROM matches m
          JOIN tournaments t ON t.id = m.tournament_id
          JOIN teams ht ON ht.id = m.home_team_id
          JOIN teams at ON at.id = m.away_team_id
          WHERE m.id = ?`,
    args: [id],
  })

  if (result.rows.length > 0) {
    const row = result.rows[0] as any
    matchId = row.id || ''
    matchStatus = (row.status || '').toLowerCase()
    matchDate = formatDate(row.scheduled_date || '')
    matchVenue = (row.venue || '').toUpperCase()
    matchTournament = (row.tournament_name || '').toUpperCase()
    matchDuration = row.match_duration || 90
    matchElapsedSeconds = row.elapsed_seconds || 0
    team1Id = row.home_team_id || ''
    team2Id = row.away_team_id || ''
    team1Name = row.home_name || ''
    team2Name = row.away_name || ''
    team1Logo = row.home_logo || null
    team2Logo = row.away_logo || null
    team1Color = row.home_color || '#00ff88'
    team2Color = row.away_color || '#f59e0b'
    fieldPlayers = row.field_players || 5
    const dbTeam1 = TEAMS.find(t => t.id === team1Id)
    const dbTeam2 = TEAMS.find(t => t.id === team2Id)
    team1Players = dbTeam1 ? PLAYERS.filter(p => p.team === dbTeam1.id).map(p => ({ id: p.id, name: p.name })) : []
    team2Players = dbTeam2 ? PLAYERS.filter(p => p.team === dbTeam2.id).map(p => ({ id: p.id, name: p.name })) : []
    const status = matchStatus
    const sched = row.scheduled_date || ''
    if (status === 'live') {
      matchEdition = 'EN VIVO'
    } else if (status === 'completed' || status === 'finished' || status === 'cancelled') {
      matchEdition = status === 'cancelled' ? 'CANCELADO' : 'FINALIZADO'
    } else if (status === 'scheduled' || status === 'pending') {
      matchEdition = 'PROGRAMADO'
    } else if (sched) {
      matchEdition = 'PROGRAMADO'
    }

    if (matchId) {
      const eventsResult = await db.execute({
        sql: 'SELECT * FROM match_events WHERE match_id = ? ORDER BY minute ASC',
        args: [matchId],
      })
      ssrEvents = (eventsResult.rows as any[]).map((e: any) => ({
        minute: e.minute,
        team: e.team.toUpperCase(),
        type: e.type === 'change' ? 'sub' : e.type,
        player: e.player || '',
        player2: e.player2 || undefined,
        detail: e.detail || undefined,
      }))
    }
  }

  const FORMATIONS_DATA_SSR: Record<string, [string, number, number][]> = {
    '2-2':   [['POR',50,92],['DF',30,75],['DF2',70,75],['MF',30,45],['MF2',70,45]],
    '2-1-1': [['POR',50,92],['DF',30,77],['DF2',70,77],['MF',50,50],['FW',50,25]],
    '1-2-1': [['POR',50,92],['DF',50,77],['MF1',30,50],['MF2',70,50],['FW',50,25]],
    '1-1-2': [['POR',50,92],['DF',50,77],['MF',50,50],['FW1',35,25],['FW2',65,25]],
    '3-1':   [['POR',50,92],['DF1',25,77],['DF2',50,77],['DF3',75,77],['MF',50,45]],
    '1-3':   [['POR',50,92],['DF',50,77],['MF1',20,50],['MF2',50,50],['MF3',80,50]],
    '3-2-1': [['POR',50,92],['DF1',25,75],['DF2',50,75],['DF3',75,75],['MF1',30,50],['MF2',70,50],['FW',50,25]],
    '3-1-2': [['POR',50,92],['DF1',25,75],['DF2',50,75],['DF3',75,75],['MF',50,50],['FW1',30,25],['FW2',70,25]],
    '2-3-1': [['POR',50,92],['DF1',30,75],['DF2',70,75],['MF1',20,50],['MF2',50,50],['MF3',80,50],['FW',50,25]],
    '2-2-2': [['POR',50,92],['DF1',30,75],['DF2',70,75],['MF1',30,50],['MF2',70,50],['FW1',35,25],['FW2',65,25]],
    '4-2-0': [['POR',50,92],['DF1',15,75],['DF2',38,75],['DF3',62,75],['DF4',85,75],['MF1',35,50],['MF2',65,50]],
    '2-1-3': [['POR',50,92],['DF1',30,75],['DF2',70,75],['MF',50,50],['FW1',20,25],['FW2',50,25],['FW3',80,25]],
    '4-3-3':   [['POR',50,92],['LD',15,73],['DC',37,73],['DCI',63,73],['LI',85,73],['MC',25,52],['MCO',50,52],['MCI',75,52],['ED',20,27],['DC2',50,24],['EI',80,27]],
    '4-4-2':   [['POR',50,92],['LD',15,73],['DC',37,73],['DCI',63,73],['LI',85,73],['ED',15,52],['MC',38,52],['MCI',62,52],['EI',85,52],['DC1',35,24],['DC2',65,24]],
    '4-2-3-1': [['POR',50,92],['LD',15,73],['DC',37,73],['DCI',63,73],['LI',85,73],['MCD1',35,60],['MCD2',65,60],['ED',20,40],['MC',50,40],['EI',80,40],['DC',50,20]],
    '3-5-2':   [['POR',50,92],['DC1',30,73],['DC2',50,73],['DC3',70,73],['CAD',10,54],['MC1',30,54],['MC2',50,54],['MC3',70,54],['CAI',90,54],['DC1',35,24],['DC2',65,24]],
    '5-3-2':   [['POR',50,92],['LD',8,72],['DC1',28,74],['DC2',50,74],['DC3',72,74],['LI',92,72],['MC1',28,50],['MC2',50,50],['MC3',72,50],['DC1',35,24],['DC2',65,24]],
    '4-3-2-1': [['POR',50,92],['LD',15,73],['DC',37,73],['DCI',63,73],['LI',85,73],['MC1',25,56],['MC2',50,56],['MC3',75,56],['MI1',35,38],['MI2',65,38],['DC',50,20]],
  }

  async function buildLineup(matchId: string, teamId: string, squadMap: Record<string, { name: string; image_card: string | null }>) {
    const lu = await getMatchLineup(matchId, teamId)
    if (!lu) return null
    const formation = lu.formation
    const rawLineup = JSON.parse(lu.lineup) as Record<string, string>
    const positions = FORMATIONS_DATA_SSR[formation] || []
    const players: Record<string, { playerId: string; playerName: string; playerImage: string | null }> = {}
    let filled = 0
    positions.forEach(([key], i) => {
      const playerId = rawLineup[`${formation}_${i}`]
      if (playerId) {
        const info = squadMap[playerId]
        players[key] = { playerId, playerName: info?.name || key, playerImage: info?.image_card || null }
        filled++
      } else {
        players[key] = { playerId: '', playerName: key, playerImage: null }
      }
    })
    if (filled < positions.length) return null
    return { formation, players, kit: lu.kit ?? 0 }
  }

  async function loadSquadMap(teamId: string): Promise<Record<string, { name: string; image_card: string | null }>> {
    try {
      const squad = await getTeamSquadByTeamId(teamId)
      const map: Record<string, { name: string; image_card: string | null }> = {}
      for (const s of squad) {
        map[s.id] = { name: s.player_name, image_card: s.player_image_card }
      }
      return map
    } catch { return {} }
  }

  if (matchId && team1Id) {
    try {
      const squadMap = await loadSquadMap(team1Id)
      team1Lineup = await buildLineup(matchId, team1Id, squadMap)
    } catch {}
  }
  if (matchId && team2Id) {
    try {
      const squadMap = await loadSquadMap(team2Id)
      team2Lineup = await buildLineup(matchId, team2Id, squadMap)
    } catch {}
  }
} catch {}

const ssrScoreA = ssrEvents.filter(e => e.team === 'A' && e.type === 'goal').length
const ssrScoreB = ssrEvents.filter(e => e.team === 'B' && e.type === 'goal').length
---
<Layout>
  <HeroEvent
    teamA={{ id: team1Id, name: team1Name, players: team1Players, logo: team1Logo || undefined, color: team1Color, lineup: team1Lineup }}
    teamB={{ id: team2Id, name: team2Name, players: team2Players, logo: team2Logo || undefined, color: team2Color, lineup: team2Lineup }}
    date={matchDate || undefined}
    venue={matchVenue || undefined}
    eventName={matchTournament || undefined}
    edition={matchEdition}
    platform="KEKU SPORT"
  />

  <div id="ms-poll-data"
    data-match-id={matchId}
    data-status={matchStatus}
    data-match-duration={matchDuration}
    data-elapsed-seconds={matchElapsedSeconds}
  ></div>

  <Matchstats
    teamA={{ name: team1Name, color: team1Color, logo: team1Logo || '/images/Logo_Default.webp' }}
    teamB={{ name: team2Name, color: team2Color, logo: team2Logo || '/images/Logo_Default.webp' }}
    matchId={matchId}
    matchDuration={matchDuration}
    isLive={matchEdition === 'EN VIVO'}
    minute={Math.floor(matchElapsedSeconds / 60)}
    score={[ssrScoreA, ssrScoreB]}
    events={ssrEvents}
  />
</Layout>

<script>
(function() {
  const el = document.getElementById('ms-poll-data');
  if (!el) return;
  const matchId = el.dataset.matchId;
  const status = el.dataset.status;
  const matchDuration = parseInt(el.dataset.matchDuration || '90', 10);
  if (!matchId || status !== 'live') return;

  const EVENT_ICONS = { goal:'⚽', yellow:'🟨', red:'🟥', sub:'🔄', var:'📺', shot:'🎯', foul:'⚠️' };

  function updateTimeBar(minute) {
    const minEl = document.querySelector('.ms-minute-num');
    const fillEl = document.querySelector('.ms-time-fill');
    const dotEl = document.querySelector('.ms-time-dot');
    if (minEl) minEl.textContent = minute + "'";
    if (fillEl) fillEl.style.width = Math.min((minute / matchDuration) * 100, 100) + '%';
    if (dotEl) dotEl.style.left = Math.min((minute / matchDuration) * 100, 100) + '%';
  }

  async function poll() {
    try {
      const res = await fetch(`/api/matches/${matchId}/events`);
      const data = await res.json();
      if (!data.success) return;
      const events = data.events || [];

      if (data.elapsedSeconds !== undefined) {
        const minute = Math.floor(data.elapsedSeconds / 60);
        updateTimeBar(minute);
      }

      const goalsA = events.filter(e => e.team.toUpperCase() === 'A' && e.type === 'goal').length;
      const goalsB = events.filter(e => e.team.toUpperCase() === 'B' && e.type === 'goal').length;
      const scoreEls = document.querySelectorAll('.ms-score');
      if (scoreEls.length >= 2) {
        scoreEls[0].textContent = goalsA;
        scoreEls[1].textContent = goalsB;
      }

      const timeline = document.querySelector('.ms-events-wrap');
      if (!timeline) return;
      const timelineInner = timeline.querySelector('.ms-events-list');
      if (!timelineInner) return;

      timelineInner.innerHTML = events.map(e => {
        const side = e.team.toUpperCase();
        const type = e.type === 'change' ? 'sub' : e.type;
        const icon = EVENT_ICONS[type] || '📌';
        return `
          <div class="ms-event ms-event--${side.toLowerCase()}">
            <div class="ms-event-side ms-event-side--a">
              ${side === 'A' ? `<div class="ms-event-content ms-event-content--a">
                <span class="ms-event-player">${e.player || ''}</span>
                ${type === 'sub' && e.player2 ? `<span class="ms-event-sub">↑ ${e.player2}</span>` : ''}
                ${type === 'shot' && e.detail ? `<span class="ms-event-detail">${e.detail}</span>` : ''}
              </div>` : ''}
            </div>
            <div class="ms-event-mid">
              <span class="ms-event-min">${e.minute}'</span>
              <div class="ms-event-icon ms-event-icon--${type}">${icon}</div>
            </div>
            <div class="ms-event-side ms-event-side--b">
              ${side === 'B' ? `<div class="ms-event-content ms-event-content--b">
                <span class="ms-event-player">${e.player || ''}</span>
                ${type === 'sub' && e.player2 ? `<span class="ms-event-sub">↑ ${e.player2}</span>` : ''}
                ${type === 'shot' && e.detail ? `<span class="ms-event-detail">${e.detail}</span>` : ''}
              </div>` : ''}
            </div>
          </div>`;
      }).join('');
    } catch {}
  }

  setInterval(poll, 5000);
})();
</script>
