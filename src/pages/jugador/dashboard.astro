---
import Layout from '../../layouts/Layout.astro'
import MenuJugador from '../../components/ui/menuJugador.astro'
import { getPlayerByUser, getPlayerAcceptedTeam } from '../../../server/db'

const user = Astro.locals.user
if (!user || user.role !== 'jugador') {
  return Astro.redirect('/login')
}

const player = getPlayerByUser(user.id)
const acceptedTeam = player ? getPlayerAcceptedTeam(player.id) : undefined
const hasTeam = !!acceptedTeam
---

<Layout hideFooter={true}>
  <main style="min-height:100svh;background:#050d08;padding:2rem 1rem 6rem">
    <div style="max-width:720px;margin:0 auto">

      <!-- Header -->
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.5rem">
        <div>
          <h1 style="font-family:'Cinzel',serif;font-size:1rem;font-weight:900;letter-spacing:.06em;text-transform:uppercase;color:var(--color-theme-cream,#fef3c7)">
            PANEL <span style="color:var(--color-theme-gold,#fbbf24)">JUGADOR</span>
          </h1>
          <p style="font-size:.5rem;letter-spacing:.1em;color:rgba(232,220,200,.3);text-transform:uppercase;margin-top:.15rem">Bienvenido, {player?.name || user.name}</p>
        </div>
        {player && <a href="/jugador" style="padding:.35rem .7rem;border-radius:6px;font-family:'Cinzel',serif;font-size:.42rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;text-decoration:none;border:1px solid var(--color-theme-gold);color:var(--color-theme-gold);background:transparent;transition:all .2s">EDITAR PERFIL</a>}
      </div>

      {!player ? (
        <div style="margin-top:2rem;padding:2rem;border-radius:12px;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.02);text-align:center">
          <p style="font-size:.7rem;color:rgba(232,220,200,.5);margin-bottom:1rem">No tienes un perfil de jugador aún. Crea uno para empezar.</p>
          <a href="/jugador" style="display:inline-block;padding:.6rem 1.2rem;border-radius:8px;font-family:'Cinzel',serif;font-size:.5rem;font-weight:800;letter-spacing:.15em;text-transform:uppercase;text-decoration:none;background:var(--color-theme-gold);color:var(--color-theme-midnight)">CREAR PERFIL</a>
        </div>
      ) : (
        <>
          <!-- Team Status -->
          <div style="margin-top:1.5rem;padding:1rem;border-radius:12px;border:1px solid rgba(255,255,255,.06);background:rgba(255,255,255,.02)">
            <p style="font-size:.5rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:rgba(232,220,200,.4);margin-bottom:.5rem">MI EQUIPO</p>
            {hasTeam ? (
              <div style="display:flex;align-items:center;gap:.7rem">
                <div style="width:40px;height:40px;border-radius:8px;background:{acceptedTeam.team_color || '#00ff88'}22;border:1px solid {acceptedTeam.team_color || '#00ff88'}44;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                  🏆
                </div>
                <div>
                  <div style="font-size:.8rem;font-weight:600;color:var(--color-theme-cream)">{acceptedTeam.team_name}</div>
                  <div style="font-size:.5rem;color:#00ff88;font-weight:600;letter-spacing:.1em;text-transform:uppercase">✓ ACEPTADO</div>
                </div>
              </div>
            ) : (
              <div>
                <p style="font-size:.6rem;color:rgba(232,220,200,.25)">Aún no estás en ningún equipo. Busca uno abajo.</p>
              </div>
            )}
          </div>

          <!-- Team Search -->
          <div style="margin-top:1.5rem">
            <p style="font-size:.55rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:rgba(232,220,200,.4);margin-bottom:.7rem">BUSCAR EQUIPOS</p>
            <div style="position:relative;margin-bottom:.7rem">
              <input id="team-search-input" type="text" placeholder="Buscar equipos por nombre..." style="width:100%;padding:.7rem .8rem;padding-left:2.2rem;border-radius:8px;border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.03);color:var(--color-theme-cream);font-size:.85rem;outline:none;transition:border-color .2s;box-sizing:border-box" />
              <span style="position:absolute;left:.7rem;top:50%;transform:translateY(-50%);font-size:.85rem;color:rgba(232,220,200,.25)">🔍</span>
            </div>
            <div id="team-search-results" style="display:flex;flex-direction:column;gap:.5rem;min-height:2rem"></div>
          </div>

          <!-- My Requests -->
          <div id="my-requests-section" style="margin-top:1.5rem">
            <p style="font-size:.55rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:rgba(232,220,200,.4);margin-bottom:.5rem">MIS SOLICITUDES</p>
            <div id="my-requests-list" style="display:flex;flex-direction:column;gap:.4rem"></div>
          </div>
        </>
      )}

    </div>
  </main>
  <MenuJugador />
</Layout>

<script>
  const FIFA_POSITIONS = {GK:'Portero',CB:'Defensa Central',LB:'Lateral Izquierdo',RB:'Lateral Derecho',LWB:'Carrilero Izquierdo',RWB:'Carrilero Derecho',CDM:'Medio Defensivo',CM:'Medio Centro',CAM:'Medio Ofensivo',LM:'Medio Izquierdo',RM:'Medio Derecho',LW:'Extremo Izquierdo',RW:'Extremo Derecho',CF:'Segundo Delantero',ST:'Delantero Centro'}

  const $ = id => document.getElementById(id)
  let searchTimeout = null

  // ── Team Search ──
  $('team-search-input').addEventListener('input', () => {
    clearTimeout(searchTimeout)
    const q = $('team-search-input').value.trim()
    if (q.length < 2) { $('team-search-results').innerHTML = ''; return }
    searchTimeout = setTimeout(() => searchTeams(q), 300)
  })

  async function searchTeams(q) {
    try {
      const res = await fetch('/api/teams', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'search', q }),
      })
      const data = await res.json()
      if (data.success) renderTeamResults(data.teams || [])
    } catch {}
  }

  async function fetchMyRequests() {
    try {
      const res = await fetch('/api/team-requests')
      const data = await res.json()
      return data.success ? data.requests : []
    } catch { return [] }
  }

  async function renderTeamResults(teams) {
    const container = $('team-search-results')
    if (!teams.length) {
      container.innerHTML = '<p style="font-size:.65rem;color:rgba(232,220,200,.25)">No se encontraron equipos</p>'
      return
    }
    const myRequests = await fetchMyRequests()
    const hasAccepted = myRequests.some(r => r.status === 'accepted')

    container.innerHTML = teams.map(t => {
      const pending = myRequests.find(r => r.team_id === t.id && r.status === 'pending')
      const accepted = myRequests.find(r => r.team_id === t.id && r.status === 'accepted')
      let btnHtml = ''
      if (accepted) {
        btnHtml = '<span style="font-size:.5rem;color:#00ff88;font-weight:700;letter-spacing:.1em">✓ ACEPTADO</span>'
      } else if (pending) {
        btnHtml = '<span style="font-size:.5rem;color:#fbbf24;font-weight:700;letter-spacing:.1em">⏳ PENDIENTE</span>'
      } else if (hasAccepted) {
        btnHtml = '<span style="font-size:.45rem;color:rgba(232,220,200,.2);font-style:italic">Ya tienes un equipo</span>'
      } else {
        btnHtml = `<button class="team-request-btn" data-team-id="${t.id}" data-team-name="${t.name}" style="padding:.3rem .7rem;border-radius:6px;font-family:'Cinzel',serif;font-size:.45rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;cursor:pointer;border:1px solid var(--color-theme-gold);color:var(--color-theme-gold);background:transparent;transition:all .2s">SOLICITAR</button>`
      }
      return `
        <div style="display:flex;align-items:center;gap:.7rem;padding:.6rem .8rem;border-radius:8px;border:1px solid rgba(255,255,255,.06);background:rgba(255,255,255,.02)">
          <div style="width:32px;height:32px;border-radius:6px;background:${t.color || '#00ff88'}22;border:1px solid ${t.color || '#00ff88'}44;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:.7rem">${t.logo ? `<img src="${t.logo}" style="width:100%;height:100%;object-fit:cover;border-radius:6px" />` : '⚔️'}</div>
          <div style="flex:1;min-width:0">
            <div style="font-size:.7rem;font-weight:600;color:var(--color-theme-cream);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${t.name}</div>
            <div style="font-size:.5rem;color:rgba(232,220,200,.3);letter-spacing:.05em;text-transform:uppercase">${t.category || 'Sin categoría'}</div>
          </div>
          ${btnHtml}
        </div>
      `
    }).join('')

    container.querySelectorAll('.team-request-btn').forEach(btn => {
      btn.addEventListener('click', () => sendRequest(btn.dataset.teamId, btn.dataset.teamName))
    })
  }

  async function sendRequest(teamId, teamName) {
    try {
      const res = await fetch('/api/team-requests', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'send', teamId }),
      })
      const data = await res.json()
      if (data.success) {
        alert(`Solicitud enviada a ${teamName}`)
        $('team-search-input').value = ''
        $('team-search-results').innerHTML = ''
        loadMyRequests()
      } else {
        alert(data.error || 'Error al enviar solicitud')
      }
    } catch {
      alert('Error de red')
    }
  }

  async function loadMyRequests() {
    const requests = await fetchMyRequests()
    const container = $('my-requests-list')
    if (!container) return
    if (!requests.length) {
      container.innerHTML = '<p style="font-size:.55rem;color:rgba(232,220,200,.2)">No has enviado solicitudes aún</p>'
      return
    }
    container.innerHTML = requests.map(r => {
      const statusMap = { pending: '⏳ Pendiente', accepted: '✅ Aceptada', rejected: '❌ Rechazada' }
      const colorMap = { pending: '#fbbf24', accepted: '#00ff88', rejected: '#f87171' }
      return `
        <div style="display:flex;align-items:center;gap:.5rem;padding:.4rem .7rem;border-radius:6px;border:1px solid rgba(255,255,255,.04);background:rgba(255,255,255,.015);font-size:.6rem">
          <span style="color:var(--color-theme-cream)">Solicitud a equipo</span>
          <span style="color:${colorMap[r.status]};font-weight:600;margin-left:auto">${statusMap[r.status]}</span>
        </div>
      `
    }).join('')
  }

  loadMyRequests()
</script>

<style>
  input:focus { border-color: var(--color-theme-gold) !important; }
  .team-request-btn:hover { background: rgba(var(--color-theme-gold-rgb), .1); }
</style>
