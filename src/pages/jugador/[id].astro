---
import { PLAYERS } from '@/consts/fighters'

const { id } = Astro.params

const found = PLAYERS.find((p: any) => p.id === id)
if (!found) return Astro.redirect('/404')

const player = found
const imgSrc = `/images/fighters/big/jugador_mistery.webp`
---

<html>
  <head><title>{player.name}</title></head>
  <body style="background:#050d08;color:#fef3c7;font-family:sans-serif;padding:2rem">
    <h1>{player.name}</h1>
    <p>{player.position} · {player.city}</p>
    <img src={imgSrc} alt={player.name} style="max-width:300px" />
    <p>{player.bio}</p>
    <a href="/" style="color:#fbbf24">&larr; Volver</a>
  </body>
</html>
