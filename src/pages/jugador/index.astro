---
import Layout from '../../layouts/Layout.astro'
const user = Astro.locals.user
const FIFA_POSITIONS = [
  { value: 'GK', label: 'Portero (GK)' },
  { value: 'CB', label: 'Defensa Central (CB)' },
  { value: 'LB', label: 'Lateral Izquierdo (LB)' },
  { value: 'RB', label: 'Lateral Derecho (RB)' },
  { value: 'LWB', label: 'Carrilero Izquierdo (LWB)' },
  { value: 'RWB', label: 'Carrilero Derecho (RWB)' },
  { value: 'CDM', label: 'Medio Defensivo (CDM)' },
  { value: 'CM', label: 'Medio Centro (CM)' },
  { value: 'CAM', label: 'Medio Ofensivo (CAM)' },
  { value: 'LM', label: 'Medio Izquierdo (LM)' },
  { value: 'RM', label: 'Medio Derecho (RM)' },
  { value: 'LW', label: 'Extremo Izquierdo (LW)' },
  { value: 'RW', label: 'Extremo Derecho (RW)' },
  { value: 'CF', label: 'Segundo Delantero (CF)' },
  { value: 'ST', label: 'Delantero Centro (ST)' },
]
---

<Layout hideFooter={true}>
  <main id="player-dashboard" style="min-height:100svh;background:#050d08;padding:6rem 1.5rem 5rem">
    <div style="max-width:720px;margin:0 auto;">

      <!-- Loading state -->
      <div id="player-loading" style="display:flex;align-items:center;justify-content:center;padding:4rem 0;color:rgba(232,220,200,.4);font-family:'Rajdhani',sans-serif;font-size:.85rem;letter-spacing:.1em;text-transform:uppercase;gap:.5rem">
        <span style="display:inline-block;width:12px;height:12px;border-radius:50%;border:2px solid var(--color-theme-gold);border-top-color:transparent;animation:spin .6s linear infinite"></span>
        CARGANDO PERFIL...
      </div>

      <!-- Profile form (hidden initially) -->
      <div id="player-form" style="display:none">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:2rem">
          <div>
            <h1 style="font-family:'Cinzel',serif;font-size:1.5rem;font-weight:900;letter-spacing:.06em;text-transform:uppercase;color:var(--color-theme-cream,#fef3c7)">MI PERFIL</h1>
            <p id="form-subtitle" style="font-size:.6rem;letter-spacing:.1em;color:rgba(232,220,200,.35);text-transform:uppercase;margin-top:.25rem">Crea tu perfil de jugador</p>
          </div>
          <button id="btn-toggle-edit" style="display:none;padding:.4rem 1rem;border-radius:8px;font-family:'Cinzel',serif;font-size:.55rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;cursor:pointer;border:1px solid var(--color-theme-gold);color:var(--color-theme-gold);background:transparent;transition:all .2s">EDITAR</button>
        </div>

        <!-- Image previews -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:2rem">
          <div style="border-radius:12px;overflow:hidden;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.025);aspect-ratio:3/4;display:flex;align-items:center;justify-content:center;position:relative">
            <img id="preview-big" src="/images/fighters/big/jugador_mistery.webp" alt="Vista previa grande" style="width:100%;height:100%;object-fit:cover" />
            <span style="position:absolute;bottom:6px;left:6px;font-size:.45rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:rgba(232,220,200,.4);background:rgba(0,0,0,.6);padding:2px 8px;border-radius:4px">BIG</span>
          </div>
          <div style="border-radius:12px;overflow:hidden;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.025);aspect-ratio:3/4;display:flex;align-items:center;justify-content:center;position:relative">
            <img id="preview-card" src="/images/fighters/cards/jugador_mistery_card.png" alt="Vista previa card" style="width:100%;height:100%;object-fit:cover" />
            <span style="position:absolute;bottom:6px;left:6px;font-size:.45rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:rgba(232,220,200,.4);background:rgba(0,0,0,.6);padding:2px 8px;border-radius:4px">CARD</span>
          </div>
        </div>

        <!-- Fields -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
          <div style="grid-column:1/-1">
            <label style="font-size:.55rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:rgba(232,220,200,.5);display:block;margin-bottom:.35rem">Nombre *</label>
            <input id="field-name" type="text" placeholder="Tu nombre de jugador" style="width:100%;padding:.7rem .8rem;border-radius:8px;border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.03);color:var(--color-theme-cream);font-size:.85rem;outline:none;transition:border-color .2s;box-sizing:border-box" />
          </div>
          <div>
            <label style="font-size:.55rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:rgba(232,220,200,.5);display:block;margin-bottom:.35rem">Nombre Real</label>
            <input id="field-realName" type="text" placeholder="Ej: Alejandro García" style="width:100%;padding:.7rem .8rem;border-radius:8px;border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.03);color:var(--color-theme-cream);font-size:.85rem;outline:none;transition:border-color .2s;box-sizing:border-box" />
          </div>
          <div>
            <label style="font-size:.55rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:rgba(232,220,200,.5);display:block;margin-bottom:.35rem">Edad</label>
            <input id="field-age" type="number" min="10" max="99" placeholder="Ej: 24" style="width:100%;padding:.7rem .8rem;border-radius:8px;border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.03);color:var(--color-theme-cream);font-size:.85rem;outline:none;transition:border-color .2s;box-sizing:border-box" />
          </div>
          <div>
            <label style="font-size:.55rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:rgba(232,220,200,.5);display:block;margin-bottom:.35rem">Ciudad</label>
            <input id="field-city" type="text" placeholder="Ej: Barranquilla" style="width:100%;padding:.7rem .8rem;border-radius:8px;border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.03);color:var(--color-theme-cream);font-size:.85rem;outline:none;transition:border-color .2s;box-sizing:border-box" />
          </div>
          <div>
            <label style="font-size:.55rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:rgba(232,220,200,.5);display:block;margin-bottom:.35rem">Barrio</label>
            <input id="field-neighborhood" type="text" placeholder="Ej: El Prado" style="width:100%;padding:.7rem .8rem;border-radius:8px;border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.03);color:var(--color-theme-cream);font-size:.85rem;outline:none;transition:border-color .2s;box-sizing:border-box" />
          </div>
          <div>
            <label style="font-size:.55rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:rgba(232,220,200,.5);display:block;margin-bottom:.35rem">Dorsal</label>
            <input id="field-number" type="number" min="0" max="99" placeholder="Ej: 10" style="width:100%;padding:.7rem .8rem;border-radius:8px;border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.03);color:var(--color-theme-cream);font-size:.85rem;outline:none;transition:border-color .2s;box-sizing:border-box" />
          </div>
          <div>
            <label style="font-size:.55rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:rgba(232,220,200,.5);display:block;margin-bottom:.35rem">Pie Hábil</label>
            <select id="field-foot" style="width:100%;padding:.7rem .8rem;border-radius:8px;border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.03);color:var(--color-theme-cream);font-size:.85rem;outline:none;transition:border-color .2s;box-sizing:border-box;appearance:auto">
              <option value="">Seleccionar...</option>
              <option value="Derecho">Derecho</option>
              <option value="Zurdo">Zurdo</option>
              <option value="Ambos">Ambos</option>
            </select>
          </div>
          <div>
            <label style="font-size:.55rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:rgba(232,220,200,.5);display:block;margin-bottom:.35rem">Posición *</label>
            <select id="field-position" style="width:100%;padding:.7rem .8rem;border-radius:8px;border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.03);color:var(--color-theme-cream);font-size:.85rem;outline:none;transition:border-color .2s;box-sizing:border-box;appearance:auto">
              <option value="">Seleccionar...</option>
              {FIFA_POSITIONS.map(p => (
                <option value={p.value}>{p.label}</option>
              ))}
            </select>
          </div>
          <div style="grid-column:1/-1">
            <label style="font-size:.55rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:rgba(232,220,200,.5);display:block;margin-bottom:.35rem">Biografía</label>
            <textarea id="field-bio" rows="3" placeholder="Cuéntanos sobre ti..." style="width:100%;padding:.7rem .8rem;border-radius:8px;border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.03);color:var(--color-theme-cream);font-size:.85rem;outline:none;transition:border-color .2s;box-sizing:border-box;resize:vertical;font-family:inherit"></textarea>
          </div>
        </div>

        <!-- Submit -->
        <div style="margin-top:2rem;display:flex;gap:1rem">
          <button id="btn-save" style="flex:1;padding:.85rem;border-radius:10px;font-family:'Cinzel',serif;font-size:.6rem;font-weight:800;letter-spacing:.2em;text-transform:uppercase;cursor:pointer;border:none;background:var(--color-theme-gold);color:var(--color-theme-midnight);transition:all .2s">GUARDAR PERFIL</button>
        </div>

        <div id="form-message" style="margin-top:1rem;font-size:.6rem;letter-spacing:.05em;text-align:center;min-height:1.2rem"></div>
      </div>

    </div>
  </main>
</Layout>

<style>
  @keyframes spin { to { transform: rotate(360deg) } }
  input:focus, select:focus, textarea:focus { border-color: var(--color-theme-gold) !important; }
  #btn-save:hover { filter: brightness(1.1); transform: translateY(-1px); }

  main{
    padding: 6rem 1.5rem 5rem !important;
  }
</style>

<script>
  const $ = id => document.getElementById(id)
  const loadingEl = $('player-loading')
  const formEl = $('player-form')
  const msgEl = $('form-message')
  const btnSave = $('btn-save')
  const subtitle = $('form-subtitle')

  let playerId = null

  async function loadProfile() {
    try {
      const res = await fetch('/api/players')
      const data = await res.json()
      loadingEl.style.display = 'none'
      if (data.success && data.player) {
        // Already has a profile — go to dashboard
        window.location.href = '/jugador/dashboard'
      } else {
        showForm()
      }
    } catch {
      loadingEl.style.display = 'none'
      showForm()
    }
  }

  function showForm(data) {
    formEl.style.display = 'block'

    if (data) {
      subtitle.textContent = 'Edita tu perfil de jugador'
      btnSave.textContent = 'GUARDAR CAMBIOS'
      $('field-name').value = data.name || ''
      $('field-realName').value = data.real_name || ''
      $('field-age').value = data.age || ''
      $('field-city').value = data.city || ''
      $('field-neighborhood').value = data.neighborhood || ''
      $('field-number').value = data.number || ''
      $('field-foot').value = data.preferred_foot || ''
      $('field-position').value = data.position || ''
      $('field-bio').value = data.bio || ''
      $('preview-big').src = data.image_big || '/images/fighters/big/jugador_mistery.webp'
      $('preview-card').src = data.image_card || '/images/fighters/cards/jugador_mistery_card.png'
    } else {
      subtitle.textContent = 'Crea tu perfil de jugador'
      btnSave.textContent = 'GUARDAR PERFIL'
    }
  }

  btnSave.addEventListener('click', async () => {
    const name = $('field-name').value.trim()
    if (!name) { msgEl.textContent = 'El nombre es obligatorio'; return }
    const position = $('field-position').value
    if (!position) { msgEl.textContent = 'Selecciona una posición'; return }

    btnSave.textContent = 'GUARDANDO...'
    btnSave.disabled = true
    msgEl.textContent = ''

    try {
      const res = await fetch('/api/players', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'save',
          id: playerId || undefined,
          name,
          realName: $('field-realName').value.trim() || null,
          age: $('field-age').value ? Number($('field-age').value) : null,
          city: $('field-city').value.trim() || null,
          neighborhood: $('field-neighborhood').value.trim() || null,
          number: $('field-number').value ? Number($('field-number').value) : null,
          preferredFoot: $('field-foot').value || null,
          position,
          bio: $('field-bio').value.trim() || null,
          imageBig: '/images/fighters/big/jugador_mistery.webp',
          imageCard: '/images/fighters/cards/jugador_mistery_card.png',
        }),
      })
      const data = await res.json()
      if (data.success) {
        window.location.href = '/jugador/dashboard'
      } else {
        msgEl.textContent = data.error || 'Error al guardar'
        msgEl.style.color = '#f87171'
      }
    } catch {
      msgEl.textContent = 'Error de red'
      msgEl.style.color = '#f87171'
    } finally {
      btnSave.textContent = playerId ? 'GUARDAR CAMBIOS' : 'GUARDAR PERFIL'
      btnSave.disabled = false
    }
  })

  loadProfile()
</script>
