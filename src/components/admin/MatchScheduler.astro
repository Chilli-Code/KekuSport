---
import { getTeamsByTournament, getMatchesByTournament } from '../../../server/db'
import MatchRow from './MatchRow.astro'

export interface Props {
  tournamentId: string
  tournamentFormat: string
  tournamentVenue: string
}

const { tournamentId, tournamentFormat, tournamentVenue } = Astro.props
const teams = getTeamsByTournament(tournamentId)
const matches = getMatchesByTournament(tournamentId)
const totalRounds = matches.length > 0 ? Math.max(...matches.map(m => m.round)) : 0

// Group matches by date for calendar view
const dateGroups = new Map<string, typeof matches>()
for (const m of matches) {
  const key = m.scheduled_date ? m.scheduled_date.slice(0, 10) : '__unscheduled__'
  if (!dateGroups.has(key)) dateGroups.set(key, [])
  dateGroups.get(key)!.push(m)
}
const sortedDates = Array.from(dateGroups.keys()).sort((a, b) => {
  if (a === '__unscheduled__') return 1
  if (b === '__unscheduled__') return -1
  return a.localeCompare(b)
})
---

<div class="ms" data-tournament-id={tournamentId} data-format={tournamentFormat} data-venue={tournamentVenue}>
  <!-- Toolbar -->
  <div class="ms-toolbar">
    <div class="ms-toolbar-left">
      <span class="ms-count">{matches.length} partido{matches.length !== 1 ? 's' : ''}</span>
      {totalRounds > 0 && <span class="ms-count-sep">·</span>}
      {totalRounds > 0 && <span class="ms-count">{totalRounds} ronda{totalRounds !== 1 ? 's' : ''}</span>}
      <span class="ms-count-sep">·</span>
      <span class="ms-count">{teams.length} equipo{teams.length !== 1 ? 's' : ''}</span>
    </div>
    <div class="ms-view-toggle">
      <button class="ms-view-btn ms-view-btn--active" data-view="rounds">Rondas</button>
      <button class="ms-view-btn" data-view="calendar">Calendario</button>
    </div>
    <div class="ms-toolbar-right">
      <button class="ms-btn ms-btn--ghost" id="ms-btn-add">➕ Añadir</button>
      <button class="ms-btn ms-btn--green" id="ms-btn-generate">⚡ Generar Fixture</button>
    </div>
  </div>

  <!-- Rounds -->
  {matches.length === 0 ? (
    <div class="ms-empty">
      <span class="ms-empty-icon">🎲</span>
      <p class="ms-empty-text">No hay partidos aún. Genera un fixture automático o añádelos manualmente.</p>
      <div class="ms-empty-actions">
        <button class="ms-btn ms-btn--green" id="ms-btn-generate-empty">⚡ Generar Fixture</button>
        <button class="ms-btn ms-btn--ghost" id="ms-btn-add-empty">➕ Añadir manual</button>
      </div>
    </div>
  ) : (
    <>
    <!-- ── Rounds view ── -->
    <div class="ms-rounds" data-view-content="rounds">
      {Array.from({ length: totalRounds }, (_, i) => i + 1).map(round => {
        const roundMatches = matches.filter(m => m.round === round)
        return (
          <div class="ms-round">
            <div class="ms-round-header">
              <span class="ms-round-title">Ronda {round}</span>
              <span class="ms-round-count">{roundMatches.length} partido{roundMatches.length !== 1 ? 's' : ''}</span>
            </div>
            <div class="ms-match-list">
              {roundMatches.map(m => {
                const home = teams.find(t => t.id === m.home_team_id)
                const away = teams.find(t => t.id === m.away_team_id)
                const statusClass = `ms-status ms-status--${m.status}`
                return (
                  <MatchRow match={m} home={home} away={away} statusClass={statusClass} />
                )
              })}
            </div>
          </div>
        )
      })}
    </div>

    <!-- ── Calendar view ── -->
    <div class="ms-calendar ms-calendar--hidden" data-view-content="calendar">
      {sortedDates.map(dateKey => {
        const dayMatches = dateGroups.get(dateKey)!
        const isUnscheduled = dateKey === '__unscheduled__'
        return (
          <div class="ms-cal-day">
            <div class="ms-cal-day-header">
              {isUnscheduled ? (
                <span class="ms-cal-day-title">Sin fecha asignada</span>
              ) : (
                <>
                  <span class="ms-cal-day-title">{new Date(dateKey + 'T12:00').toLocaleDateString('es-CO', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}</span>
                  <span class="ms-cal-day-dow">{new Date(dateKey + 'T12:00').toLocaleDateString('es-CO', { weekday: 'long' })}</span>
                </>
              )}
              <span class="ms-round-count">{dayMatches.length} partido{dayMatches.length !== 1 ? 's' : ''}</span>
            </div>
            <div class="ms-match-list">
              {dayMatches.map(m => {
                const home = teams.find(t => t.id === m.home_team_id)
                const away = teams.find(t => t.id === m.away_team_id)
                const statusClass = `ms-status ms-status--${m.status}`
                return (
                  <MatchRow match={m} home={home} away={away} statusClass={statusClass} showTime={!isUnscheduled} />
                )
              })}
            </div>
          </div>
        )
      })}
    </div>
    </>
  )}
</div>

<!-- ══ MODAL GENERAR ══ -->
<div class="ms-modal-overlay" id="ms-modal-overlay">
  <div class="ms-modal">
    <div class="ms-modal-header">
      <h3 class="ms-modal-title">Generar Fixture</h3>
      <button class="ms-modal-close" id="ms-modal-close">✕</button>
    </div>
    <div class="ms-modal-body">
      <div class="ms-field">
        <label class="ms-label">Modo</label>
        <select id="ms-mode" class="ms-input">
          <option value="auto">Automático (según formato del torneo)</option>
        </select>
      </div>
      <div class="ms-field">
        <label class="ms-label">Fecha del primer partido</label>
        <input type="date" id="ms-start-date" class="ms-input" />
      </div>
      <div class="ms-grid2">
        <div class="ms-field">
          <label class="ms-label">Días entre rondas</label>
          <input type="number" id="ms-days" value="7" min="1" class="ms-input" />
        </div>
        <div class="ms-field">
          <label class="ms-label">Hora</label>
          <input type="time" id="ms-time" value="20:00" class="ms-input" />
        </div>
      </div>
      <div class="ms-field">
        <label class="ms-checkbox">
          <input type="checkbox" id="ms-double-round" />
          <span>Doble vuelta (ida y vuelta)</span>
        </label>
      </div>
    </div>
    <div class="ms-modal-footer">
      <button class="ms-btn ms-btn--ghost" id="ms-modal-cancel">Cancelar</button>
      <button class="ms-btn ms-btn--green" id="ms-modal-confirm">Generar</button>
    </div>
  </div>
</div>

<!-- ══ MODAL AÑADIR ══ -->
<div class="ms-modal-overlay" id="ms-add-overlay">
  <div class="ms-modal">
    <div class="ms-modal-header">
      <h3 class="ms-modal-title">Añadir Partido</h3>
      <button class="ms-modal-close" id="ms-add-close">✕</button>
    </div>
    <div class="ms-modal-body">
      <div class="ms-grid2">
        <div class="ms-field">
          <label class="ms-label">Equipo local</label>
          <select id="ms-add-home" class="ms-input">
            <option value="">—</option>
            {teams.map(t => <option value={t.id}>{t.name}</option>)}
          </select>
        </div>
        <div class="ms-field">
          <label class="ms-label">Equipo visitante</label>
          <select id="ms-add-away" class="ms-input">
            <option value="">—</option>
            {teams.map(t => <option value={t.id}>{t.name}</option>)}
          </select>
        </div>
      </div>
      <div class="ms-field">
        <label class="ms-label">Ronda</label>
        <input type="number" id="ms-add-round" value="1" min="1" class="ms-input" />
      </div>
      <div class="ms-grid2">
        <div class="ms-field">
          <label class="ms-label">Fecha</label>
          <input type="date" id="ms-add-date" class="ms-input" />
        </div>
        <div class="ms-field">
          <label class="ms-label">Hora</label>
          <input type="time" id="ms-add-time" value="20:00" class="ms-input" />
        </div>
      </div>
    </div>
    <div class="ms-modal-footer">
      <button class="ms-btn ms-btn--ghost" id="ms-add-cancel">Cancelar</button>
      <button class="ms-btn ms-btn--green" id="ms-add-confirm">Añadir</button>
    </div>
  </div>
</div>

<!-- ══ MODAL EDITAR ══ -->
<div class="ms-modal-overlay" id="ms-edit-overlay">
  <div class="ms-modal">
    <div class="ms-modal-header">
      <h3 class="ms-modal-title">Editar Partido</h3>
      <button class="ms-modal-close" id="ms-edit-close">✕</button>
    </div>
    <div class="ms-modal-body">
      <input type="hidden" id="ms-edit-id" />
      <div class="ms-grid2">
        <div class="ms-field">
          <label class="ms-label">Equipo local</label>
          <select id="ms-edit-home" class="ms-input">
            <option value="">—</option>
            {teams.map(t => <option value={t.id}>{t.name}</option>)}
          </select>
        </div>
        <div class="ms-field">
          <label class="ms-label">Equipo visitante</label>
          <select id="ms-edit-away" class="ms-input">
            <option value="">—</option>
            {teams.map(t => <option value={t.id}>{t.name}</option>)}
          </select>
        </div>
      </div>
      <div class="ms-field">
        <label class="ms-label">Ronda</label>
        <input type="number" id="ms-edit-round" min="1" class="ms-input" />
      </div>
      <div class="ms-field">
        <label class="ms-label">Estado</label>
        <select id="ms-edit-status" class="ms-input">
          <option value="scheduled">Programado</option>
          <option value="live">En vivo</option>
          <option value="finished">Finalizado</option>
          <option value="cancelled">Cancelado</option>
        </select>
      </div>
      <div class="ms-grid2">
        <div class="ms-field">
          <label class="ms-label">Marcador local</label>
          <input type="number" id="ms-edit-home-score" min="0" class="ms-input" />
        </div>
        <div class="ms-field">
          <label class="ms-label">Marcador visitante</label>
          <input type="number" id="ms-edit-away-score" min="0" class="ms-input" />
        </div>
      </div>
      <div class="ms-grid2">
        <div class="ms-field">
          <label class="ms-label">Fecha</label>
          <input type="date" id="ms-edit-date" class="ms-input" />
        </div>
        <div class="ms-field">
          <label class="ms-label">Hora</label>
          <input type="time" id="ms-edit-time" class="ms-input" />
        </div>
      </div>
    </div>
    <div class="ms-modal-footer">
      <button class="ms-btn ms-btn--ghost" id="ms-edit-cancel">Cancelar</button>
      <button class="ms-btn ms-btn--green" id="ms-edit-confirm">Guardar</button>
    </div>
  </div>
</div>

<script>
  const tournamentId = document.querySelector<HTMLElement>('.ms')!.dataset.tournamentId

  // ── View toggle ──
  document.querySelectorAll<HTMLButtonElement>('.ms-view-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.ms-view-btn').forEach(b => b.classList.remove('ms-view-btn--active'))
      btn.classList.add('ms-view-btn--active')
      const view = btn.dataset.view
      document.querySelectorAll<HTMLElement>('[data-view-content]').forEach(el => {
        el.classList.toggle('ms-calendar--hidden', el.dataset.viewContent !== view)
      })
    })
  })

  function getTeamsMap(): Record<string, string> {
    const map: Record<string, string> = {}
    document.querySelectorAll<HTMLOptionElement>('#ms-add-home option, #ms-edit-home option').forEach(o => {
      if (o.value) map[o.value] = o.textContent || o.value
    })
    return map
  }

  function getTeamName(id: string): string {
    const opt = document.querySelector<HTMLOptionElement>(`#ms-add-home option[value="${id}"]`)
    return opt?.textContent || id
  }

  function reloadPage() {
    window.location.reload()
  }

  // ── Modal helpers ──
  function openModal(overlayId: string) {
    document.getElementById(overlayId)!.classList.add('ms-modal-overlay--open')
  }
  function closeAllModals() {
    document.querySelectorAll('.ms-modal-overlay').forEach(el => el.classList.remove('ms-modal-overlay--open'))
  }

  // ── Generate Modal ──
  const genOverlay = document.getElementById('ms-modal-overlay')!
  document.querySelectorAll('#ms-btn-generate, #ms-btn-generate-empty').forEach(btn => {
    btn.addEventListener('click', () => openModal('ms-modal-overlay'))
  })
  document.getElementById('ms-modal-close')?.addEventListener('click', closeAllModals)
  document.getElementById('ms-modal-cancel')?.addEventListener('click', closeAllModals)
  genOverlay.addEventListener('click', e => { if (e.target === genOverlay) closeAllModals() })

  document.getElementById('ms-modal-confirm')?.addEventListener('click', async () => {
    const startDate = (document.getElementById('ms-start-date') as HTMLInputElement).value
    const daysBetween = (document.getElementById('ms-days') as HTMLInputElement).value
    const matchTime = (document.getElementById('ms-time') as HTMLInputElement).value
    const doubleRound = (document.getElementById('ms-double-round') as HTMLInputElement).checked

    const btn = document.getElementById('ms-modal-confirm') as HTMLButtonElement
    btn.disabled = true
    btn.textContent = 'Generando...'

    try {
      const res = await fetch('/api/matches/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tournamentId, mode: 'auto', startDate, daysBetween, matchTime, doubleRound }),
      })
      if (!res.ok) throw new Error('Error al generar')
      closeAllModals()
      reloadPage()
    } catch {
      alert('Error al generar el fixture')
      btn.disabled = false
      btn.textContent = 'Generar'
    }
  })

  // ── Add Modal ──
  const addOverlay = document.getElementById('ms-add-overlay')!
  document.querySelectorAll('#ms-btn-add, #ms-btn-add-empty').forEach(btn => {
    btn.addEventListener('click', () => openModal('ms-add-overlay'))
  })
  document.getElementById('ms-add-close')?.addEventListener('click', closeAllModals)
  document.getElementById('ms-add-cancel')?.addEventListener('click', closeAllModals)
  addOverlay.addEventListener('click', e => { if (e.target === addOverlay) closeAllModals() })

  document.getElementById('ms-add-confirm')?.addEventListener('click', async () => {
    const homeTeamId = (document.getElementById('ms-add-home') as HTMLSelectElement).value
    const awayTeamId = (document.getElementById('ms-add-away') as HTMLSelectElement).value
    const round = (document.getElementById('ms-add-round') as HTMLInputElement).value
    const date = (document.getElementById('ms-add-date') as HTMLInputElement).value
    const time = (document.getElementById('ms-add-time') as HTMLInputElement).value

    if (!homeTeamId || !awayTeamId) {
      alert('Selecciona ambos equipos')
      return
    }
    if (homeTeamId === awayTeamId) {
      alert('Los equipos deben ser diferentes')
      return
    }

    const btn = document.getElementById('ms-add-confirm') as HTMLButtonElement
    btn.disabled = true
    btn.textContent = 'Añadiendo...'

    try {
      const scheduledDate = date ? `${date}T${time || '20:00'}:00` : null
      const res = await fetch('/api/matches/index', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'create',
          tournamentId,
          homeTeamId,
          awayTeamId,
          round: Number(round) || 1,
          scheduledDate,
          venue: document.querySelector<HTMLElement>('.ms')!.dataset.venue || null,
        }),
      })
      if (!res.ok) throw new Error('Error al crear')
      closeAllModals()
      reloadPage()
    } catch {
      alert('Error al crear el partido')
      btn.disabled = false
      btn.textContent = 'Añadir'
    }
  })

  // ── Edit Modal ──
  const editOverlay = document.getElementById('ms-edit-overlay')!
  document.getElementById('ms-edit-close')?.addEventListener('click', closeAllModals)
  document.getElementById('ms-edit-cancel')?.addEventListener('click', closeAllModals)
  editOverlay.addEventListener('click', e => { if (e.target === editOverlay) closeAllModals() })

  document.querySelectorAll<HTMLButtonElement>('[data-edit]').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.edit
      const row = btn.closest('.ms-match') as HTMLElement
      const teams = row.querySelectorAll('.ms-team')
      const dateEl = row.querySelector('.ms-date')
      const scoreEl = row.querySelector('.ms-score')
      const statusEl = row.querySelector('.ms-status')

      // Load current data into edit modal
      const teamNames = Array.from(teams).map(el => el.textContent || '')
      const teamsMap = getTeamsMap()
      const homeId = Object.keys(teamsMap).find(k => teamsMap[k] === teamNames[0]) || ''
      const awayId = Object.keys(teamsMap).find(k => teamsMap[k] === teamNames[2]) || ''

      ;(document.getElementById('ms-edit-id') as HTMLInputElement).value = id
      ;(document.getElementById('ms-edit-home') as HTMLSelectElement).value = homeId
      ;(document.getElementById('ms-edit-away') as HTMLSelectElement).value = awayId

      if (scoreEl) {
        const scores = scoreEl.textContent?.split('—').map(s => s.trim()) || []
        ;(document.getElementById('ms-edit-home-score') as HTMLInputElement).value = scores[0] || ''
        ;(document.getElementById('ms-edit-away-score') as HTMLInputElement).value = scores[1] || ''
      } else {
        ;(document.getElementById('ms-edit-home-score') as HTMLInputElement).value = ''
        ;(document.getElementById('ms-edit-away-score') as HTMLInputElement).value = ''
      }

      if (statusEl) {
        const status = statusEl.textContent?.trim() || 'scheduled'
        ;(document.getElementById('ms-edit-status') as HTMLSelectElement).value = status
      }

      openModal('ms-edit-overlay')
    })
  })

  document.getElementById('ms-edit-confirm')?.addEventListener('click', async () => {
    const id = (document.getElementById('ms-edit-id') as HTMLInputElement).value
    const homeTeamId = (document.getElementById('ms-edit-home') as HTMLSelectElement).value
    const awayTeamId = (document.getElementById('ms-edit-away') as HTMLSelectElement).value
    const round = (document.getElementById('ms-edit-round') as HTMLInputElement).value
    const status = (document.getElementById('ms-edit-status') as HTMLSelectElement).value
    const homeScore = (document.getElementById('ms-edit-home-score') as HTMLInputElement).value
    const awayScore = (document.getElementById('ms-edit-away-score') as HTMLInputElement).value
    const date = (document.getElementById('ms-edit-date') as HTMLInputElement).value
    const time = (document.getElementById('ms-edit-time') as HTMLInputElement).value

    const btn = document.getElementById('ms-edit-confirm') as HTMLButtonElement
    btn.disabled = true
    btn.textContent = 'Guardando...'

    try {
      const updates: Record<string, unknown> = { action: 'update', id }
      if (homeTeamId) updates.homeTeamId = homeTeamId
      if (awayTeamId) updates.awayTeamId = awayTeamId
      if (round) updates.round = Number(round)
      updates.status = status
      if (homeScore !== '') updates.homeScore = Number(homeScore)
      if (awayScore !== '') updates.awayScore = Number(awayScore)
      if (date) updates.scheduledDate = `${date}T${time || '20:00'}:00`

      const res = await fetch('/api/matches/index', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(updates),
      })
      if (!res.ok) throw new Error('Error al actualizar')
      closeAllModals()
      reloadPage()
    } catch {
      alert('Error al guardar')
      btn.disabled = false
      btn.textContent = 'Guardar'
    }
  })

  // ── Delete ──
  document.querySelectorAll<HTMLButtonElement>('[data-delete]').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!confirm('¿Eliminar este partido?')) return
      const id = btn.dataset.delete
      try {
        const res = await fetch('/api/matches/index', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'delete', id }),
        })
        if (!res.ok) throw new Error()
        reloadPage()
      } catch {
        alert('Error al eliminar')
      }
    })
  })
</script>

<style>
  .ms { display: flex; flex-direction: column; gap: 1rem; }

  .ms-toolbar {
    display: flex; align-items: center; justify-content: space-between;
    padding: .65rem 1rem;
    border-radius: 12px;
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .ms-toolbar-left { display: flex; align-items: center; gap: .35rem; }
  .ms-toolbar-right { display: flex; gap: .5rem; }

  .ms-view-toggle {
    display: flex; gap: 2px;
    background: rgba(255,255,255,.04);
    border-radius: 8px; padding: 2px;
    margin-left: 1rem;
  }
  .ms-view-btn {
    padding: .3rem .6rem; border-radius: 6px;
    border: none; background: none;
    font-family: var(--font-cinzel,'Cinzel'),serif;
    font-size: .42rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
    color: var(--text-3); cursor: pointer; transition: all .2s;
  }
  .ms-view-btn:hover { color: var(--text-2); }
  .ms-view-btn--active { background: var(--surface); color: var(--green); }
  .ms-count { font-size: .48rem; color: var(--text-3); }
  .ms-count-sep { font-size: .48rem; color: var(--border-2); }

  .ms-btn {
    display: inline-flex; align-items: center; gap: .3rem;
    padding: .45rem .85rem; border-radius: 8px;
    font-family: var(--font-cinzel,'Cinzel'),serif;
    font-size: .46rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
    cursor: pointer; border: 1px solid transparent; transition: all .2s;
  }
  .ms-btn--green {
    background: rgba(0,255,136,.1); color: var(--green);
    border-color: rgba(0,255,136,.3);
  }
  .ms-btn--green:hover { background: rgba(0,255,136,.18); }
  .ms-btn--ghost {
    background: transparent; color: var(--text-2);
    border-color: var(--border);
  }
  .ms-btn--ghost:hover { border-color: var(--border-2); color: var(--text); }

  .ms-empty {
    border-radius: 14px; border: 1px dashed var(--border);
    padding: 2.5rem; text-align: center;
    display: flex; flex-direction: column; align-items: center; gap: .5rem;
  }
  .ms-empty-icon { font-size: 2.5rem; }
  .ms-empty-text { font-size: .52rem; color: var(--text-3); max-width: 320px; }
  .ms-empty-actions { display: flex; gap: .5rem; margin-top: .5rem; }

  .ms-rounds { display: flex; flex-direction: column; gap: 1rem; }

  .ms-calendar { display: flex; flex-direction: column; gap: 1rem; }
  .ms-calendar--hidden { display: none; }
  .ms-cal-day {
    border-radius: 12px; border: 1px solid var(--border);
    background: var(--surface); overflow: hidden;
  }
  .ms-cal-day-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: .6rem .85rem;
    background: rgba(255,255,255,.03);
    border-bottom: 1px solid var(--border);
  }
  .ms-cal-day-title {
    font-family: var(--font-cinzel,'Cinzel'),serif;
    font-size: .55rem; font-weight: 800; letter-spacing: .05em;
    color: rgba(232,226,216,.7); text-transform: capitalize;
  }
  .ms-cal-day-dow { display: none; }

  .ms-round {
    border-radius: 12px; border: 1px solid var(--border);
    background: var(--surface); overflow: hidden;
