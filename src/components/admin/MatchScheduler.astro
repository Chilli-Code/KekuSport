---
import { getTeamsByTournament, getMatchesByTournament } from '../../../server/db'
import MatchRow from './MatchRow.astro'

export interface Props {
  tournamentId: string
  tournamentFormat: string
  tournamentVenue: string
  tournamentTwoLegged: boolean
}

const { tournamentId, tournamentFormat, tournamentVenue, tournamentTwoLegged } = Astro.props
const teams = await getTeamsByTournament(tournamentId)
const matches = await getMatchesByTournament(tournamentId)

function getGroupKey(label: string | null): string {
  if (!label) return 'General'
  const m = label.match(/^(Grupo\s[^-]+)/)
  return m ? m[1].trim() : 'General'
}

const groupKeys = [...new Set(matches.map(m => getGroupKey(m.round_label)))]
const matchesByGroup = new Map<string, typeof matches>()
for (const gk of groupKeys) {
  matchesByGroup.set(gk, matches.filter(m => getGroupKey(m.round_label) === gk))
}

// Extract team IDs per group from match labels
const groupTeams = new Map<string, string[]>()
for (const m of matches) {
  if (!m.round_label) continue
  const gk = getGroupKey(m.round_label)
  if (gk === 'General') continue
  if (!groupTeams.has(gk)) groupTeams.set(gk, [])
  const ids = groupTeams.get(gk)!
  if (m.home_team_id && !ids.includes(m.home_team_id)) ids.push(m.home_team_id)
  if (m.away_team_id && !ids.includes(m.away_team_id)) ids.push(m.away_team_id)
}
for (const [, ids] of groupTeams) {
  ids.sort((a, b) => {
    const ta = teams.find(t => t.id === a)
    const tb = teams.find(t => t.id === b)
    const oa = ta?.group_sort_order ?? 0
    const ob = tb?.group_sort_order ?? 0
    if (oa !== ob) return oa - ob
    return (ta?.name || '').localeCompare(tb?.name || '')
  })
}

const filterGroupOptions = groupKeys
const filterLegOptions = ['ida']
if (tournamentTwoLegged) filterLegOptions.push('vuelta')
let maxJornada = 0
for (const gk of groupKeys) {
  const gm = matchesByGroup.get(gk)!
  if (gm.length === 0) continue
  const mn = Math.min(...gm.map(m => m.round))
  const mx = Math.max(...gm.map(m => m.round))
  const total = mx - mn + 1
  const jc = tournamentTwoLegged ? Math.ceil(total / 2) : total
  if (jc > maxJornada) maxJornada = jc
}
const filterJornadaOptions = Array.from({ length: maxJornada }, (_, i) => i + 1)
const groupsLocked = matches.some(m => m.home_score !== null || m.away_score !== null)

---

<div class="ms" data-tournament-id={tournamentId} data-format={tournamentFormat} data-venue={tournamentVenue}>
  <!-- Toolbar -->
  <div class="ms-toolbar">
    <div class="ms-toolbar-left">
      <span class="ms-count">{matches.length} partido{matches.length !== 1 ? 's' : ''}</span>
      <span class="ms-count-sep">·</span>
      <span class="ms-count">{teams.length} equipo{teams.length !== 1 ? 's' : ''}</span>
      <span class="ms-count-sep">·</span>
      <span class="ms-count">{groupKeys.length} grupo{groupKeys.length !== 1 ? 's' : ''}</span>
    </div>
    <div class="ms-toolbar-right">
      <button class="ms-btn ms-btn--green" id="ms-btn-generate">⚡ Generar Fixture</button>
    </div>
  </div>

  {matches.length === 0 ? (
    <div class="ms-empty">
      <span class="ms-empty-icon">🎲</span>
      <p class="ms-empty-text">No hay partidos aún. Genera el sorteo automático o añádelos manualmente.</p>
      <div class="ms-empty-actions">
        <button class="ms-btn ms-btn--green" id="ms-btn-generate-empty">⚡ Generar Fixture</button>
      </div>
    </div>
  ) : (
    <div class="ms-body">


      <section class="ms-section">
        <h2 class="ms-section-title">📋 GRUPOS</h2>
        <div class="ms-groups-grid">
          {groupKeys.map(gk => {
            const groupTeamIds = groupTeams.get(gk) || []
            return (
              <div class="ms-group-card" data-group={gk}>
                <h3 class="ms-group-card-title">{gk}</h3>
                <div class="ms-group-table">
                  {groupTeamIds.map((tid, i) => {
                    const t = teams.find(tt => tt.id === tid)
                    if (!t) return null
                    return (
                      <div class="ms-group-row" data-search={t.name.toLowerCase()} data-team-id={t.id}>
                        <span class={`ms-gpos ${i === 0 ? 'ms-gpos--gold' : ''}`}>{i + 1}</span>
                        <div class="ms-gavatar">
                          <img src={t.logo || '/images/Logo_Default.webp'} alt={t.name} loading="lazy" />
                        </div>
                        <span class="ms-gname">{t.name}</span>
                        <span class="mg-gpts">0</span>
                        {!groupsLocked && tournamentFormat === 'grupos' && (
                          <>
                            <button class="ms-order-btn ms-order-up" title="Subir posición">▲</button>
                            <button class="ms-order-btn ms-order-down" title="Bajar posición">▼</button>
                            <button class="ms-move-btn" data-team-id={t.id} data-team-name={t.name} title="Mover de grupo">↔</button>
                          </>
                        )}
                      </div>
                    )
                  })}
                </div>
              </div>
            )
          })}
        </div>
      </section>

      <div class="ms-filter-bar" id="ms-filter-bar">
        <div class="ms-filter-group">
          <span class="ms-filter-label">Grupo</span>
          <div class="ms-filter-pills">
            <button class="ms-filter-pill ms-filter-pill--active" data-filter="group" data-value="all" aria-pressed="true">Todos</button>
            {filterGroupOptions.map(g => (
              <button class="ms-filter-pill" data-filter="group" data-value={g} aria-pressed="false">{g}</button>
            ))}
          </div>
        </div>
        <div class="ms-filter-group">
          <span class="ms-filter-label">Leg</span>
          <div class="ms-filter-pills">
            <button class="ms-filter-pill ms-filter-pill--active" data-filter="leg" data-value="all" aria-pressed="true">Todos</button>
            {filterLegOptions.map(l => (
              <button class="ms-filter-pill" data-filter="leg" data-value={l} aria-pressed="false">{l === 'ida' ? 'Ida' : 'Vuelta'}</button>
            ))}
          </div>
        </div>
        <div class="ms-filter-group">
          <span class="ms-filter-label">Jornada</span>
          <div class="ms-filter-pills">
            <button class="ms-filter-pill ms-filter-pill--active" data-filter="jornada" data-value="all" aria-pressed="true">Todos</button>
            {filterJornadaOptions.map(j => (
              <button class="ms-filter-pill" data-filter="jornada" data-value={String(j)} aria-pressed="false">{j}</button>
            ))}
          </div>
        </div>
        <div class="ms-filter-group ms-filter-search">
          <span class="ms-filter-label">🔍</span>
          <input type="text" class="ms-search-input" id="ms-team-search" placeholder="Equipo..." autocomplete="off" />
        </div>
      </div>



      <section class="ms-section">
        <h2 class="ms-section-title">⚔️ JORNADAS</h2>
        {groupKeys.map(gk => {
          const gMatches = matchesByGroup.get(gk)!
          const gMaxRound = gMatches.length > 0 ? Math.max(...gMatches.map(m => m.round)) : 0
          const gMinRound = gMatches.length > 0 ? Math.min(...gMatches.map(m => m.round)) : 0
          return (
            <div class="ms-group-jornadas">
              <h3 class="ms-group-jornadas-title">{gk}</h3>
              <div class="ms-jornadas-list">
                {Array.from({ length: gMaxRound - gMinRound + 1 }, (_, i) => {
                  const round = gMinRound + i
                  const roundMatches = gMatches.filter(m => m.round === round)
                  if (roundMatches.length === 0) return null
                  const totalInGroup = gMaxRound - gMinRound + 1
                  const midpoint = Math.floor(totalInGroup / 2)
                  const isVuelta = tournamentTwoLegged && i >= midpoint
                  const legLabel = isVuelta ? 'Vuelta' : 'Ida'
                  const jornadaNum = isVuelta ? i - midpoint + 1 : i + 1
                  const searchTeams = roundMatches.map(m => {
                    const h = teams.find(t => t.id === m.home_team_id)
                    const a = teams.find(t => t.id === m.away_team_id)
                    return [h?.name, a?.name].filter(Boolean).join(' ')
                  }).join(' ').toLowerCase()
                  return (
                    <div class="ms-jornada" data-group={gk} data-leg={isVuelta ? 'vuelta' : 'ida'} data-jornada={jornadaNum} data-search={searchTeams}>
                      <div class="ms-jornada-header">
                        <h4 class="ms-jornada-title">
                          {tournamentTwoLegged ? `${legLabel} - Jornada ${jornadaNum}` : `Jornada ${jornadaNum}`}
                        </h4>
                        <span class="ms-jornada-count">{roundMatches.length} partido{roundMatches.length !== 1 ? 's' : ''}</span>
                      </div>
                      <div class="ms-match-grid">
                        {roundMatches.map(m => {
                          const home = teams.find(t => t.id === m.home_team_id)
                          const away = teams.find(t => t.id === m.away_team_id)
                          const statusClass = `ms-status ms-status--${m.status}`
                          const matchSearch = [home?.name, away?.name].filter(Boolean).join(' ').toLowerCase()
                          return (
                            <div class="ms-match-item" data-search={matchSearch}>
                              <MatchRow match={m} home={home} away={away} statusClass={statusClass} showTime={true} />
                            </div>
                          )
                        })}
                      </div>
                    </div>
                  )
                })}
              </div>
            </div>
          )
        })}
      </section>

    </div>
  )}
</div>

<!-- ══ MODAL GENERAR ══ -->
<div class="ms-modal-overlay" id="ms-modal-overlay">
  <div class="ms-modal">
    <div class="ms-modal-header">
      <h3 class="ms-modal-title">Generar Fixture</h3>
      <button class="ms-modal-close" id="ms-modal-close">✕</button>
    </div>
    <div class="ms-modal-body">
      <p style="font-size:.5rem;color:color-mix(in srgb, var(--color-theme-cream) 50%, transparent);text-align:center">
        Se generarán los duelos automáticamente según el formato del torneo
        {tournamentTwoLegged ? 'con ida y vuelta' : ''}.
      </p>
    </div>
    <div class="ms-modal-footer">
      <button class="ms-btn ms-btn--ghost" id="ms-modal-cancel">Cancelar</button>
      <button class="ms-btn ms-btn--green" id="ms-modal-confirm">Generar</button>
    </div>
  </div>
</div>

<!-- ══ MODAL EDITAR ══ -->
<div class="ms-modal-overlay" id="ms-edit-overlay">
  <div class="ms-modal">
    <div class="ms-modal-header">
      <h3 class="ms-modal-title">Editar Partido</h3>
      <button class="ms-modal-close" id="ms-edit-close">✕</button>
    </div>
    <div class="ms-modal-body">
      <input type="hidden" id="ms-edit-id" />
      <div class="ms-grid2">
        <div class="ms-field">
          <label class="ms-label">Equipo local</label>
          <select id="ms-edit-home" class="ms-input">
            <option value="">—</option>
            {teams.map(t => <option value={t.id}>{t.name}</option>)}
          </select>
        </div>
        <div class="ms-field">
          <label class="ms-label">Equipo visitante</label>
          <select id="ms-edit-away" class="ms-input">
            <option value="">—</option>
            {teams.map(t => <option value={t.id}>{t.name}</option>)}
          </select>
        </div>
      </div>
      <div class="ms-field">
        <label class="ms-label">Estado</label>
        <select id="ms-edit-status" class="ms-input">
          <option value="scheduled">Programado</option>
          <option value="live">En vivo</option>
          <option value="finished">Finalizado</option>
          <option value="cancelled">Cancelado</option>
        </select>
      </div>
      {tournamentTwoLegged && (
        <div class="ms-grid2 ms-score-readonly">
          <div class="ms-field">
            <label class="ms-label">Marcador local</label>
            <span class="ms-score-display" id="ms-edit-home-score-display">—</span>
          </div>
          <div class="ms-field">
            <label class="ms-label">Marcador visitante</label>
            <span class="ms-score-display" id="ms-edit-away-score-display">—</span>
          </div>
        </div>
      )}
      <div class="ms-grid2">
        <div class="ms-field">
          <label class="ms-label">Fecha</label>
          <input type="date" id="ms-edit-date" class="ms-input" />
        </div>
        <div class="ms-field">
          <label class="ms-label">Hora</label>
          <input type="time" id="ms-edit-time" class="ms-input" />
        </div>
      </div>
    </div>
    <div class="ms-modal-footer">
      <button class="ms-btn ms-btn--ghost" id="ms-edit-cancel">Cancelar</button>
      <button class="ms-btn ms-btn--green" id="ms-edit-confirm">Guardar</button>
    </div>
  </div>
</div>

<!-- ══ MODAL MOVER EQUIPO ══ -->
<div class="ms-modal-overlay" id="ms-move-overlay">
  <div class="ms-modal">
    <div class="ms-modal-header">
      <h3 class="ms-modal-title">Mover Equipo</h3>
      <button class="ms-modal-close" id="ms-move-close">✕</button>
    </div>
    <div class="ms-modal-body">
      <p style="font-size:.52rem;color:var(--color-theme-cream);margin-bottom:.5rem">
        Mover <strong id="ms-move-team-name"></strong> a:
      </p>
      <select id="ms-move-target" class="ms-input"></select>
    </div>
    <div class="ms-modal-footer">
      <button class="ms-btn ms-btn--ghost" id="ms-move-cancel">Cancelar</button>
      <button class="ms-btn ms-btn--green" id="ms-move-confirm">Mover</button>
    </div>
  </div>
</div>

<script>
  const tournamentId = document.querySelector<HTMLElement>('.ms')!.dataset.tournamentId

  function getTeamsMap(): Record<string, string> {
    const map: Record<string, string> = {}
    document.querySelectorAll<HTMLOptionElement>('#ms-edit-home option').forEach(o => {
      if (o.value) map[o.value] = o.textContent || o.value
    })
    return map
  }

  function reloadPage() {
    window.location.reload()
  }

  function openModal(overlayId: string) {
    document.getElementById(overlayId)!.classList.add('ms-modal-overlay--open')
  }
  function closeAllModals() {
    document.querySelectorAll('.ms-modal-overlay').forEach(el => el.classList.remove('ms-modal-overlay--open'))
  }

  // ── Generate Modal ──
  const genOverlay = document.getElementById('ms-modal-overlay')!
  document.querySelectorAll('#ms-btn-generate, #ms-btn-generate-empty').forEach(btn => {
    btn.addEventListener('click', () => openModal('ms-modal-overlay'))
  })
  document.getElementById('ms-modal-close')?.addEventListener('click', closeAllModals)
  document.getElementById('ms-modal-cancel')?.addEventListener('click', closeAllModals)
  genOverlay.addEventListener('click', e => { if (e.target === genOverlay) closeAllModals() })

  document.getElementById('ms-modal-confirm')?.addEventListener('click', async () => {
    const btn = document.getElementById('ms-modal-confirm') as HTMLButtonElement
    btn.disabled = true
    btn.textContent = 'Generando...'

    try {
      const res = await fetch('/api/matches/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tournamentId }),
      })
      if (!res.ok) {
        const data = await res.json()
        throw new Error(data.error || 'Error al generar')
      }
      closeAllModals()
      reloadPage()
    } catch (e) {
      alert(e instanceof Error ? e.message : 'Error al generar el fixture')
      btn.disabled = false
      btn.textContent = 'Generar'
    }
  })

  // ── Edit Modal ──
  const editOverlay = document.getElementById('ms-edit-overlay')!
  document.getElementById('ms-edit-close')?.addEventListener('click', closeAllModals)
  document.getElementById('ms-edit-cancel')?.addEventListener('click', closeAllModals)
  editOverlay.addEventListener('click', e => { if (e.target === editOverlay) closeAllModals() })

  document.querySelectorAll<HTMLButtonElement>('[data-edit]').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.edit
      const row = btn.closest('.duel-card') as HTMLElement
      const nameEls = row?.querySelectorAll('.duel-name')
      const scoreEl = row?.querySelector('.duel-meta-item')
      const statusEl = row?.querySelector('.ms-status')

      const teamsMap = getTeamsMap()
      const teamNames = Array.from(nameEls || []).map(el => el.textContent || '')
      const homeId = Object.keys(teamsMap).find(k => teamsMap[k] === teamNames[0]) || ''
      const awayId = Object.keys(teamsMap).find(k => teamsMap[k] === teamNames[1]) || ''

      ;(document.getElementById('ms-edit-id') as HTMLInputElement).value = id || ''
      ;(document.getElementById('ms-edit-home') as HTMLSelectElement).value = homeId
      ;(document.getElementById('ms-edit-away') as HTMLSelectElement).value = awayId

      const homeDisplay = document.getElementById('ms-edit-home-score-display')
      const awayDisplay = document.getElementById('ms-edit-away-score-display')
      if (homeDisplay && awayDisplay && scoreEl) {
        const scores = scoreEl.textContent?.split('—').map(s => s.trim()) || []
        homeDisplay.textContent = scores[0] || '—'
        awayDisplay.textContent = scores[1] || '—'
      }

      if (statusEl) {
        const status = statusEl.textContent?.trim().toLowerCase() || 'scheduled'
        ;(document.getElementById('ms-edit-status') as HTMLSelectElement).value = status
      }

      openModal('ms-edit-overlay')
    })
  })

  document.getElementById('ms-edit-confirm')?.addEventListener('click', async () => {
    const id = (document.getElementById('ms-edit-id') as HTMLInputElement).value
    const homeTeamId = (document.getElementById('ms-edit-home') as HTMLSelectElement).value
    const awayTeamId = (document.getElementById('ms-edit-away') as HTMLSelectElement).value
    const status = (document.getElementById('ms-edit-status') as HTMLSelectElement).value
    const date = (document.getElementById('ms-edit-date') as HTMLInputElement).value
    const time = (document.getElementById('ms-edit-time') as HTMLInputElement).value

    const btn = document.getElementById('ms-edit-confirm') as HTMLButtonElement
    btn.disabled = true
    btn.textContent = 'Guardando...'

    try {
      const updates: Record<string, unknown> = { action: 'update', id }
      if (homeTeamId) updates.homeTeamId = homeTeamId
      if (awayTeamId) updates.awayTeamId = awayTeamId
      updates.status = status
      if (date) updates.scheduledDate = `${date}T${time || '20:00'}:00`

      const res = await fetch('/api/matches', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(updates),
      })
      if (!res.ok) throw new Error('Error al actualizar')
      closeAllModals()
      reloadPage()
    } catch {
      alert('Error al guardar')
      btn.disabled = false
      btn.textContent = 'Guardar'
    }
  })

  // ── Delete ──
  document.querySelectorAll<HTMLButtonElement>('[data-delete]').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!confirm('¿Eliminar este partido?')) return
      const id = btn.dataset.delete
      try {
        const res = await fetch('/api/matches', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'delete', id }),
        })
        if (!res.ok) throw new Error()
        reloadPage()
      } catch {
        alert('Error al eliminar')
      }
    })
  })

  // ── Reorder & Move Team ──
  function readGroupsFromDOM(): Record<string, string[]> {
    const groups: Record<string, string[]> = {}
    document.querySelectorAll<HTMLElement>('.ms-group-card').forEach(card => {
      const title = card.querySelector('.ms-group-card-title')?.textContent?.trim() || ''
      const teamIds = Array.from(card.querySelectorAll<HTMLElement>('.ms-group-row'))
        .map(row => row.dataset.teamId)
        .filter((id): id is string => !!id)
      groups[title] = teamIds
    })
    return groups
  }

  function updatePosNumbers() {
    document.querySelectorAll<HTMLElement>('.ms-group-card').forEach(card => {
      card.querySelectorAll<HTMLElement>('.ms-group-row').forEach((row, i) => {
        const posEl = row.querySelector<HTMLElement>('.ms-gpos')
        if (posEl) {
          posEl.textContent = String(i + 1)
          posEl.classList.toggle('ms-gpos--gold', i === 0)
        }
      })
    })
  }

  async function saveGroups(groups: Record<string, string[]>): Promise<void> {
    const res = await fetch('/api/matches/update-groups', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ tournamentId, groups }),
    })
    if (!res.ok) {
      const data = await res.json()
      throw new Error(data.error || 'Error al guardar grupos')
    }
  }

  // ── Intra-group reorder (up/down) ──
  document.querySelectorAll<HTMLButtonElement>('.ms-order-up').forEach(btn => {
    btn.addEventListener('click', async () => {
      const row = btn.closest<HTMLElement>('.ms-group-row')
      const prev = row?.previousElementSibling as HTMLElement | null
      if (!row || !prev) return
      row.parentNode?.insertBefore(row, prev)
      updatePosNumbers()
      try {
        await saveGroups(readGroupsFromDOM())
      } catch (e) {
        alert(e instanceof Error ? e.message : 'Error al reordenar')
        reloadPage()
      }
    })
  })

  document.querySelectorAll<HTMLButtonElement>('.ms-order-down').forEach(btn => {
    btn.addEventListener('click', async () => {
      const row = btn.closest<HTMLElement>('.ms-group-row')
      const next = row?.nextElementSibling as HTMLElement | null
      if (!row || !next) return
      row.parentNode?.insertBefore(next, row)
      updatePosNumbers()
      try {
        await saveGroups(readGroupsFromDOM())
      } catch (e) {
        alert(e instanceof Error ? e.message : 'Error al reordenar')
        reloadPage()
      }
    })
  })

  // ── Move between groups modal ──
  const moveOverlay = document.getElementById('ms-move-overlay')!
  document.getElementById('ms-move-close')?.addEventListener('click', closeAllModals)
  document.getElementById('ms-move-cancel')?.addEventListener('click', closeAllModals)
  moveOverlay.addEventListener('click', e => { if (e.target === moveOverlay) closeAllModals() })

  document.querySelectorAll<HTMLButtonElement>('.ms-move-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const teamId = btn.dataset.teamId!
      const teamName = btn.dataset.teamName!
      const card = btn.closest('.ms-group-card')
      const currentGroup = card?.querySelector('.ms-group-card-title')?.textContent?.trim() || ''

      const select = document.getElementById('ms-move-target') as HTMLSelectElement
      select.innerHTML = ''
      document.querySelectorAll<HTMLElement>('.ms-group-card').forEach(c => {
        const title = c.querySelector('.ms-group-card-title')?.textContent?.trim() || ''
        if (title !== currentGroup) {
          const opt = document.createElement('option')
          opt.value = title
          opt.textContent = title
          select.appendChild(opt)
        }
      })

      select.dataset.teamId = teamId
      select.dataset.currentGroup = currentGroup
      document.getElementById('ms-move-team-name')!.textContent = teamName

      openModal('ms-move-overlay')
    })
  })

  document.getElementById('ms-move-confirm')?.addEventListener('click', async () => {
    const select = document.getElementById('ms-move-target') as HTMLSelectElement
    const teamId = select.dataset.teamId
    const currentGroup = select.dataset.currentGroup
    const targetGroup = select.value

    if (!targetGroup) {
      alert('Seleccioná un grupo destino')
      return
    }

    const groups = readGroupsFromDOM()
    groups[targetGroup] = [...(groups[targetGroup] || []), teamId]
    groups[currentGroup] = (groups[currentGroup] || []).filter(id => id !== teamId)

    const btn = document.getElementById('ms-move-confirm') as HTMLButtonElement
    btn.disabled = true
    btn.textContent = 'Moviendo...'

    try {
      await saveGroups(groups)
      closeAllModals()
      reloadPage()
    } catch (e) {
      alert(e instanceof Error ? e.message : 'Error al mover equipo')
      btn.disabled = false
      btn.textContent = 'Mover'
    }
  })

  // ── Filter pills ──
  function updateFilterCounts() {
    const jornadas = document.querySelectorAll<HTMLElement>('.ms-jornada')
    const all = jornadas.length
    const groupCounts = new Map<string, number>()
    const legCounts = new Map<string, number>()
    const jornadaCounts = new Map<string, number>()
    jornadas.forEach(j => {
      const g = j.dataset.group || ''
      const l = j.dataset.leg || ''
      const jn = j.dataset.jornada || ''
      groupCounts.set(g, (groupCounts.get(g) || 0) + 1)
      legCounts.set(l, (legCounts.get(l) || 0) + 1)
      jornadaCounts.set(jn, (jornadaCounts.get(jn) || 0) + 1)
    })
    document.querySelectorAll<HTMLButtonElement>('.ms-filter-pill[data-filter="group"]').forEach(p => {
      const v = p.dataset.value
      const c = v === 'all' ? all : (groupCounts.get(v || '') || 0)
      let badge = p.querySelector('.ms-filter-count')
      if (c > 0) {
        if (!badge) { badge = document.createElement('span'); badge.className = 'ms-filter-count'; p.appendChild(badge) }
        badge.textContent = String(c)
      } else {
        if (badge) badge.remove()
      }
    })
    document.querySelectorAll<HTMLButtonElement>('.ms-filter-pill[data-filter="leg"]').forEach(p => {
      const v = p.dataset.value
      const c = v === 'all' ? all : (legCounts.get(v || '') || 0)
      let badge = p.querySelector('.ms-filter-count')
      if (c > 0) {
        if (!badge) { badge = document.createElement('span'); badge.className = 'ms-filter-count'; p.appendChild(badge) }
        badge.textContent = String(c)
      } else {
        if (badge) badge.remove()
      }
    })
    document.querySelectorAll<HTMLButtonElement>('.ms-filter-pill[data-filter="jornada"]').forEach(p => {
      const v = p.dataset.value
      const c = v === 'all' ? all : (jornadaCounts.get(v || '') || 0)
      let badge = p.querySelector('.ms-filter-count')
      if (c > 0) {
        if (!badge) { badge = document.createElement('span'); badge.className = 'ms-filter-count'; p.appendChild(badge) }
        badge.textContent = String(c)
      } else {
        if (badge) badge.remove()
      }
    })
  }

  function applyTeamSearch() {
    const input = document.getElementById('ms-team-search') as HTMLInputElement
    if (!input) return
    const q = input.value.trim().toLowerCase()
    const rows = document.querySelectorAll<HTMLElement>('.ms-group-row')
    rows.forEach(row => {
      const s = (row.dataset.search || '').toLowerCase()
      row.style.display = !q || s.includes(q) ? '' : 'none'
    })
    document.querySelectorAll<HTMLElement>('.ms-group-card').forEach(card => {
      const visible = Array.from(card.querySelectorAll<HTMLElement>('.ms-group-row')).some(r => r.style.display !== 'none')
      card.style.display = visible ? '' : 'none'
    })
  }

  function applyMatchSearch() {
    const q = (document.getElementById('ms-team-search') as HTMLInputElement)?.value.trim().toLowerCase() || ''
    document.querySelectorAll<HTMLElement>('.ms-match-item').forEach(item => {
      const s = (item.dataset.search || '').toLowerCase()
      item.style.display = !q || s.includes(q) ? '' : 'none'
    })
  }

  function hideEmptyJornadaBlocks() {
    document.querySelectorAll<HTMLElement>('.ms-jornada').forEach(j => {
      const visibleItems = Array.from(j.querySelectorAll<HTMLElement>('.ms-match-item')).some(item => item.style.display !== 'none')
      if (j.style.display !== 'none' && !visibleItems) j.style.display = 'none'
    })
    document.querySelectorAll<HTMLElement>('.ms-group-jornadas').forEach(gj => {
      const visible = Array.from(gj.querySelectorAll<HTMLElement>('.ms-jornada')).some(j => j.style.display !== 'none')
      gj.style.display = visible ? '' : 'none'
    })
  }

  function applyFilters() {
    const activeGroup = document.querySelector<HTMLButtonElement>('.ms-filter-pill--active[data-filter="group"]')?.dataset.value || 'all'
    const activeLeg = document.querySelector<HTMLButtonElement>('.ms-filter-pill--active[data-filter="leg"]')?.dataset.value || 'all'
    const activeJornada = document.querySelector<HTMLButtonElement>('.ms-filter-pill--active[data-filter="jornada"]')?.dataset.value || 'all'

    document.querySelectorAll<HTMLElement>('.ms-jornada').forEach(j => {
      const mg = activeGroup === 'all' || j.dataset.group === activeGroup
      const ml = activeLeg === 'all' || j.dataset.leg === activeLeg
      const mj = activeJornada === 'all' || j.dataset.jornada === activeJornada
      j.style.display = (mg && ml && mj) ? '' : 'none'
    })

    applyMatchSearch()
    hideEmptyJornadaBlocks()
  }

  function onSearchInput() {
    applyTeamSearch()
    applyFilters()
  }

  document.querySelectorAll<HTMLButtonElement>('.ms-filter-pill').forEach(pill => {
    pill.addEventListener('click', () => {
      const group = pill.closest('.ms-filter-group')
      if (!group) return
      group.querySelectorAll<HTMLButtonElement>('.ms-filter-pill').forEach(p => {
        p.classList.remove('ms-filter-pill--active')
        p.setAttribute('aria-pressed', 'false')
      })
      pill.classList.add('ms-filter-pill--active')
      pill.setAttribute('aria-pressed', 'true')
      applyFilters()
    })
  })

  document.getElementById('ms-team-search')?.addEventListener('input', onSearchInput)

  updateFilterCounts()
</script>

