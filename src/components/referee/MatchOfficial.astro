---


/**
 * MatchOfficial.astro
 * Panel árbitro / plantillero — diseño Copa Chontaduro
 * Misma lógica, nuevo look: fondo espacial, colores de la app, HUD corners, verde eléctrico.
 */
---



<div id="mo-app" class="mo-root">

  <!-- ════ FONDO ESPACIAL ════ -->
  <div class="mo-bg" aria-hidden="true">
    <div class="mo-bg-glow-top"></div>
    <div class="mo-bg-stars"></div>
    <div class="mo-bg-scanlines"></div>
    <div class="mo-field-arc"></div>
  </div>

  <!-- ════ VISTA: LISTA DE PARTIDOS ════ -->
  <div id="mo-view-list" class="mo-page">

    <header class="mo-topbar">
      <div class="flex items-center gap-3">
        <span class="mo-live-dot"></span>
        <div>
          <p class="mo-eyebrow">PANEL PLANTILLERO</p>
          <p class="mo-topbar-title">Mis Partidos</p>
        </div>
      </div>
      <div class="flex items-center gap-2 ml-auto">
        <button id="mo-logout-btn" class="mo-logout-btn" title="Cerrar sesión">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </button>
        <span class="mo-role-chip">Árbitro</span>
      </div>
    </header>

    <div id="mo-pending-section" class="hidden">
      <p class="mo-section-label mt-6 mb-3">Pendientes de aceptar</p>
      <div class="flex flex-col gap-4" id="mo-pending-container"></div>
    </div>

    <p class="mo-section-label mt-6 mb-3">Mis partidos</p>

    <div class="flex flex-col gap-6" id="mo-cards-container"></div>

</div>

<style>
  /* ════════════════════════════════
     TOKENS
  ════════════════════════════════ */
  #mo-app {
    --gold:     var(--color-theme-gold,    #c7a86b);
    --cream:    var(--color-theme-cream,   #e8dcc8);
    --midnight: var(--color-theme-midnight,#0a0e1a);
    --green:    #00ff88;
    --border:   rgba(199,168,107,.14);
    --surface:  rgba(255,255,255,.03);
  }
.mo-min-adj {
  width: 44px; height: 44px;
  border-radius: 12px;
  font-size: 1.2rem;
  font-weight: 900;
  border: 1px solid rgba(255,255,255,.12);
  background: rgba(255,255,255,.06);
  color: rgba(232,220,200,.6);
  cursor: pointer;
  transition: all .15s;
}
.mo-min-adj:hover {
  background: rgba(255,255,255,.12);
  color: var(--cream);
}
  /* ════════════════════════════════
     ROOT
  ════════════════════════════════ */
  .mo-root {
    position: relative;
    min-height: 100svh;
    background: radial-gradient(ellipse at 50% -10%,#0b2a1a 0%,#050d08 55%,#03080e 100%);
    overflow-x: hidden;
    padding: 6rem 1.5rem 5rem;
  }
  .mo-page {
    position: relative; z-index: 1;
    max-width: 500px; margin: 0 auto;
    padding: 1.25rem 1rem 2rem;
  }

  /* ════════════════════════════════
     FONDO
  ════════════════════════════════ */
  .mo-bg { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
  .mo-bg-glow-top {
    position: absolute; top: -15%; left: 50%; transform: translateX(-50%);
    width: 65%; height: 55%;
    background: radial-gradient(ellipse,rgba(0,255,136,.14) 0%,transparent 70%);
    filter: blur(70px);
    animation: glowPulse 6s ease-in-out infinite alternate;
  }
  @keyframes glowPulse { 0%{opacity:.35} 100%{opacity:.85} }

  .mo-bg-stars {
    position: absolute; inset: 0;
    background-image:
      radial-gradient(1.5px 1.5px at 8%  15%,#fff,transparent),
      radial-gradient(1px   1px   at 25% 60%,#aaffcc,transparent),
      radial-gradient(2px   2px   at 51% 10%,#a855f7,transparent),
      radial-gradient(1px   1px   at 70% 78%,#fff,transparent),
      radial-gradient(2px   2px   at 87% 35%,#00ff88,transparent),
      radial-gradient(1px   1px   at 17% 84%,#c084fc,transparent),
      radial-gradient(1.5px 1.5px at 61% 49%,#fff,transparent);
    background-size: 260px 260px; opacity:.35;
    animation: twinkle 7s ease-in-out infinite alternate;
  }
  @keyframes twinkle { 0%{opacity:.15} 100%{opacity:.5} }

  .mo-bg-scanlines {
    position: absolute; inset: 0;
    background: repeating-linear-gradient(
      0deg,transparent,transparent 3px,
      rgba(0,255,136,.007) 3px,rgba(0,255,136,.007) 4px
    );
  }
  .mo-field-arc {
    position: absolute; bottom: -6vw; left: 50%; transform: translateX(-50%);
    width: 60vw; height: 15vw;
    border-radius: 50% 50% 0 0/100% 100% 0 0;
    border: 1px solid rgba(0,255,136,.06);
  }

  /* ════════════════════════════════
     TOPBAR
  ════════════════════════════════ */
  .mo-topbar {
    display: flex; align-items: center; justify-content: space-between; gap: .75rem;
    padding: .85rem 1.1rem;
    background: rgba(0,0,0,.3);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(255,255,255,.07);
    border-radius: 16px; margin-bottom: .5rem;
  }
  .mo-eyebrow { font-size: .44rem; font-weight: 700; letter-spacing: .25em; text-transform: uppercase; color: rgba(0,255,136,.5); }
  .mo-topbar-title { font-size: .82rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; color: var(--cream); }
  .mo-live-dot {
    width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0;
    background: var(--green); box-shadow: 0 0 12px var(--green);
    animation: blink 1.2s ease-in-out infinite;
  }
  @keyframes liveBlink { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.3;transform:scale(.7)} }

  .mo-role-chip {
    display: flex; align-items: center; gap: .35rem;
    font-size: .5rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
    color: rgba(232,220,200,.5);
    border: 1px solid var(--border);
    border-radius: 99px; padding: .25rem .7rem;
    background: var(--surface);
    white-space: nowrap;
  }

  .mo-back-btn {
    display: flex; align-items: center; gap: .4rem;
    font-size: .55rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
    color: rgba(232,220,200,.4); background: none; border: none; cursor: pointer;
    transition: color .2s;
  }
  .mo-back-btn:hover { color: var(--green); }

  .mo-logout-btn {
    display: flex; align-items: center; justify-content: center;
    width: 30px; height: 30px; border-radius: 8px;
    color: rgba(239,68,68,.6);
    background: rgba(239,68,68,.08);
    border: 1px solid rgba(239,68,68,.15);
    cursor: pointer;
    transition: all .2s;
    flex-shrink: 0;
  }
  .mo-logout-btn:hover {
    background: rgba(239,68,68,.2);
    color: #ef4444;
    box-shadow: 0 0 12px rgba(239,68,68,.1);
  }

  /* ════════════════════════════════
     SECTION LABEL
  ════════════════════════════════ */
  .mo-section-label {
    display: block;
    font-size: .5rem; font-weight: 700; letter-spacing: .25em; text-transform: uppercase;
    color: rgba(0,255,136,.6);
    margin-bottom: .5rem;
  }

  /* ════════════════════════════════
     MATCH CARDS
  ════════════════════════════════ */
.mo-card {
  background: linear-gradient(160deg, 
    color-mix(in srgb, var(--midnight) 88%, var(--green)) 0%, 
    var(--midnight) 100%);
  border: 1px solid rgba(199, 168, 107, 0.12);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.mo-card:hover {
  border-color: rgba(199, 168, 107, 0.3);
}
  .mo-card-topline { position: absolute; top:0;left:0;right:0;height:2px; }
  .mo-card-glow {
    position: absolute; inset:0; pointer-events:none;
    background: radial-gradient(ellipse at 50% 0%,rgba(0,255,136,.06),transparent 55%);
    opacity:0; transition:opacity .25s;
  }
  .mo-card:hover .mo-card-glow { opacity:1; }

  /* Esquinas HUD en cards */
.hud-corner {
  position: absolute;
  width: 12px;
  height: 12px;
  border-style: solid;
  border-color: rgba(199, 168, 107, 0.25);
  pointer-events: none;
  z-index: 2;
  transition: all 0.3s ease;
}
  .hud-corner--tl{top:6px;left:6px;border-width:1.5px 0 0 1.5px}
  .hud-corner--tr{top:6px;right:6px;border-width:1.5px 1.5px 0 0}
  .hud-corner--bl{bottom:6px;left:6px;border-width:0 0 1.5px 1.5px}
  .hud-corner--br{bottom:6px;right:6px;border-width:0 1.5px 1.5px 0}
  .mo-card:hover .hud-corner {
  border-color: rgba(0, 255, 136, 0.5);
  width: 16px;
  height: 16px;
}

  /* Status chips */
  .mo-status-live     { background:rgba(6,78,59,.8);     color:#34d399; border:1px solid rgba(52,211,153,.3); }
  .mo-status-upcoming { background:rgba(39,39,42,.8);    color:#a1a1aa; border:1px solid rgba(161,161,170,.2); }
  .mo-status-finished { background:rgba(76,29,149,.8);   color:#c4b5fd; border:1px solid rgba(196,181,253,.3); }
</style>

<script>
(function () {

  let MATCHES = [];
  let PENDING_MATCHES = [];

  function mapAPIToCard(m) {
    const statusMap = { scheduled:'upcoming', live:'live', finished:'finished' };
    const d = m.scheduled_date ? new Date(m.scheduled_date) : null;
    const time = d ? d.toLocaleTimeString('es-CO',{hour:'2-digit',minute:'2-digit'}) : '—';
    const round = m.round_label || (m.round ? `Jornada ${m.round}` : 'Partido');
    return {
      id: m.id,
      round: `${m.tournament_name || ''} · ${round}`,
      status: statusMap[m.status] || 'upcoming',
      role: 'Árbitro',
      time,
      field: m.venue || 'Por definir',
      tournament_name: m.tournament_name,
      match_referee_id: m.match_referee_id,
      teamA: { name: m.home_team_name || '—', color: m.home_team_color || '#888', players: [] },
      teamB: { name: m.away_team_name || '—', color: m.away_team_color || '#888', players: [] },
    };
  }

  async function loadMatches() {
    try {
      const res = await fetch('/api/referee/matches');
      const data = await res.json();
      if (!data.success) return;
      const raw = data.matches;
      const pending = raw.filter(m => m.referee_status === 'pending');
      const accepted = raw.filter(m => m.referee_status !== 'pending');
      PENDING_MATCHES = pending.map(mapAPIToCard);
      MATCHES = accepted.map(mapAPIToCard);
    } catch {
      MATCHES = [];
      PENDING_MATCHES = [];
    }
    renderPendingSection();
    renderCards();
  }

  const STATUS_CFG = {
    live:     {label:'En juego',   cls:'mo-status-live'},
    upcoming: {label:'Próximo',    cls:'mo-status-upcoming'},
    finished: {label:'Finalizado', cls:'mo-status-finished'},
  };

  const scKey = id => 'velada_score_' + id;
  const loadScore = id => { try{return JSON.parse(localStorage.getItem(scKey(id)))||{a:0,b:0};}catch{return{a:0,b:0};} };

  const $=id=>document.getElementById(id);

  function renderCards(){
    const container = $('mo-cards-container');
    container.innerHTML = MATCHES.map(m => {
      const score = loadScore(m.id);
      const showSc = m.status !== 'upcoming';
      const st = STATUS_CFG[m.status];
      return `
        <div class="mo-card group relative overflow-hidden rounded-xl border border-theme-gold/20 bg-theme-midnight/70 backdrop-blur-xs p-5 cursor-pointer hover:scale-[1.01] hover:shadow-2xl transition-all duration-500">
          <span class="hud-corner hud-corner--tl"></span>
          <span class="hud-corner hud-corner--tr"></span>
          <span class="hud-corner hud-corner--bl"></span>
          <span class="hud-corner hud-corner--br"></span>
          <div class="relative z-10">
            <div class="flex items-center gap-2 mb-3">
              <span class="text-[0.52rem] font-semibold tracking-[0.08em] uppercase text-theme-cream/40 flex-1">${m.round}</span>
              <span class="text-[0.5rem] font-bold tracking-[0.12em] uppercase px-2 py-1 rounded-full ${st.cls}">${st.label}</span>
            </div>
            <span class="text-xs justify-center py-2 text-amber-200 flex items-center gap-1">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
              ${m.time} · ${m.field}
            </span>
            <div class="flex items-center justify-between gap-3 mb-3">
              <div class="flex-1 flex flex-col gap-1">
                <div class="h-0.5 w-6 rounded-full" style="background:${m.teamA.color}"></div>
                <span class="text-[0.7rem] font-bold tracking-[0.06em] uppercase text-theme-cream/90">${m.teamA.name}</span>
                ${showSc ? `<span class="text-[1.8rem] font-black leading-none text-theme-cream/90">${score.a}</span>` : ''}
              </div>
              <span class="text-[0.55rem] font-black tracking-[0.15em] text-theme-gold/40">VS</span>
              <div class="flex-1 flex flex-col items-end gap-1">
                <div class="h-0.5 w-6 rounded-full" style="background:${m.teamB.color}"></div>
                <span class="text-[0.7rem] font-bold tracking-[0.06em] uppercase text-theme-cream/90">${m.teamB.name}</span>
                ${showSc ? `<span class="text-[1.8rem] font-black leading-none text-theme-cream/90">${score.b}</span>` : ''}
              </div>
            </div>
            <div class="flex items-center justify-end pt-3 mt-2 border-t border-theme-gold/10">
              <button class="open-match-btn px-4 py-2 rounded-lg text-[0.45rem] font-bold tracking-[0.1em] uppercase border border-green-400/30 text-green-400/80 bg-green-400/5 cursor-pointer hover:bg-green-400/10 transition-all" data-id="${m.id}">Gestionar</button>
            </div>
          </div>
        </div>`;
    }).join('');

    container.querySelectorAll('.open-match-btn').forEach(btn =>
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        window.location.href = '/referee/match/' + btn.dataset.id;
      })
    );
  }

  function renderPendingSection() {
    const section = $('mo-pending-section');
    const container = $('mo-pending-container');
    if (!PENDING_MATCHES.length) {
      section.classList.add('hidden');
      return;
    }
    section.classList.remove('hidden');
    container.innerHTML = PENDING_MATCHES.map(m => `
      <div class="mo-card group relative overflow-hidden rounded-xl border border-theme-gold/20 bg-theme-midnight/70 backdrop-blur-xs p-5">
        <span class="hud-corner hud-corner--tl"></span>
        <span class="hud-corner hud-corner--tr"></span>
        <span class="hud-corner hud-corner--bl"></span>
        <span class="hud-corner hud-corner--br"></span>
        <div class="relative z-10">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-[0.52rem] font-semibold tracking-[0.08em] uppercase text-theme-cream/40">${m.round}</span>
            <span class="text-[0.5rem] text-amber-400 font-bold tracking-[0.12em] uppercase px-2 py-1 rounded-full border border-amber-400/30 bg-amber-400/10">Pendiente</span>
          </div>
          <div class="flex items-center justify-between gap-3 mb-3">
            <div class="flex-1 flex flex-col gap-1">
              <div class="h-0.5 w-6 rounded-full" style="background:${m.teamA.color}"></div>
              <span class="text-[0.7rem] font-bold tracking-[0.06em] uppercase text-theme-cream/90">${m.teamA.name}</span>
            </div>
            <span class="text-[0.55rem] font-black tracking-[0.15em] text-theme-gold/40">VS</span>
            <div class="flex-1 flex flex-col items-end gap-1">
              <div class="h-0.5 w-6 rounded-full" style="background:${m.teamB.color}"></div>
              <span class="text-[0.7rem] font-bold tracking-[0.06em] uppercase text-theme-cream/90">${m.teamB.name}</span>
            </div>
          </div>
          <div class="flex items-center justify-between pt-3 mt-2 border-t border-theme-gold/10">
            <span class="text-[0.5rem] text-amber-200">${m.time} · ${m.field}</span>
            <div class="flex gap-2">
              <button class="mo-pending-reject px-3 py-1.5 rounded-lg text-[0.45rem] font-bold tracking-[0.1em] uppercase border border-red-400/30 text-red-400/80 bg-red-400/5 cursor-pointer hover:bg-red-400/10 transition-all" data-id="${m.match_referee_id}">Rechazar</button>
              <button class="mo-pending-accept px-3 py-1.5 rounded-lg text-[0.45rem] font-bold tracking-[0.1em] uppercase border border-green-400/30 text-green-400/80 bg-green-400/5 cursor-pointer hover:bg-green-400/10 transition-all" data-id="${m.match_referee_id}">Aceptar</button>
            </div>
          </div>
        </div>
      </div>
    `).join('');

    container.querySelectorAll('.mo-pending-accept').forEach(btn =>
      btn.addEventListener('click', async () => {
        btn.disabled = true;
        btn.textContent = 'Aceptando...';
        await fetch('/api/referee/matches', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'accept', matchRefereeId: btn.dataset.id }) });
        await loadMatches();
      })
    );

    container.querySelectorAll('.mo-pending-reject').forEach(btn =>
      btn.addEventListener('click', async () => {
        btn.disabled = true;
        btn.textContent = 'Rechazando...';
        await fetch('/api/referee/matches', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'reject', matchRefereeId: btn.dataset.id }) });
        await loadMatches();
      })
    );
  }

  $('mo-logout-btn')?.addEventListener('click', async () => {
    await fetch('/api/auth/logout', { method: 'POST' });
    window.location.href = '/login';
  });

  loadMatches();
})();
</script>