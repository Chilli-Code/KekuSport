---
import { TEAMS } from '@/consts/teams'

export interface Props {
  id: string
  team1Id: string
  team2Id: string
  team1Name?: string
  team2Name?: string
  title: string
  hour?: string
  date?: string
  venue?: string
  stage?: string
  status?: string
}

const {
  id,
  team1Id,
  team2Id,
  team1Name,
  team2Name,
  hour,
  date,
  venue,
  stage,
  status,
} = Astro.props

const t1 = team1Name ? { name: team1Name, id: team1Id } : TEAMS.find(t => t.id === team1Id)
const t2 = team2Name ? { name: team2Name, id: team2Id } : TEAMS.find(t => t.id === team2Id)

function slugify(text: string): string {
  return text.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '')
}

const team1Slug = t1?.name ? slugify(t1.name) : team1Id
const team2Slug = t2?.name ? slugify(t2.name) : team2Id

const teamLogo = '/images/Logo_Default.png'
---

<div class="duel-card group">
  <div class="duel-inner">
    <div class="duel-stage-bar">
      <span class="duel-stage">{stage ?? 'SIN DEFINIR'}</span>
      {status === 'live' && <span class="duel-badge duel-badge--live">EN VIVO</span>}
      {status === 'finished' && <span class="duel-badge duel-badge--finished">FINALIZADO</span>}
      {status === 'cancelled' && <span class="duel-badge duel-badge--cancelled">CANCELADO</span>}
      {status === 'scheduled' && <span class="duel-badge duel-badge--scheduled">PROGRAMADO</span>}
    </div>

    <div class="duel-teams">
      <a href={`/jugadores/${t1?.id || '#'}`} class="duel-side duel-side--left">
        <div class="duel-avatar-wrap">
          <div class="duel-avatar-bg"></div>
          <img
            class="duel-avatar"
            src={teamLogo}
            alt={t1?.name || 'Equipo'}
            loading="lazy"
          />
        </div>
        <span class="duel-name">{t1?.name || '???'}</span>
      </a>

      <div class="duel-vs" aria-hidden="true">
        <span class="duel-vs-circle">
          <span class="duel-vs-text">VS</span>
        </span>
        <div class="duel-vs-line"></div>
      </div>

      <a href={`/jugadores/${t2?.id || '#'}`} class="duel-side duel-side--right">
        <div class="duel-avatar-wrap">
          <div class="duel-avatar-bg"></div>
          <img
            class="duel-avatar"
            src={teamLogo}
            alt={t2?.name || 'Equipo'}
            loading="lazy"
          />
        </div>
        <span class="duel-name">{t2?.name || '???'}</span>
      </a>
    </div>

    <div class="duel-meta">
      <span class="duel-meta-item">
        <svg class="duel-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        {date ?? 'NO DEFINIDO'} · {hour ?? 'NO DEFINIDO'}
      </span>
      <span class="duel-meta-item">
        <svg class="duel-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        {venue}
      </span>
    </div>

    <div class="duel-meta">
          <a
      href={`/combates/${team1Slug}-vs-${team2Slug}`}
      class="boxer-detail-cta boxer-detail-cta-ghost relative z-10 mt-1"
    >
      VER DUELO
    </a>
    </div>
  </div>
</div>

<style>
  
</style>
