---
import EquipoManager from './EquipoManager.astro'
import PartidoManager from './PartidoManager.astro'
import { getTournamentsWithTeamCount } from '../../../server/db'

const user = Astro.locals.user
const tournaments = user ? await getTournamentsWithTeamCount() : []
const months = ['ENE','FEB','MAR','ABR','MAY','JUN','JUL','AGO','SEP','OCT','NOV','DIC']
function formatDate(d: string) {
  if (!d) return ''
  const p = d.split('T')[0].split('-')
  return p.length === 3 ? `${p[2]} ${months[parseInt(p[1])-1]||p[1]} ${p[0]}` : d
}
function parsePrizes(v: string | null) {
  if (!v) return []
  try { return Object.entries(JSON.parse(v)) } catch { return [] }
}
function parseAwards(v: string | null) {
  if (!v) return []
  try { return JSON.parse(v) } catch { return [] }
}
function parseRules(v: string | null) {
  if (!v) return []
  try { return JSON.parse(v) } catch { return [] }
}
---

<div id="tec-app" class="tec-root">

  <div class="tec-bg" aria-hidden="true">
    <div class="tec-bg-grid"></div>
    <div class="tec-bg-glow"></div>
    <div class="tec-bg-stars"></div>
    <div class="tec-bg-scan"></div>
    <div class="tec-bg-vignette"></div>
  </div>

  <header class="tec-header">
    <div class="tec-header-inner">
      <span class="tec-live-dot"></span>
      <span class="tec-nav-brand">PANEL <span class="tec-gold-text">TÉCNICO</span></span>
      <span class="tec-nav-version">v1.0</span>
    </div>
    <div class="tec-header-divider"></div>
  </header>

  <main class="tec-main">

    <!-- ══════ TORNEOS ══════ -->
    <div id="tab-torneos" class="tec-section">
      <p class="tec-section-label">TORNEOS DISPONIBLES</p>
      <div class="flex flex-col gap-3">
        {tournaments.map(t => {
          const startRaw = t.start_date?.split('T')[0] || t.start_date || ''
          const formattedDate = formatDate(startRaw)
          const prizes = parsePrizes(t.prizes)
          const awards = parseAwards(t.awards)
          const rules = parseRules(t.rules)
          return (
          <div class="tec-tourney-card">
            <span class="hud-c hud-c--tl"></span><span class="hud-c hud-c--tr"></span>
            <span class="hud-c hud-c--bl"></span><span class="hud-c hud-c--br"></span>
            <div class="flex items-start justify-between mb-2">
              <div>
                <h3 class="tec-tourney-name">{t.name}</h3>
                <p class="tec-tourney-cat">{t.format} · {t.field_players ?? 5}v{t.field_players ?? 5}</p>
              </div>
              <span class="tec-tourney-badge status-open">INSCRIPCIÓN ABIERTA</span>
            </div>
            <p class="tec-tourney-desc">{t.description || ''}</p>
            <div class="flex items-center justify-between mt-3 pt-3 border-t border-white/[0.05]">
              <span class="tec-tourney-meta">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                {formattedDate}
              </span>
              <span class="tec-tourney-meta">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                Hasta {t.num_teams} equipos
              </span>
              <button class="tec-inscribir-btn" data-tourney={t.id} data-tourney-name={t.name} data-current-teams={t.team_count} data-max-teams={t.num_teams} disabled={t.team_count >= t.num_teams}>{t.team_count >= t.num_teams ? 'COMPLETO' : 'INSCRIBIRSE'}</button>
            </div>
            <div class="tec-tourney-details hidden">
              <div class="tec-td-grid">
                <div class="tec-td-item">
                  <span class="tec-td-label">DURACIÓN PARTIDO</span>
                  <span class="tec-td-val">{t.match_duration ? t.match_duration + ' min' : '—'}</span>
                </div>
                <div class="tec-td-item">
                  <span class="tec-td-label">PTS POR TRIUNFO</span>
                  <span class="tec-td-val">{t.points_per_win ?? '—'}</span>
                </div>
                <div class="tec-td-item">
                  <span class="tec-td-label">SEDE</span>
                  <span class="tec-td-val">{t.venue || '—'}</span>
                </div>
                <div class="tec-td-item">
                  <span class="tec-td-label">CIUDAD</span>
                  <span class="tec-td-val">{t.city || '—'}</span>
                </div>
                <div class="tec-td-item">
                  <span class="tec-td-label">COSTO INSCRIPCIÓN</span>
                  <span class="tec-td-val">{t.registration_fee != null ? (t.registration_fee === 0 ? 'Gratis' : '$' + t.registration_fee) : '—'}</span>
                </div>
                <div class="tec-td-item">
                  <span class="tec-td-label">EDADES</span>
                  <span class="tec-td-val">{t.min_age || '—'} – {t.max_age || '—'}</span>
                </div>
                <div class="tec-td-item">
                  <span class="tec-td-label">GRUPOS</span>
                  <span class="tec-td-val">{t.num_groups ? t.num_groups : '—'}</span>
                </div>
                <div class="tec-td-item">
                  <span class="tec-td-label">AVANZAN POR GRUPO</span>
                  <span class="tec-td-val">{t.advancers_per_group ? t.advancers_per_group : '—'}</span>
                </div>
                <div class="tec-td-item">
                  <span class="tec-td-label">IDA/VUELTA GRUPOS</span>
                  <span class="tec-td-val">{t.two_legged ? 'Sí' : 'No'}</span>
                </div>
                <div class="tec-td-item">
                  <span class="tec-td-label">IDA/VUELTA ELIMIN.</span>
                  <span class="tec-td-val">{t.playoffs_two_legged ? 'Sí' : 'No'}</span>
                </div>
                <div class="tec-td-item">
                  <span class="tec-td-label">FINAL ÚNICA</span>
                  <span class="tec-td-val">{t.single_final_match ? 'Sí' : 'No'}</span>
                </div>
              </div>

              {prizes.length ? (
              <div class="tec-td-section">
                <span class="tec-td-section-title">PREMIOS / GANANCIAS</span>
                <div class="tec-td-prizes">
                  {prizes.map(([k, v]) => (
                    <div class="tec-td-prize-row"><span>{k}</span><span>{v}</span></div>
                  ))}
                </div>
              </div>
              ) : null}

              {awards.length ? (
              <div class="tec-td-section">
                <span class="tec-td-section-title">RECONOCIMIENTOS</span>
                <div class="flex flex-wrap gap-1">
                  {awards.map(a => (
                    <span class="tec-td-award">{a}</span>
                  ))}
                </div>
              </div>
              ) : null}

              {rules.length ? (
              <div class="tec-td-section">
                <span class="tec-td-section-title">REGLAS</span>
                <ul class="tec-td-rules">
                  {rules.map(r => (
                    <li>{r}</li>
                  ))}
                </ul>
              </div>
              ) : null}

              {t.requirements ? (
              <div class="tec-td-section">
                <span class="tec-td-section-title">REQUISITOS</span>
                <p class="tec-td-reqs">{t.requirements}</p>
              </div>
              ) : null}
            </div>
          </div>
          )
        })}
      </div>
    </div>

    <!-- ══════ EQUIPOS ══════ -->
    <div id="tab-equipos" class="tec-section hidden">
<div class="flex items-center justify-between mb-3">
  <p class="tec-section-label !mb-0">MIS EQUIPOS</p>
  <button class="tec-crear-equipo-btn" id="btn-crear-equipo">
    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    CREAR
  </button>
</div>
<div id="equipos-list" class="flex flex-col gap-3"></div>
</div>

    <!-- ══════ DUELOS ══════ -->
    <div id="tab-duelos" class="tec-section hidden">
      <PartidoManager />
    </div>

    <!-- ══════ PLANTILLA ══════ -->
    <div id="tab-plantilla" class="tec-section hidden">
      <EquipoManager />
    </div>

    <!-- ══════ SOLICITUDES ══════ -->
    <div id="tab-solicitudes" class="tec-section hidden">
      <div class="flex items-center justify-between mb-3">
        <p class="tec-section-label !mb-0">SOLICITUDES DE JUGADORES</p>
        <button id="solicitudes-refresh" class="tec-crear-equipo-btn" style="font-size:.38rem;padding:.25rem .5rem">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
          ACTUALIZAR
        </button>
      </div>
      <div id="solicitudes-list" class="flex flex-col gap-2">
        <p class="tec-empty">Cargando solicitudes...</p>
      </div>

      <div class="border-t border-white/10 my-4"></div>
      <p class="tec-section-label !mb-3">INVITACIONES A TORNEOS</p>
      <div id="invitaciones-list" class="flex flex-col gap-2">
        <p class="tec-empty">Cargando invitaciones...</p>
      </div>
    </div>

    <!-- ══════ AJUSTES ══════ -->
    <div id="tab-ajustes" class="tec-section hidden">
      <p class="tec-section-label">AJUSTES DEL TÉCNICO</p>
      <div class="tec-card">
        <span class="hud-c hud-c--tl"></span><span class="hud-c hud-c--tr"></span>
        <span class="hud-c hud-c--bl"></span><span class="hud-c hud-c--br"></span>
        <div class="flex flex-col gap-4">
          <div>
            <label class="tec-field-label mb-1.5 block" for="tec-name-input">NOMBRE DEL TÉCNICO</label>
            <input id="tec-name-input" type="text" placeholder="Tu nombre" class="tec-input" />
          </div>
          <div class="flex items-center justify-between">
            <div>
              <p class="tec-field-label mb-0.5">NOTIFICACIONES</p>
              <p class="text-[.4rem] text-white/20 tracking-wider">Recibir alertas de partidos e invitaciones</p>
            </div>
            <label class="tec-toggle">
              <input type="checkbox" id="tec-notif-toggle" checked />
              <span class="tec-toggle-slider"></span>
            </label>
          </div>
          <div class="border-t border-white/[0.06] pt-3 mt-1">
            <p class="tec-field-label mb-1">INFORMACIÓN</p>
            <p class="text-[.45rem] text-white/20 tracking-wide">Panel Técnico v1.0</p>
            <p class="text-[.45rem] text-white/20 tracking-wide">KekuSport · Barranquilla</p>
          </div>
          <div class="border-t border-white/[0.06] pt-3 mt-3">
            <button id="tec-logout-btn" class="tec-btn-ghost !text-red-400 !border-red-400/30 hover:!bg-red-400/10 w-full justify-center">
              CERRAR SESIÓN
            </button>
          </div>
        </div>
      </div>
    </div>

  </main>

  <!-- ══════ MODAL: CREAR EQUIPO / INSCRIBIR ══════ -->
  <div id="modal-crear-equipo" class="tec-overlay tec-overlay--bottom hidden">
    <div class="tec-modal tec-modal--sheet">
      <div class="tec-modal-handle"></div>
      <span class="hud-c hud-c--tl"></span><span class="hud-c hud-c--tr"></span>
      <span class="hud-c hud-c--bl"></span><span class="hud-c hud-c--br"></span>
      <div class="px-5 pt-5 pb-2">
        <h3 class="tec-modal-title" id="modal-title">CREAR EQUIPO</h3>
        <p class="text-[.45rem] mt-0.5 tracking-widest uppercase font-[family-name:var(--font-display)]" style="color:rgba(251,191,36,.5)" id="modal-subtitle">Personaliza la identidad de tu equipo</p>
      </div>
      <!-- ── Inscription section (visible when clicking INSCRIBIRSE) ── -->
      <div id="inscripcion-section" class="px-5 pb-2 hidden">
        <label class="tec-field-label mb-1.5 block">INSCRIBIR EN TORNEO</label>
        <p id="inscripcion-tourney-label" class="tec-chip inline-block mb-3"></p>
        <label class="tec-field-label mb-1.5 block">SELECCIONA UN EQUIPO</label>
        <select id="team-selector" class="tec-input mb-2">
          <option value="">Seleccionar equipo...</option>
        </select>
        <div id="inscripcion-send-wrap" class="hidden">
          <button class="tec-btn-primary w-full justify-center" id="btn-enviar-solicitud">ENVIAR SOLICITUD</button>
        </div>
        <div class="flex items-center gap-2 my-2">
          <div class="flex-1 h-px bg-white/[0.06]"></div>
          <span class="text-[.4rem] text-white/20 tracking-widest uppercase font-[family-name:var(--font-display)]">O CREA UNO NUEVO</span>
          <div class="flex-1 h-px bg-white/[0.06]"></div>
        </div>
      </div>
      <div class="px-5 pb-3 flex flex-col gap-1">
        <div class="tec-create-preview" id="create-preview">
          <div class="tec-create-preview-logo" id="preview-logo">
            <img id="preview-img" src="" alt="Logo" />
            <span class="tec-create-preview-fallback" id="preview-fallback">?</span>
          </div>
          <div class="tec-create-preview-info">
            <span class="tec-create-preview-name" id="preview-name">NOMBRE</span>
            <span class="tec-create-preview-hint">Vista previa</span>
          </div>
        </div>
        <div class="pt-3">
          <label class="tec-field-label mb-1.5 block" for="new-team-name">NOMBRE DEL EQUIPO</label>
          <input id="new-team-name" type="text" maxlength="30" placeholder="Ej: Los Vikingos" class="tec-input" autocomplete="off" />
        </div>
        <div class="pt-2">
          <label class="tec-field-label mb-1.5 block" for="new-team-category">CATEGORÍA</label>
          <select id="new-team-category" class="tec-input">
            <option value="Libre Masculino">Libre Masculino</option>
            <option value="Libre Femenino">Libre Femenino</option>
            <option value="Sub-17 Masculino">Sub-17 Masculino</option>
            <option value="Sub-17 Femenino">Sub-17 Femenino</option>
            <option value="Sub-21 Masculino">Sub-21 Masculino</option>
            <option value="Sub-21 Femenino">Sub-21 Femenino</option>
            <option value="Mixto">Mixto</option>
            <option value="Veteranos">Veteranos</option>
          </select>
        </div>
        <div class="pt-2">
          <label class="tec-field-label mb-1.5 block">ESCUDO</label>
          <div class="tec-upload-area" id="upload-area">
            <input type="file" id="logo-upload" accept="image/*" class="hidden" />
            <div class="tec-upload-placeholder" id="upload-placeholder">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              <span>TOCAR PARA SUBIR</span>
            </div>
            <div class="tec-upload-preview hidden" id="upload-preview">
              <img id="upload-preview-img" src="" alt="Logo" />
              <button class="tec-upload-remove" id="btn-remove-logo" type="button">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </div>
          </div>
        </div>
        <div class="pt-2">
          <label class="tec-field-label mb-1.5 block">COLOR</label>
          <div class="flex flex-wrap gap-2" id="new-team-color-picker">
            <button class="tec-color-dot active" data-color="#00ff88" style="background:#00ff88"></button>
            <button class="tec-color-dot" data-color="#f59e0b" style="background:#f59e0b"></button>
            <button class="tec-color-dot" data-color="#f87171" style="background:#f87171"></button>
            <button class="tec-color-dot" data-color="#a78bfa" style="background:#a78bfa"></button>
            <button class="tec-color-dot" data-color="#38bdf8" style="background:#38bdf8"></button>
            <button class="tec-color-dot" data-color="#e2ff5d" style="background:#e2ff5d"></button>
            <button class="tec-color-dot" data-color="#ff6b6b" style="background:#ff6b6b"></button>
            <button class="tec-color-dot" data-color="#c7a86b" style="background:#c7a86b"></button>
          </div>
        </div>
      </div>
      <div class="px-5 justify-between pb-5 pt-4 flex gap-2.5 border-t border-[rgba(199,168,107,.12)]">
        <button class="tec-btn-ghost" data-close="modal-crear-equipo">CANCELAR</button>
        <button class="tec-btn-primary" id="btn-save-new-team">CREAR EQUIPO</button>
      </div>
    </div>
  </div>

</div>

<style is:global>
  
  #tec-app {
    --gold:     var(--color-theme-gold, #fbbf24);
    --cream:    var(--color-theme-cream, #fef3c7);
    --midnight: var(--color-theme-midnight, #1e1b4b);
    --green:    #00ff88;
    --green-dim:#00cc6a;
    --purple:   #a855f7;
    --red:      #ef4444;
    --orange:   #f97316;
    --border:   rgba(199,168,107,.14);
    --surface:  rgba(255,255,255,.03);
    --font-display: 'Orbitron', monospace;
    --font-body:    'Rajdhani', sans-serif;
    --font-game:    'Cinzel', serif;
  }

  .tec-root {
    position: relative;
    min-height: 100svh;
    font-family: var(--font-body);
    background:
      radial-gradient(ellipse at 50% -10%, #0b2a1a 0%, #050d08 55%, #03080e 100%);
    overflow-x: hidden;
    color: var(--cream);
    padding: 5rem 1.5rem 6rem;
    letter-spacing: .04em;
  }

  /* ═══ BACKGROUND ═══ */
  .tec-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 90% 60% at 50% -5%, rgba(0,255,136,.07) 0%, transparent 70%),
      radial-gradient(ellipse 50% 40% at 80% 80%, rgba(168,85,247,.04) 0%, transparent 60%);
  }
  .tec-bg-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(0,255,136,.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,255,136,.03) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, #000 30%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, #000 30%, transparent 70%);
  }
  .tec-bg-glow {
    position: absolute;
    top: -10%;
    left: 50%;
    transform: translateX(-50%);
    width: 60%;
    height: 50%;
    background: radial-gradient(ellipse, rgba(0,255,136,.14) 0%, transparent 70%);
    filter: blur(70px);
    animation: glowPulse 6s ease-in-out infinite alternate;
  }
  @keyframes glowPulse {
  0%   { opacity: .35; transform: translateX(-50%) scale(1); }
  100% { opacity: .85; transform: translateX(-50%) scale(1.12); }
  }
  .tec-bg-stars {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(1.5px 1.5px at 7% 15%, #fff, transparent),
      radial-gradient(1px   1px   at 25% 58%, #aaffcc, transparent),
      radial-gradient(2px   2px   at 50% 10%, #a855f7, transparent),
      radial-gradient(1px   1px   at 70% 75%, #fff, transparent),
      radial-gradient(2px   2px   at 88% 35%, #00ff88, transparent),
      radial-gradient(1px   1px   at 16% 85%, #c084fc, transparent),
      radial-gradient(1.5px 1.5px at 60% 50%, #fff, transparent),
      radial-gradient(1px   1px   at 42% 30%, #aaffcc, transparent);
    background-size: 260px 260px;
    opacity: .3;
    animation: twinkle 6s ease-in-out infinite alternate;
  }
  @keyframes twinkle { 0%{opacity:.1} 100%{opacity:.4} }
  .tec-bg-scan {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0,255,136,.008) 2px,
      rgba(0,255,136,.008) 3px
    );
  }
  .tec-bg-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 50%, rgba(0,0,0,.6) 100%);
  }

  /* ═══ HEADER ═══ */
  .tec-header {
    background: rgba(6,11,18,.93);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
  }
  .tec-header-divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold) 20%, var(--green) 80%, transparent);
    opacity: .3;
  }
  .tec-header-inner {
    max-width: 720px;
    margin: 0 auto;
    padding: .5rem .75rem;
    display: flex;
    align-items: center;
    gap: .5rem;
  }
  .tec-live-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
    background: var(--green);
    box-shadow: 0 0 10px var(--green), 0 0 20px rgba(0,255,136,.3);
    animation: blink 1.2s ease-in-out infinite;
  }
  @keyframes blink { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.3;transform:scale(.8)} }
  .tec-nav-brand {
    font-family: var(--font-display);
    font-size: .55rem;
    font-weight: 700;
    letter-spacing: .18em;
    color: rgba(232,220,200,.7);
    white-space: nowrap;
  }
  .tec-gold-text {
    background: linear-gradient(90deg, var(--gold), #f59e0b);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .tec-nav-version {
    font-family: monospace;
    font-size: .4rem;
    color: rgba(251,191,36,.3);
    border: 1px solid rgba(251,191,36,.12);
    border-radius: 4px;
    padding: .05rem .3rem;
    letter-spacing: .05em;
  }

  /* ═══ MAIN ═══ */
  .tec-main {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 0 auto;
    padding: 1rem .75rem 5rem;
  }
  .tec-section { display: block; }
  .tec-section.hidden { display: none; }
  .tec-scroll-content { padding-bottom: 4rem; }

  /* ═══ TYPOGRAPHY ═══ */
  .tec-section-label {
    display: block;
    font-family: var(--font-display);
    font-size: .48rem;
    font-weight: 600;
    letter-spacing: .22em;
    color: rgba(251,191,36,.5);
    text-transform: uppercase;
    margin-bottom: .5rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: .35rem;
  }
  .tec-label {
    display: block;
    font-size: .45rem;
    font-weight: 600;
    letter-spacing: .18em;
    color: rgba(232,220,200,.3);
    text-transform: uppercase;
    font-family: var(--font-display);
  }
  .tec-empty {
    font-size: .55rem;
    letter-spacing: .04em;
    color: rgba(232,220,200,.18);
    padding: .5rem 0;
  }

  /* ═══ HUD CORNERS ═══ */
  .hud-c {
    position: absolute;
    width: 12px;
    height: 12px;
    border-style: solid;
    border-color: rgba(199,168,107,.25);
    pointer-events: none;
    z-index: 2;
    transition: all .3s ease;
  }
  .hud-c--tl { top: 6px; left: 6px; border-width: 1.5px 0 0 1.5px; }
  .hud-c--tr { top: 6px; right: 6px; border-width: 1.5px 1.5px 0 0; }
  .hud-c--bl { bottom: 6px; left: 6px; border-width: 0 0 1.5px 1.5px; }
  .hud-c--br { bottom: 6px; right: 6px; border-width: 0 1.5px 1.5px 0; }

  .tec-tourney-card:hover .hud-c,
  .tec-equipo-card:hover .hud-c,
  .tec-card:hover .hud-c,
  .tec-hero-card:hover .hud-c {
    border-color: rgba(0,255,136,.5);
    width: 16px;
    height: 16px;
  }

  /* ═══ TORNEOS ═══ */
  .tec-tourney-card {
    position: relative;
    background: linear-gradient(160deg,
      color-mix(in srgb, var(--midnight) 88%, var(--green)) 0%,
      var(--midnight) 100%);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.1rem;
    overflow: hidden;
    transition: border-color .25s, box-shadow .25s;
  }
  .tec-tourney-card:hover {
    border-color: rgba(199,168,107,.3);
  }
  .tec-tourney-name {
    font-family: var(--font-display);
    font-size: .65rem;
    font-weight: 700;
    letter-spacing: .06em;
    color: var(--cream);
    text-transform: uppercase;
  }
  .tec-tourney-cat {
    font-size: .45rem;
    letter-spacing: .12em;
    color: rgba(232,220,200,.25);
    text-transform: uppercase;
    margin-top: .1rem;
  }
  .tec-tourney-desc {
    font-size: .5rem;
    letter-spacing: .04em;
    color: rgba(232,220,200,.4);
    line-height: 1.4;
  }
  .tec-tourney-meta {
    display: inline-flex;
    align-items: center;
    gap: .25rem;
    font-family: var(--font-display);
    font-size: .4rem;
    letter-spacing: .08em;
    color: rgba(232,220,200,.25);
    text-transform: uppercase;
  }
  .tec-tourney-badge {
    font-family: var(--font-display);
    font-size: .38rem;
    font-weight: 600;
    letter-spacing: .1em;
    border-radius: 99px;
    padding: .18rem .5rem;
    white-space: nowrap;
    text-transform: uppercase;
  }
  .tec-tourney-badge.status-open {
    color: #34d399;
    background: rgba(6,78,59,.7);
    border: 1px solid rgba(52,211,153,.25);
  }
  .tec-tourney-badge.status-invited {
    color: #fbbf24;
    background: rgba(120,53,15,.6);
    border: 1px solid rgba(251,191,36,.25);
  }
  .tec-tourney-badge.status-closed {
    color: rgba(232,220,200,.35);
    background: rgba(255,255,255,.03);
    border: 1px solid rgba(255,255,255,.06);
  }
  .tec-inscribir-btn {
    font-family: var(--font-display);
    font-size: .4rem;
    font-weight: 600;
    letter-spacing: .1em;
    color: var(--midnight);
    background: linear-gradient(135deg, var(--gold), #f59e0b);
    border: none;
    border-radius: 99px;
    padding: .3rem .7rem;
    cursor: pointer;
    transition: filter .2s, transform .15s;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .tec-inscribir-btn:hover {
    filter: brightness(1.1);
    transform: translateY(-1px);
  }
  .tec-inscribir-btn:disabled {
    filter: grayscale(0.6) brightness(0.7);
    cursor: not-allowed;
    transform: none;
    opacity: 0.6;
  }
  .tec-tourney-card {
    cursor: pointer;
  }

  /* ═══ TOURNAMENT DETAIL INSIDE CARD ═══ */
  .tec-tourney-details {
    margin-top: .75rem;
    padding-top: .75rem;
    border-top: 1px solid rgba(255,255,255,.05);
    animation: tdFadeIn .25s ease;
  }
  @keyframes tdFadeIn {
    from { opacity: 0; max-height: 0; }
    to   { opacity: 1; max-height: 800px; }
  }
  .tec-td-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .3rem;
  }
  .tec-td-item {
    background: rgba(255,255,255,.02);
    border: 1px solid rgba(255,255,255,.04);
    border-radius: 8px;
    padding: .3rem .4rem;
  }
  .tec-td-label {
    display: block;
    font-family: var(--font-display);
    font-size: .5rem;
    letter-spacing: .08em;
    color: rgba(251,191,36,.35);
    text-transform: uppercase;
    margin-bottom: .05rem;
  }
  .tec-td-val {
    display: block;
    font-size: .5rem;
    font-weight: 600;
    color: var(--cream);
    letter-spacing: .02em;
  }
  .tec-td-section {
    margin-top: .5rem;
  }
  .tec-td-section-title {
    display: block;
    font-family: var(--font-display);
    font-size: .45rem;
    letter-spacing: .1em;
    color: rgba(251,191,36,.4);
    text-transform: uppercase;
    margin-bottom: .25rem;
  }
  .tec-td-prizes {
    display: flex;
    flex-direction: column;
    gap: .15rem;
  }
  .tec-td-prize-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(255,255,255,.02);
    border: 1px solid rgba(255,255,255,.04);
    border-radius: 6px;
    padding: .2rem .4rem;
  }
  .tec-td-prize-row span:first-child {
    font-family: var(--font-display);
    font-size: .7rem;
    letter-spacing: .06em;
    color: rgba(251,191,36,.45);
    text-transform: uppercase;
  }
  .tec-td-prize-row span:last-child {
    font-size: .5rem;
    font-weight: 700;
    color: var(--gold);
  }
  .tec-td-award {
    display: inline-block;
    background: rgba(251,191,36,.06);
    border: 1px solid rgba(251,191,36,.1);
    border-radius: 99px;
    padding: .15rem .45rem;
    font-size: .4rem;
    font-family: var(--font-display);
    letter-spacing: .05em;
    color: rgba(251,191,36,.5);
    text-transform: uppercase;
  }
  .tec-td-rules {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: .15rem;
  }
  .tec-td-rules li {
    font-size: .42rem;
    color: rgba(232,220,200,.4);
    padding: .2rem .35rem;
    background: rgba(255,255,255,.02);
    border: 1px solid rgba(255,255,255,.04);
    border-radius: 6px;
    letter-spacing: .02em;
    line-height: 1.35;
  }
  .tec-td-reqs {
    font-size: .42rem;
    color: rgba(232,220,200,.35);
    line-height: 1.4;
  }

  /* ═══ TOGGLE ═══ */
  .tec-toggle {
    position: relative;
    display: inline-block;
    width: 40px;
    height: 22px;
    flex-shrink: 0;
  }
  .tec-toggle input {
    display: none;
  }
  .tec-toggle-slider {
    position: absolute;
    cursor: pointer;
    inset: 0;
    background: var(--surface);
    border-radius: 99px;
    transition: .3s;
    border: 1px solid var(--border);
  }
  .tec-toggle-slider::before {
    content: '';
    position: absolute;
    height: 16px;
    width: 16px;
    left: 2px;
    bottom: 2px;
    background: rgba(232,220,200,.3);
    border-radius: 50%;
    transition: .3s;
  }
  .tec-toggle input:checked + .tec-toggle-slider {
    background: rgba(251,191,36,.15);
    border-color: rgba(251,191,36,.4);
  }
  .tec-toggle input:checked + .tec-toggle-slider::before {
    transform: translateX(18px);
    background: var(--gold);
    box-shadow: 0 0 8px rgba(251,191,36,.3);
  }

  /* ═══ CARD ═══ */
  .tec-card {
    position: relative;
    background: linear-gradient(160deg,
      color-mix(in srgb, var(--midnight) 88%, var(--green)) 0%,
      var(--midnight) 100%);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.1rem;
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(0,0,0,.3);
  }

  /* ═══ SQUAD ═══ */
  .tec-squad-item {
    display: flex;
    align-items: center;
    gap: .65rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 11px;
    padding: .6rem .8rem;
    transition: border-color .2s, background .2s, transform .15s;
    cursor: default;
  }
  .tec-squad-item:hover {
    border-color: rgba(199,168,107,.25);
    background: rgba(255,255,255,.05);
    transform: translateX(3px);
  }
  .tec-squad-avatar {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    flex-shrink: 0;
    background: rgba(199,168,107,.06);
    border: 1px solid rgba(199,168,107,.12);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
  }

  /* ═══ SEARCH ═══ */
  .tec-search-result {
    display: flex;
    align-items: center;
    gap: .65rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: .55rem .75rem;
    transition: border-color .2s, background .2s;
  }
  .tec-search-result:hover {
    border-color: rgba(199,168,107,.25);
    background: rgba(255,255,255,.05);
  }
  .tec-search-avatar {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    flex-shrink: 0;
    background: rgba(199,168,107,.06);
    border: 1px solid rgba(199,168,107,.1);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: .95rem;
  }
  .tec-invite-btn {
    font-family: var(--font-display);
    font-size: .42rem;
    font-weight: 600;
    letter-spacing: .1em;
    color: var(--gold);
    background: rgba(251,191,36,.06);
    border: 1px solid rgba(251,191,36,.2);
    border-radius: 99px;
    padding: .22rem .7rem;
    cursor: pointer;
    transition: all .2s;
    white-space: nowrap;
    text-transform: uppercase;
  }
  .tec-invite-btn:hover {
    background: rgba(251,191,36,.12);
    border-color: rgba(251,191,36,.4);
    box-shadow: 0 0 16px rgba(251,191,36,.08);
  }
  .tec-invite-btn:disabled { opacity: .35; cursor: not-allowed; box-shadow: none; }

  .tec-invite-item {
    display: flex;
    align-items: center;
    gap: .65rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: .55rem .75rem;
  }
  .tec-invite-status {
    font-family: var(--font-display);
    font-size: .4rem;
    font-weight: 600;
    letter-spacing: .1em;
    border-radius: 99px;
    padding: .15rem .55rem;
    border: 1px solid;
    margin-left: auto;
    white-space: nowrap;
    text-transform: uppercase;
  }
  .tec-invite-status--pending  { color: #fbbf24; background: rgba(120,53,15,.6); border-color: rgba(251,191,36,.25); }
  .tec-invite-status--accepted { color: #34d399; background: rgba(6,78,59,.6);  border-color: rgba(52,211,153,.25); }

  /* ═══ HERO CARD ═══ */
  .tec-hero-card {
    position: relative;
    background: linear-gradient(160deg,
      color-mix(in srgb, var(--midnight) 88%, var(--green)) 0%,
      var(--midnight) 100%);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
    overflow: hidden;
    box-shadow:
      0 8px 40px rgba(0,0,0,.5),
      inset 0 1px 0 rgba(199,168,107,.08);
    transition: border-color .3s, box-shadow .3s;
  }
  .tec-hero-card:hover {
    border-color: rgba(199,168,107,.3);
    box-shadow:
      0 8px 50px rgba(0,0,0,.5),
      0 0 30px rgba(199,168,107,.06),
      inset 0 1px 0 rgba(199,168,107,.1);
  }
  .tec-hero-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse at 25% 30%, rgba(0,255,136,.06), transparent 65%);
    transition: background .5s;
  }
  .tec-hero-badge {
    position: absolute;
    top: -20px;
    right: -20px;
    width: 100px;
    height: 100px;
    background: radial-gradient(circle at center, rgba(0,255,136,.04), transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }
  .tec-logo-wrap {
    position: relative;
    flex-shrink: 0;
    width: 80px;
    height: 80px;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid rgba(251,191,36,.2);
    background: rgba(251,191,36,.04);
    box-shadow: 0 0 25px rgba(251,191,36,.06), inset 0 0 20px rgba(251,191,36,.02);
    transition: border-color .3s, box-shadow .3s, transform .2s;
    font-size: 2.2rem;
    line-height: 1;
  }
  .tec-logo-wrap:hover { transform: scale(1.03); }
  .tec-logo-wrap img { width:100%; height:100%; object-fit:cover; display:block; }
  .tec-team-name {
    font-family: var(--font-display);
    font-size: clamp(1rem, 4vw, 1.4rem);
    font-weight: 900;
    letter-spacing: .08em;
    color: var(--cream);
    line-height: 1.1;
    text-shadow: 0 0 20px rgba(251,191,36,.08);
  }
  .tec-icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    flex-shrink: 0;
    background: rgba(251,191,36,.06);
    border: 1px solid rgba(251,191,36,.15);
    color: rgba(232,220,200,.4);
    cursor: pointer;
    transition: all .2s;
  }
  .tec-icon-btn:hover {
    background: rgba(251,191,36,.12);
    color: var(--gold);
    box-shadow: 0 0 12px rgba(251,191,36,.1);
  }
  .tec-color-dot {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2px solid transparent;
    cursor: pointer;
    transition: transform .15s, border-color .15s, box-shadow .15s;
    position: relative;
  }
  .tec-color-dot:hover { transform: scale(1.25); }
  .tec-color-dot.active {
    border-color: #fff;
    box-shadow: 0 0 14px currentColor, 0 0 30px currentColor;
  }
  .tec-color-dot.active::after {
    content: '✓';
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: .65rem;
    font-weight: 900;
    color: #000;
  }

  /* ═══ STATS ═══ */
  .tec-stat-val {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 900;
    line-height: 1;
    color: var(--green);
    text-shadow: 0 0 20px rgba(0,255,136,.2);
  }
  .tec-stat-label {
    font-family: var(--font-display);
    font-size: .38rem;
    font-weight: 600;
    letter-spacing: .15em;
    color: rgba(232,220,200,.25);
    text-transform: uppercase;
  }
  .tec-stat-bar {
    width: 100%;
    height: 3px;
    border-radius: 2px;
    background: rgba(0,255,136,.08);
    margin-top: .25rem;
    overflow: hidden;
  }
  .tec-stat-bar-fill {
    height: 100%;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--green), #34d399);
    transition: width .5s ease;
    box-shadow: 0 0 8px rgba(0,255,136,.3);
  }

  /* ═══ CHIPS & BADGES ═══ */
  .tec-chip {
    font-family: var(--font-display);
    font-size: .42rem;
    font-weight: 600;
    letter-spacing: .12em;
    color: var(--gold);
    background: rgba(251,191,36,.06);
    border: 1px solid rgba(251,191,36,.18);
    border-radius: 99px;
    padding: .18rem .6rem;
    white-space: nowrap;
  }
  .tec-badge-live {
    font-family: var(--font-display);
    font-size: .4rem;
    font-weight: 600;
    letter-spacing: .1em;
    color: #34d399;
    background: rgba(6,78,59,.7);
    border: 1px solid rgba(52,211,153,.25);
    border-radius: 99px;
    padding: .2rem .6rem;
  }
  .tec-badge-upcoming {
    font-family: var(--font-display);
    font-size: .4rem;
    font-weight: 600;
    letter-spacing: .1em;
    color: rgba(251,191,36,.6);
    background: rgba(251,191,36,.06);
    border: 1px solid rgba(251,191,36,.15);
    border-radius: 99px;
    padding: .2rem .6rem;
  }

  /* ═══ FIELD ═══ */
  .tec-field-wrap {
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: 0 0 30px rgba(199,168,107,.04), 0 8px 40px rgba(0,0,0,.4);
    position: relative;
  }
  .tec-field-wrap::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: 15px;
    background: linear-gradient(135deg, rgba(251,191,36,.08), transparent 40%, rgba(0,255,136,.08) 80%);
    z-index: -1;
    opacity: .5;
  }
  .tec-field {
    position: relative;
    background: linear-gradient(180deg, #0a2a0a 0%, #0e3d0e 45%, #0a2a0a 100%);
    width: 100%;
    aspect-ratio: 7/10;
    overflow: hidden;
  }
  .tec-field-line--mid {
    position: absolute;
    left: 5%;
    right: 5%;
    top: 50%;
    height: 1px;
    background: rgba(255,255,255,.08);
  }
  .tec-field-circle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%,-50%);
    width: 22%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,.08);
  }
  .tec-field-box {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 46%;
    height: 14%;
    border: 1px solid rgba(255,255,255,.08);
  }
  .tec-field-box--top { top: 0; border-top: none; }
  .tec-field-box--bot { bottom: 0; border-bottom: none; }
  .tec-field-goal {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 18%;
    height: 4%;
    border: 1px solid rgba(255,255,255,.08);
    background: rgba(255,255,255,.02);
  }
  .tec-field-goal--top { top: 0; }
  .tec-field-goal--bot { bottom: 0; }

  .field-player {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .1rem;
    transform: translate(-50%,-50%);
    cursor: pointer;
    transition: transform .2s, filter .2s;
  }
  .field-player:hover {
    transform: translate(-50%,-50%) scale(1.18);
    filter: brightness(1.2);
    z-index: 10;
  }
  .field-player-dot {
    width: clamp(30px, 5.5vw, 40px);
    height: clamp(30px, 5.5vw, 40px);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: .65rem;
    font-weight: 900;
    color: #000;
    border: 2px solid rgba(255,255,255,.2);
    box-shadow: 0 2px 12px rgba(0,0,0,.6), 0 0 0 1px rgba(0,0,0,.2);
    transition: box-shadow .2s, border-color .2s;
  }
  .field-player-dot--empty {
    background: rgba(255,255,255,.04);
    color: rgba(255,255,255,.2);
    border: 1.5px dashed rgba(255,255,255,.1);
  }
  .field-player:hover .field-player-dot {
    box-shadow: 0 0 20px rgba(0,255,136,.35), 0 2px 12px rgba(0,0,0,.6);
  }
  .field-player-name {
    font-family: var(--font-display);
    font-size: .70rem;
    font-weight: 600;
    letter-spacing: .04em;
    color: rgba(255,255,255,.8);
    white-space: nowrap;
    text-shadow: 0 0 8px rgba(0,0,0,.95), 0 0 3px rgba(0,0,0,.8);
  }
  .field-player-pos {
    font-size: .28rem;
    color: rgba(255,255,255,.35);
    white-space: nowrap;
    text-shadow: 0 0 6px rgba(0,0,0,.9);
  }

  /* ═══ FORMATION BTNS ═══ */
  .tec-formation-btn {
