<script data-astro-rerun>
(function(){
  function esc(str) { const d = document.createElement('div'); d.textContent = str; return d.innerHTML; }

  // ── Tab switching ──
  const tabs = document.querySelectorAll('#bottomNav .list');
  const sections = {
    torneos:     document.getElementById('tab-torneos'),
    solicitudes: document.getElementById('tab-solicitudes'),
    equipos:     document.getElementById('tab-equipos'),
    duelos:      document.getElementById('tab-duelos'),
    plantilla:   document.getElementById('tab-plantilla'),
    ajustes:     document.getElementById('tab-ajustes'),
  };

  function switchTab(tabId) {
    tabs.forEach(t => t.classList.toggle('active', t.dataset.tab === tabId));
    Object.keys(sections).forEach(key => {
      if (sections[key]) sections[key].classList.toggle('hidden', key !== tabId);
    });
    if (tabId === 'equipos') { fetchUserTeams().then(() => setTimeout(renderTeams, 50)); }
    if (tabId === 'solicitudes') { loadSolicitudes(); loadInvitaciones(); }
  }

  tabs.forEach(tab => {
    tab.addEventListener('click', (e) => {
      e.preventDefault();
      switchTab(tab.dataset.tab);
    });
  });

  // ── Notifications toggle ──
  const notifToggle = document.getElementById('tec-notif-toggle');
  if (notifToggle) {
    notifToggle.checked = localStorage.getItem('tec_notifications') !== 'false';
    notifToggle.addEventListener('change', () => {
      localStorage.setItem('tec_notifications', notifToggle.checked);
    });
  }

  // ── Coach name ──
  const tecNameInput = document.getElementById('tec-name-input');
  if (tecNameInput) {
    tecNameInput.value = localStorage.getItem('tec_coachName') || '';
    tecNameInput.addEventListener('input', () => {
      localStorage.setItem('tec_coachName', tecNameInput.value);
    });
  }

  // ── On load: check already-inscribed tournaments ──
  (async function initInscriptionStates() {
    try {
      const res = await fetch('/api/invitations', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'listByUser' }),
      });
      const data = await res.json();
      if (data.success && data.invitations) {
        data.invitations.forEach(inv => {
          const btn = document.querySelector(`.tec-inscribir-btn[data-tourney="${inv.tournament_id}"]`);
          if (btn && !btn.disabled) {
            if (inv.status === 'accepted') {
              btn.textContent = 'YA INSCRITO';
              btn.disabled = true;
              btn.style.opacity = '.5';
            } else if (inv.status === 'pending') {
              btn.textContent = 'SOLICITUD ENVIADA';
              btn.disabled = true;
              btn.style.opacity = '.5';
            }
          }
        });
      }
    } catch (e) { /* ignore */ }
  })();

  // ── Tournament INSCRIBIRSE buttons (direct send, no modal) ──
  document.querySelectorAll('.tec-inscribir-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const tourneyId = btn.dataset.tourney;
      const tourneyName = btn.dataset.tourneyName || '';
      const teams = getTeams();
      if (teams.length === 0) {
        alert('Primero crea un equipo en la pestaña EQUIPOS.');
        switchTab('equipos');
        return;
      }
      btn.textContent = 'ENVIANDO...';
      btn.disabled = true;
      try {
        const res = await fetch('/api/invitations', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'create', tournamentId: tourneyId, teamId: teams[0].id }),
        });
        const data = await res.json();
        if (data.success) {
          btn.textContent = 'SOLICITUD ENVIADA';
          btn.style.opacity = '.5';
          alert('Solicitud enviada al administrador');
        } else {
          btn.textContent = 'INSCRIBIRSE';
          btn.disabled = false;
          alert(data.error || 'Error al enviar solicitud');
        }
      } catch {
        btn.textContent = 'INSCRIBIRSE';
        btn.disabled = false;
        alert('Error de red');
      }
    });
  });

  // ── Tournament card click → toggle details ──
  document.querySelectorAll('.tec-tourney-card').forEach(card => {
    card.addEventListener('click', (e) => {
      if (e.target.closest('.tec-inscribir-btn')) return;
      const details = card.querySelector('.tec-tourney-details');
      if (details) details.classList.toggle('hidden');
    });
  });

  // ── Equipos: Team Management ──
  const CREATION_COLORS = ['#00ff88','#f59e0b','#f87171','#a78bfa','#38bdf8','#e2ff5d','#ff6b6b','#c7a86b'];

  const _id = id => document.getElementById(id);

  function getTeams() {
    return JSON.parse(localStorage.getItem('tec_teams') || '[]');
  }

  function saveTeams(teams) {
    localStorage.setItem('tec_teams', JSON.stringify(teams));
  }

  function getActiveTeamId() {
    return localStorage.getItem('tec_activeTeam') || '';
  }

  function setActiveTeamId(id) {
    localStorage.setItem('tec_activeTeam', id);
  }

  function renderTeams() {
    const list = document.getElementById('equipos-list');
    if (!list) return;
    const teams = getTeams();
    const activeId = getActiveTeamId();
    const squad = JSON.parse(localStorage.getItem('tec_squad') || '[]');
    const squadCount = squad.length;

    if (!teams.length) {
      list.innerHTML = '<p class="tec-empty">Aún no tienes equipos. Crea uno para empezar.</p>';
      return;
    }

    list.innerHTML = teams.map(t => {
      const isActive = t.id === activeId;
      return `
        <div class="tec-equipo-card ${isActive ? 'tec-equipo-card--active' : ''}" data-team-id="${t.id}">
          <span class="hud-c hud-c--tl"></span><span class="hud-c hud-c--tr"></span>
          <span class="hud-c hud-c--bl"></span><span class="hud-c hud-c--br"></span>
          <span class="tec-equipo-check">${isActive ? '✓' : ''}</span>
          <div class="flex items-center gap-3">
            <div class="tec-equipo-avatar" style="background:${t.color}20;border-color:${t.color}55">
              ${t.logo ? `<img src="${t.logo}" alt="${t.name}" style="width:100%;height:100%;object-fit:cover;border-radius:10px" />` : `<span style="font-size:.9rem">${t.emoji || '🛡️'}</span>`}
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="tec-equipo-name">${t.name}</h3>
              <p class="tec-equipo-tourney">${t.tournament_name ? esc(t.tournament_name) : 'Sin torneo'}${isActive ? ' · ACTIVO' : ''}</p>
            </div>
            <div class="text-right">
              <span class="tec-equipo-count">${isActive ? squadCount : '-'}</span>
              <span class="tec-equipo-count-label">JUG</span>
            </div>
          </div>
          <button class="tec-equipo-delete" data-team-id="${t.id}" title="Eliminar equipo">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
          </button>
        </div>`;
    }).join('');

    list.querySelectorAll('.tec-equipo-card').forEach(card => {
      card.addEventListener('click', (e) => {
        if (e.target.closest('.tec-equipo-delete')) return;
        selectTeam(card.dataset.teamId);
      });
    });

    list.querySelectorAll('.tec-equipo-delete').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const teamId = btn.dataset.teamId;
        if (confirm('¿Eliminar este equipo? Se perderá la plantilla asociada.')) {
          deleteTeam(teamId);
        }
      });
    });
  }

  function selectTeam(teamId) {
    const teams = getTeams();
    const team = teams.find(t => t.id === teamId);
    if (!team) return;

    const currentSquad = JSON.parse(localStorage.getItem('tec_squad') || '[]');
    const currentInvites = JSON.parse(localStorage.getItem('tec_invites') || '[]');
    const activeId = getActiveTeamId();
    if (activeId) {
      const currentTeam = teams.find(t => t.id === activeId);
      if (currentTeam) {
        currentTeam.squad = currentSquad;
        currentTeam.invites = currentInvites;
      }
    }

    setActiveTeamId(teamId);

    localStorage.setItem('tec_teamName', team.name);
    localStorage.setItem('tec_teamColor', team.color);
    localStorage.setItem('tec_teamEmoji', team.emoji || '🛡️');
    localStorage.setItem('tec_teamLogo', team.logo || '');

    const savedSquad = team.squad || [];
    const savedInvites = team.invites || [];
    localStorage.setItem('tec_squad', JSON.stringify(savedSquad));
    localStorage.setItem('tec_invites', JSON.stringify(savedInvites));

    saveTeams(teams);
    location.reload();
  }

  function deleteTeam(teamId) {
    let teams = getTeams();
    const team = teams.find(t => t.id === teamId);
    const wasActive = getActiveTeamId() === teamId;

    if (team && team.tournament_id) {
      teams = teams.filter(t => t.id !== teamId);
      saveTeams(teams);
      fetch('/api/teams', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'removeFromTournament', id: teamId, tournamentId: team.tournament_id }),
      }).catch(() => {});
    } else {
      teams = teams.filter(t => t.id !== teamId);
      saveTeams(teams);
      fetch('/api/teams', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'delete', id: teamId }),
      }).catch(() => {});
    }

    if (wasActive) {
      localStorage.removeItem('tec_activeTeam');
      localStorage.setItem('tec_teamName', 'SIN NOMBRE');
      localStorage.setItem('tec_teamColor', '#00ff88');
      localStorage.setItem('tec_teamEmoji', '🛡️');
      localStorage.setItem('tec_teamLogo', '');
      localStorage.setItem('tec_squad', '[]');
      localStorage.setItem('tec_invites', '[]');

      if (teams.length > 0) {
        selectTeam(teams[0].id);
        return;
      }
      location.reload();
    } else {
      renderTeams();
    }
  }

  // ── Create team modal ──
  let newTeamLogo = '';
  let newTeamColor = '#00ff88';
  let currentTourneyId = '';
  let currentTourneyName = '';

  function updatePreview() {
    const name = _id('new-team-name').value.trim().toUpperCase() || 'NOMBRE';
    _id('preview-name').textContent = name;
    const previewEl = _id('create-preview');
    const logoWrap = _id('preview-logo');
    const previewImg = _id('preview-img');
    const fallback = _id('preview-fallback');

    if (newTeamLogo) {
      previewImg.src = newTeamLogo;
      previewImg.classList.remove('hidden');
      fallback.classList.add('hidden');
    } else {
      previewImg.classList.add('hidden');
      fallback.classList.remove('hidden');
    }

    if (previewEl) previewEl.style.borderColor = newTeamColor + '44';
    if (logoWrap) {
      logoWrap.style.borderColor = newTeamColor + '55';
      logoWrap.style.boxShadow = `0 0 18px ${newTeamColor}18`;
    }
  }

  async function handleLogoFile(file) {
    if (!file) return;
    if (file.size > 500 * 1024) {
      alert('La imagen es demasiado grande. Máximo 500KB.');
      return;
    }
    const formData = new FormData();
    formData.append('file', file);
    try {
      const res = await fetch('/api/teams/upload-logo', { method: 'POST', body: formData });
      const data = await res.json();
      if (!data.success) throw new Error(data.error || 'Error al subir imagen');
      newTeamLogo = data.url;
      _id('upload-placeholder').classList.add('hidden');
      _id('upload-preview-img').src = newTeamLogo;
      _id('upload-preview').classList.remove('hidden');
      updatePreview();
    } catch (err) {
      alert('Error al subir la imagen: ' + err.message);
    }
  }

  function resetUpload() {
    newTeamLogo = '';
    _id('upload-placeholder').classList.remove('hidden');
    _id('upload-preview').classList.add('hidden');
    _id('upload-preview-img').src = '';
    _id('logo-upload').value = '';
    updatePreview();
  }

  function openCreateModal(tourneyId, tourneyName) {
    try {
    currentTourneyId = tourneyId || '';
    currentTourneyName = tourneyName || '';

    newTeamLogo = '';
    newTeamColor = '#00ff88';
    _id('new-team-name').value = '';
    _id('new-team-category').selectedIndex = 0;
    resetUpload();

    document.querySelectorAll('#new-team-color-picker .tec-color-dot').forEach(b => {
      b.classList.toggle('active', b.dataset.color === newTeamColor);
    });

    updatePreview();

    // Setup modal for tournament inscription or standalone creation
    const inscSection = _id('inscripcion-section');
    const teamSelector = _id('team-selector');
    const sendWrap = _id('inscripcion-send-wrap');
    const btnSend = _id('btn-enviar-solicitud');
    const createFields = _id('new-team-name').closest('.flex.flex-col.gap-1');

    if (currentTourneyId) {
      const btn = document.querySelector(`.tec-inscribir-btn[data-tourney="${currentTourneyId}"]`);
      const current = parseInt(btn?.dataset.currentTeams || '0');
      const max = parseInt(btn?.dataset.maxTeams || '0');
      if (current >= max) {
        alert('Este torneo ya tiene el cupo completo de equipos.');
        return;
      }
      _id('modal-title').textContent = 'INSCRIBIR EQUIPO';
      _id('modal-subtitle').textContent = 'Torneo: ' + currentTourneyName;
      _id('inscripcion-tourney-label').textContent = currentTourneyName;
      inscSection.classList.remove('hidden');

      // Populate team selector
      const teams = getTeams();
      teamSelector.innerHTML = '<option value="">Seleccionar equipo...</option>';
      const available = teams.filter(t => t.tournament_id !== currentTourneyId);
      available.forEach(t => {
        const opt = document.createElement('option');
        opt.value = t.id;
        opt.textContent = t.name;
        teamSelector.appendChild(opt);
      });
      const optNew = document.createElement('option');
      optNew.value = '__new__';
      optNew.textContent = 'Crear nuevo equipo';
      teamSelector.appendChild(optNew);
      teamSelector.value = '';

      sendWrap.classList.add('hidden');
      if (createFields) createFields.classList.add('hidden');

      teamSelector.onchange = () => {
        const val = teamSelector.value;
        if (val === '__new__') {
          sendWrap.classList.add('hidden');
          if (createFields) createFields.classList.remove('hidden');
        } else if (val) {
          sendWrap.classList.remove('hidden');
          if (createFields) createFields.classList.add('hidden');
        } else {
          sendWrap.classList.add('hidden');
          if (createFields) createFields.classList.add('hidden');
        }
      };

      btnSend.onclick = async () => {
        const teamId = teamSelector.value;
        if (!teamId) return;
        btnSend.textContent = 'ENVIANDO...';
        btnSend.disabled = true;
        try {
          const res = await fetch('/api/invitations', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'create', tournamentId: currentTourneyId, teamId }),
          });
          const data = await res.json();
          if (data.success) {
            _id('modal-crear-equipo').classList.add('hidden');
            const btnInsc = document.querySelector(`.tec-inscribir-btn[data-tourney="${currentTourneyId}"]`);
            if (btnInsc) { btnInsc.textContent = 'SOLICITUD ENVIADA'; btnInsc.disabled = true; btnInsc.style.opacity = '.5'; }
            alert('Solicitud enviada al administrador');
          } else {
            alert(data.error || 'Error al enviar solicitud');
          }
        } catch {
          alert('Error de red');
        } finally {
          btnSend.textContent = 'ENVIAR SOLICITUD';
          btnSend.disabled = false;
        }
      };
    } else {
      inscSection.classList.add('hidden');
      _id('modal-title').textContent = 'CREAR EQUIPO';
      _id('modal-subtitle').textContent = 'Personaliza la identidad de tu equipo';
      if (createFields) createFields.classList.remove('hidden');
    }

    _id('modal-crear-equipo').classList.remove('hidden');
    } catch (e) { console.error('openCreateModal error:', e); alert('Error al abrir modal: ' + e.message); }
  }

  // Upload
  _id('upload-area').addEventListener('click', (e) => {
    if (e.target.closest('.tec-upload-remove')) return;
    _id('logo-upload').click();
  });
  _id('logo-upload').addEventListener('change', (e) => {
    handleLogoFile(e.target.files[0]);
  });
  _id('btn-remove-logo').addEventListener('click', (e) => {
    e.stopPropagation();
    resetUpload();
  });

  // Color picker
  document.querySelectorAll('#new-team-color-picker .tec-color-dot').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#new-team-color-picker .tec-color-dot').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      newTeamColor = btn.dataset.color;
      updatePreview();
    });
  });

  // Name input live preview
  _id('new-team-name').addEventListener('input', updatePreview);

  // Create button (standalone)
  _id('btn-crear-equipo').addEventListener('click', () => openCreateModal());

  // Save new team (API)
  _id('btn-save-new-team').addEventListener('click', async () => {
    const name = _id('new-team-name').value.trim();
    const category = _id('new-team-category').value;
    if (!name) return;
    if (!category) { alert('Selecciona una categoría'); return; }
    if (getTeams().length > 0) { alert('Ya tienes un equipo. Solo puedes tener un equipo.'); return; }

    const btn = _id('btn-save-new-team');
    btn.textContent = 'CREANDO...';
    btn.disabled = true;

    try {
      const res = await fetch('/api/teams', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'create',
          name,
          logo: newTeamLogo,
          color: newTeamColor,
          category,
        }),
      });
      const data = await res.json();
      if (!data.success) throw new Error(data.error || 'Error al crear equipo');

      const newId = data.id;

      // If inscribing to a tournament, send invitation after creating team
      if (currentTourneyId) {
        const invRes = await fetch('/api/invitations', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'create', tournamentId: currentTourneyId, teamId: newId }),
        });
        const invData = await invRes.json();
        if (!invData.success) throw new Error(invData.error || 'Error al enviar solicitud');
      }

      // Sync to localStorage
      const teams = getTeams();
      const newTeam = {
        id: newId,
        name: name,
        category: category,
        emoji: '🛡️',
        color: newTeamColor,
        logo: newTeamLogo,
        tournament_id: currentTourneyId || null,
        squad: [],
        invites: [],
      };
      teams.push(newTeam);
      saveTeams(teams);
      if (!currentTourneyId) selectTeam(newId);
      _id('modal-crear-equipo').classList.add('hidden');
      fetchUserTeams();
      if (currentTourneyId) {
        const btnInsc = document.querySelector(`.tec-inscribir-btn[data-tourney="${currentTourneyId}"]`);
        if (btnInsc) { btnInsc.textContent = 'SOLICITUD ENVIADA'; btnInsc.disabled = true; btnInsc.style.opacity = '.5'; }
        alert('Equipo creado y solicitud enviada al administrador');
      } else alert('Equipo creado correctamente');
    } catch (err) {
      alert('Error: ' + err.message);
    } finally {
      btn.textContent = 'CREAR EQUIPO';
      btn.disabled = false;
    }
  });

  // Modal close
  document.querySelectorAll('[data-close]').forEach(btn => {
    btn.addEventListener('click', () => {
      if (btn.dataset.close === 'modal-crear-equipo') {
        _id('modal-crear-equipo').classList.add('hidden');
      }
    });
  });
  document.querySelectorAll('.tec-overlay').forEach(ov => {
    ov.addEventListener('click', e => { if (e.target === ov) ov.classList.add('hidden'); });
  });

  // ── Fetch user teams from API ──
  async function fetchUserTeams() {
    try {
      const res = await fetch('/api/teams', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'listByUser' }),
      });
      const data = await res.json();
      if (data.success && data.teams) {
        const localTeams = getTeams();
        const apiIds = new Set(data.teams.map(t => t.id));
        const kept = localTeams.filter(t => !apiIds.has(t.id));
        const merged = [...data.teams.map(t => ({
          id: t.id,
          name: t.name,
          category: t.category || '',
          tournament_name: t.tournament_name || null,
          tournament_id: t.tournament_id || null,
          emoji: '🛡️',
          color: t.color || '#00ff88',
          logo: t.logo || '',
          squad: [],
          invites: [],
        })), ...kept];
        saveTeams(merged);
        renderTeams();
      }
    } catch {}
  }

  // ── SOLICITUDES ──
  const FIFA_POS = {GK:'Portero',CB:'Defensa Central',LB:'Lateral Izquierdo',RB:'Lateral Derecho',LWB:'Carrilero Izquierdo',RWB:'Carrilero Derecho',CDM:'Medio Defensivo',CM:'Medio Centro',CAM:'Medio Ofensivo',LM:'Medio Izquierdo',RM:'Medio Derecho',LW:'Extremo Izquierdo',RW:'Extremo Derecho',CF:'Segundo Delantero',ST:'Delantero Centro'};

  async function loadSolicitudes() {
    const container = document.getElementById('solicitudes-list');
    if (!container) return;
    container.innerHTML = '<p class="tec-empty">Cargando solicitudes...</p>';
    try {
      const res = await fetch('/api/team-requests');
      const data = await res.json();
      if (!data.success || !data.requests) {
        container.innerHTML = '<p class="tec-empty">Error al cargar solicitudes</p>';
        return;
      }
      const requests = (data.requests || []).filter(r => r.type !== 'invite');
      if (!requests.length) {
        container.innerHTML = '<p class="tec-empty">No hay solicitudes de jugadores</p>';
        return;
      }
      container.innerHTML = requests.map(r => {
        const statusClass = r.status === 'pending' ? 'tec-invite-status--pending' : r.status === 'accepted' ? 'tec-invite-status--accepted' : '';
        const statusText = r.status === 'pending' ? 'PENDIENTE' : r.status === 'accepted' ? 'ACEPTADA' : 'RECHAZADA';
        const posLabel = FIFA_POS[r.player_position] || r.player_position || 'Sin posición';
        const ageText = r.player_age ? `${r.player_age} años` : '';
        return `
          <div class="tec-search-result" style="flex-wrap:wrap">
            <div class="tec-search-avatar" style="background:${r.team_color || '#00ff88'}22;border-color:${r.team_color || '#00ff88'}44">
              ${r.player_image ? `<img src="${r.player_image}" style="width:100%;height:100%;object-fit:cover;border-radius:9px" />` : '👤'}
            </div>
            <div class="flex-1 min-w-0" style="min-width:120px">
              <div style="font-family:var(--font-display);font-size:.55rem;font-weight:600;letter-spacing:.06em;color:var(--cream)">${esc(r.player_name)}</div>
              <div style="font-size:.4rem;letter-spacing:.1em;color:rgba(232,220,200,.25);text-transform:uppercase;margin-top:.05rem">${posLabel}${ageText ? ' · ' + ageText : ''}</div>
              <div style="font-size:.38rem;letter-spacing:.08em;color:rgba(232,220,200,.15);margin-top:.05rem">Equipo: ${esc(r.team_name)}</div>
            </div>
            ${r.status === 'pending' ? `
              <div style="display:flex;gap:.35rem;width:100%;margin-top:.3rem">
                <button class="solicitud-btn solicitud-btn--accept" data-id="${r.id}" style="flex:1;padding:.3rem;border-radius:6px;font-family:var(--font-display);font-size:.4rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;cursor:pointer;border:1px solid rgba(52,211,153,.3);color:#34d399;background:rgba(52,211,153,.06);transition:all .2s">ACEPTAR</button>
                <button class="solicitud-btn solicitud-btn--reject" data-id="${r.id}" style="flex:1;padding:.3rem;border-radius:6px;font-family:var(--font-display);font-size:.4rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;cursor:pointer;border:1px solid rgba(239,68,68,.3);color:#ef4444;background:rgba(239,68,68,.06);transition:all .2s">RECHAZAR</button>
              </div>
            ` : `<span class="tec-invite-status ${statusClass}" style="margin-left:auto">${statusText}</span>`}
          </div>
        `
      }).join('');

      container.querySelectorAll('.solicitud-btn--accept').forEach(btn => {
        btn.addEventListener('click', () => respondSolicitud(btn.dataset.id, 'accepted'));
      });
      container.querySelectorAll('.solicitud-btn--reject').forEach(btn => {
        btn.addEventListener('click', () => respondSolicitud(btn.dataset.id, 'rejected'));
      });
    } catch {
      container.innerHTML = '<p class="tec-empty">Error de red</p>';
    }
  }

  // ── Tournament invitations (admin → tecnico) ──
  async function loadInvitaciones() {
    const container = document.getElementById('invitaciones-list');
    if (!container) return;
    container.innerHTML = '<p class="tec-empty">Cargando invitaciones...</p>';
    try {
      const res = await fetch('/api/invitations', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'listByUser' }),
      });
      const data = await res.json();
      if (!data.success || !data.invitations) {
        container.innerHTML = '<p class="tec-empty">Error al cargar invitaciones</p>';
        return;
      }
      const pending = data.invitations.filter(inv => inv.status === 'pending');
      if (!pending.length) {
        container.innerHTML = '<p class="tec-empty">No hay invitaciones pendientes</p>';
        return;
      }
      container.innerHTML = pending.map(inv => `
        <div class="tec-search-result" style="flex-wrap:wrap">
          <div class="tec-search-avatar" style="background:${inv.team_color || '#00ff88'}22;border-color:${inv.team_color || '#00ff88'}44">
            🏆
          </div>
          <div class="flex-1 min-w-0" style="min-width:120px">
            <div style="font-family:var(--font-display);font-size:.55rem;font-weight:600;letter-spacing:.06em;color:var(--cream)">${esc(inv.tournament_name)}</div>
            <div style="font-size:.4rem;letter-spacing:.1em;color:rgba(232,220,200,.25);text-transform:uppercase;margin-top:.05rem">Equipo: ${esc(inv.team_name)}</div>
          </div>
          <div style="display:flex;gap:.35rem;width:100%;margin-top:.3rem">
            <button class="invitacion-btn--accept" data-id="${inv.id}" style="flex:1;padding:.3rem;border-radius:6px;font-family:var(--font-display);font-size:.4rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;cursor:pointer;border:1px solid rgba(52,211,153,.3);color:#34d399;background:rgba(52,211,153,.06);transition:all .2s">ACEPTAR</button>
            <button class="invitacion-btn--reject" data-id="${inv.id}" style="flex:1;padding:.3rem;border-radius:6px;font-family:var(--font-display);font-size:.4rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;cursor:pointer;border:1px solid rgba(239,68,68,.3);color:#ef4444;background:rgba(239,68,68,.06);transition:all .2s">RECHAZAR</button>
          </div>
        </div>
      `).join('');

      container.querySelectorAll('.invitacion-btn--accept').forEach(btn => {
        btn.addEventListener('click', () => respondInvitacion(btn.dataset.id, 'accept'));
      });
      container.querySelectorAll('.invitacion-btn--reject').forEach(btn => {
        btn.addEventListener('click', () => respondInvitacion(btn.dataset.id, 'reject'));
      });
    } catch {
      container.innerHTML = '<p class="tec-empty">Error de red</p>';
    }
  }

  async function respondInvitacion(id, action) {
    const btns = document.querySelectorAll(`[data-id="${id}"]`);
    btns.forEach(b => { b.disabled = true; b.textContent = '...'; });
    try {
      const res = await fetch('/api/invitations', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action, id }),
      });
      const data = await res.json();
      if (data.success) {
        loadInvitaciones();
      } else {
        alert(data.error || 'Error al responder');
        btns.forEach(b => { b.disabled = false; b.textContent = action === 'accept' ? 'ACEPTAR' : 'RECHAZAR'; });
      }
    } catch {
      alert('Error de red');
      btns.forEach(b => { b.disabled = false; b.textContent = action === 'accept' ? 'ACEPTAR' : 'RECHAZAR'; });
    }
  }

  async function respondSolicitud(id, status) {
    const btns = document.querySelectorAll(`.solicitud-btn[data-id="${id}"]`);
    btns.forEach(b => { b.disabled = true; b.textContent = '...'; });
    try {
      const res = await fetch('/api/team-requests', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'respond', id, status }),
      });
      const data = await res.json();
      if (data.success) {
        loadSolicitudes();
        updateNotifBadge();
      } else {
        alert(data.error || 'Error al responder');
        btns.forEach(b => { b.disabled = false; b.textContent = status === 'accepted' ? 'ACEPTAR' : 'RECHAZAR'; });
      }
    } catch {
      alert('Error de red');
      btns.forEach(b => { b.disabled = false; b.textContent = status === 'accepted' ? 'ACEPTAR' : 'RECHAZAR'; });
    }
  }

  // ── Notification Badge ──
  async function updateNotifBadge() {
    const solicitudesTab = document.querySelector('#bottomNav .list[data-tab="solicitudes"]');
    if (!solicitudesTab) return;
    try {
      const res = await fetch('/api/notifications');
      const data = await res.json();
      if (!data.success) return;
      const unread = data.unread || 0;
      let badge = solicitudesTab.querySelector('.notif-badge');
      if (unread > 0) {
        if (!badge) {
          badge = document.createElement('span');
          badge.className = 'notif-badge';
          badge.style.cssText = 'position:absolute;top:2px;right:2px;background:#ef4444;color:#fff;font-size:.35rem;font-weight:700;font-family:monospace;min-width:16px;height:16px;border-radius:8px;display:flex;align-items:center;justify-content:center;padding:0 4px;box-shadow:0 0 8px rgba(239,68,68,.4)';
          solicitudesTab.querySelector('a')?.appendChild(badge);
        }
        badge.textContent = unread > 9 ? '9+' : unread;
      } else if (badge) {
        badge.remove();
      }
    } catch {}
  }

  // Poll notifications every 15 seconds
  setInterval(updateNotifBadge, 15000);

  // ── Refresh button ──
  document.getElementById('solicitudes-refresh')?.addEventListener('click', loadSolicitudes);

  // ── Logout ──
  document.getElementById('tec-logout-btn')?.addEventListener('click', async () => {
    await fetch('/api/auth/logout', { method: 'POST' });
    window.location.href = '/login';
  });

  // ── Init: migrate legacy data if needed ──
  const existingTeams = getTeams();
  if (!existingTeams.length) {
    const legacyName = localStorage.getItem('tec_teamName');
    if (legacyName && legacyName !== 'SIN NOMBRE') {
      const legacyTeam = {
        id: 'team_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6),
        name: legacyName,
        emoji: localStorage.getItem('tec_teamEmoji') || '🛡️',
        color: localStorage.getItem('tec_teamColor') || '#00ff88',
        logo: localStorage.getItem('tec_teamLogo') || '',
        squad: JSON.parse(localStorage.getItem('tec_squad') || '[]'),
        invites: JSON.parse(localStorage.getItem('tec_invites') || '[]'),
      };
      saveTeams([legacyTeam]);
      setActiveTeamId(legacyTeam.id);
    }
  }

  // ── Init: fetch teams from API on load ──
  fetchUserTeams();
  renderTeams();
  updateNotifBadge();
})();
</script>
