---
const COLORS = ['#00ff88','#f59e0b','#f87171','#a78bfa','#38bdf8','#e2ff5d','#ff6b6b','#c7a86b'];
---

<div class="tec-scroll-content">

  <!-- ═══ HERO CARD ═══ -->
  <div class="tec-hero-card" id="team-hero-card">
    <span class="hud-c hud-c--tl"></span>
    <span class="hud-c hud-c--tr"></span>
    <span class="hud-c hud-c--bl"></span>
    <span class="hud-c hud-c--br"></span>
    <div class="tec-hero-glow" id="team-hero-glow"></div>
    <div class="tec-hero-badge"></div>

    <div class="relative z-10 flex items-start gap-4 mb-5">
      <div class="tec-logo-wrap" id="team-logo-wrap">
        <span class="text-4xl leading-none" id="team-logo-emoji">🛡️</span>
        <button class="absolute -right-2.5 -bottom-2.5 w-6 h-6 rounded-full flex items-center justify-center text-xs cursor-pointer transition-transform hover:scale-110" style="background:var(--gold);color:var(--midnight);border:2px solid rgba(0,0,0,.3);box-shadow:0 0 10px rgba(251,191,36,.2)" id="btn-change-logo" title="Cambiar logo">✏️</button>
      </div>

      <div class="flex-1 min-w-0">
        <p class="tec-label mb-1">NOMBRE DEL EQUIPO</p>
        <div class="flex items-center gap-2 mb-3">
          <h2 class="tec-team-name" id="team-name-display">SIN NOMBRE</h2>
          <button class="tec-icon-btn" id="btn-edit-name" title="Editar">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          </button>
        </div>

        <p class="tec-label mb-1.5">COLOR DEL EQUIPO</p>
        <div class="flex flex-wrap gap-1.5">
          {COLORS.map(c => (
            <button class="tec-color-dot" data-color={c} style={`background:${c}`} title={c}></button>
          ))}
        </div>
      </div>
    </div>

    <div class="relative z-10 grid grid-cols-4 gap-3 pt-4 border-t border-white/[0.06]">
      {[
        { label:'JUGADORES', id:'stat-players', val:'0', bar: '0%' },
        { label:'VICTORIAS', id:'stat-wins',    val:'0', bar: '0%' },
        { label:'GOLES',     id:'stat-goals',   val:'0', bar: '0%' },
        { label:'RANKING',   id:'stat-rank',    val:'—', bar: '0%' },
      ].map(s => (
        <div class="flex flex-col items-center gap-1">
          <span class="tec-stat-val" id={s.id}>{s.val}</span>
          <span class="tec-stat-label">{s.label}</span>
          <div class="tec-stat-bar">
            <div class="tec-stat-bar-fill" id={`${s.id}-bar`} style="width:0%"></div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- ══════ PLANTILLA ══════ -->
  <div class="flex items-center justify-between mt-6 mb-3">
    <p class="tec-section-label !mb-0">PLANTILLA</p>
    <span class="tec-chip" id="squad-count">0 / 20</span>
  </div>
  <div class="flex flex-col gap-2" id="squad-list">
    <p class="tec-empty">Aún no hay jugadores. Invítalos desde buscador.</p>
  </div>

  <!-- ══════ BUSCAR E INVITAR ══════ -->
  <div class="tec-card mt-6">
    <span class="hud-c hud-c--tl"></span>
    <span class="hud-c hud-c--tr"></span>
    <p class="tec-section-label mb-3">BUSCAR JUGADORES</p>
    <div class="relative">
      <svg class="absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="rgba(251,191,36,.4)" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      <input id="player-search" type="text" placeholder="Buscar por nombre…" class="tec-input pl-9" autocomplete="off" />
    </div>
    <div class="flex flex-col gap-2 mt-3" id="search-results">
      <p class="tec-empty">Escribe para buscar jugadores disponibles.</p>
    </div>
  </div>

  <p class="tec-section-label mt-6 mb-3">INVITACIONES ENVIADAS</p>
  <div class="flex flex-col gap-2" id="invites-list">
    <p class="tec-empty">No hay invitaciones pendientes.</p>
  </div>

</div>

<!-- ══════ MODAL: NOMBRE ══════ -->
<div id="modal-name" class="tec-overlay hidden">
  <div class="tec-modal">
    <span class="hud-c hud-c--tl"></span><span class="hud-c hud-c--tr"></span>
    <span class="hud-c hud-c--bl"></span><span class="hud-c hud-c--br"></span>
    <div class="p-5 border-b border-white/[0.06]">
      <h3 class="tec-modal-title">EDITAR NOMBRE</h3>
    </div>
    <div class="p-5">
      <label class="tec-field-label mb-1.5 block" for="team-name-input">NOMBRE</label>
      <input id="team-name-input" type="text" maxlength="30" placeholder="Ej: Los Vikingos" class="tec-input" />
    </div>
    <div class="flex gap-2.5 justify-end px-5 pb-5">
      <button class="tec-btn-ghost" data-close="modal-name">CANCELAR</button>
      <button class="tec-btn-primary" id="btn-save-name">GUARDAR</button>
    </div>
  </div>
</div>

<style is:global>
  #squad-list .overflow-x-auto::-webkit-scrollbar { height: 3px; }
  #squad-list .overflow-x-auto::-webkit-scrollbar-track { background: transparent; }
  #squad-list .overflow-x-auto::-webkit-scrollbar-thumb {
    background: rgba(0,255,136,.2);
    border-radius: 2px;
  }

  .squad-pcard-corner {
    position: absolute;
    width: 10px; height: 10px;
    border-color: rgba(212, 175, 55, 0.5);
    border-style: solid;
    transition: width 0.3s, height 0.3s, border-color 0.3s, box-shadow 0.3s;
    z-index: 9;
    pointer-events: none;
  }
  .squad-pcard-corner--tl { top: 5px; left: 5px;  border-width: 1.5px 0 0 1.5px; }
  .squad-pcard-corner--tr { top: 5px; right: 5px;  border-width: 1.5px 1.5px 0 0; }
  .squad-pcard-corner--bl { bottom: 5px; left: 5px;  border-width: 0 0 1.5px 1.5px; }
  .squad-pcard-corner--br { bottom: 5px; right: 5px;  border-width: 0 1.5px 1.5px 0; }
  .group:hover .squad-pcard-corner {
    width: 15px; height: 15px;
    border-color: #00ff88;
    box-shadow: 0 0 10px #00ff88;
  }

  .squad-pcard-lightning {
    position: absolute;
    top: 0; bottom: 0;
    width: 2px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
    z-index: 3;
  }
  .squad-pcard-lightning--l {
    left: 0;
    background: linear-gradient(180deg, transparent, rgba(0,255,136,0.6), transparent);
  }
  .squad-pcard-lightning--r {
    right: 0;
    background: linear-gradient(180deg, transparent, rgba(124,58,237,0.6), transparent);
  }
  .group:hover .squad-pcard-lightning { opacity: 1; }

  .squad-pcard-glow {
    position: absolute; inset: 0;
    background: radial-gradient(ellipse at 50% 20%, rgba(0,255,136,0.18) 0%, transparent 65%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
    z-index: 4;
  }
  .group:hover .squad-pcard-glow { opacity: 1; }

  .squad-pcard-divider {
    width: 1.2rem;
    height: 1px;
    background: rgba(0,255,136,0.5);
    margin: 0 auto 0.2rem;
    box-shadow: 0 0 6px rgba(0,255,136,0.4);
    transition: width 0.3s, background 0.3s;
  }
  .group:hover .squad-pcard-divider {
    width: 2rem;
    background: #00ff88;
    box-shadow: 0 0 10px #00ff88;
  }

  .squad-pcard-border {
    position: absolute; inset: 0;
    border-radius: 10px;
    border: 1px solid rgba(212, 175, 55, 0.25);
    transition: border-color 0.3s, box-shadow 0.3s;
    z-index: 8;
    pointer-events: none;
  }
  .group:hover .squad-pcard-border {
    border-color: #00ff88;
    box-shadow: 0 0 0 1px #00ff88, inset 0 0 20px rgba(0,255,136,0.08), 0 0 30px rgba(0,255,136,0.25);
  }
</style>

<script data-astro-rerun>
(function(){
  const COLORS = ['#00ff88','#f59e0b','#f87171','#a78bfa','#38bdf8','#e2ff5d','#ff6b6b','#c7a86b'];
  const FIFA_POS = {GK:'Portero',CB:'Defensa Central',LB:'Lateral Izquierdo',RB:'Lateral Derecho',LWB:'Carrilero Izquierdo',RWB:'Carrilero Derecho',CDM:'Medio Defensivo',CM:'Medio Centro',CAM:'Medio Ofensivo',LM:'Medio Izquierdo',RM:'Medio Derecho',LW:'Extremo Izquierdo',RW:'Extremo Derecho',CF:'Segundo Delantero',ST:'Delantero Centro'};

  const state = {
    teamName:  localStorage.getItem('tec_teamName')  || 'SIN NOMBRE',
    teamColor: localStorage.getItem('tec_teamColor') || '#00ff88',
    teamEmoji: localStorage.getItem('tec_teamEmoji') || '🛡️',
    teamLogo:  localStorage.getItem('tec_teamLogo')  || '',
  };

  function getActiveTeamId() {
    let id = localStorage.getItem('tec_activeTeam');
    if (!id) {
      const teams = JSON.parse(localStorage.getItem('tec_teams') || '[]');
      if (teams.length > 0) {
        id = teams[0].id;
        localStorage.setItem('tec_activeTeam', id);
      }
    }
    return id || '';
  }

  function getActiveTeam() {
    const activeId = getActiveTeamId();
    if (!activeId) return null;
    const teams = JSON.parse(localStorage.getItem('tec_teams') || '[]');
    return teams.find(t => t.id === activeId) || null;
  }

  function isTeamInTournament() {
    const team = getActiveTeam();
    return team && team.tournament_id ? true : false;
  }

  async function syncToApi() {
    const teamId = getActiveTeamId();
    if (!teamId) return;
    await fetch('/api/teams', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'update', id: teamId, name: state.teamName, logo: state.teamLogo, color: state.teamColor }),
    }).catch(() => {});
  }

  function save(){
    localStorage.setItem('tec_teamName',  state.teamName);
    localStorage.setItem('tec_teamColor', state.teamColor);
    localStorage.setItem('tec_teamEmoji', state.teamEmoji);
    localStorage.setItem('tec_teamLogo',  state.teamLogo);
  }

  function syncToTeams() {
    const activeId = getActiveTeamId();
    if (!activeId) return;
    const teams = JSON.parse(localStorage.getItem('tec_teams') || '[]');
    const idx = teams.findIndex(t => t.id === activeId);
    if (idx === -1) return;
    teams[idx].name = state.teamName;
    teams[idx].emoji = state.teamEmoji;
    teams[idx].logo = state.teamLogo;
    teams[idx].color = state.teamColor;
    localStorage.setItem('tec_teams', JSON.stringify(teams));
  }

  const $ = id => document.getElementById(id);
  function esc(str) { const d = document.createElement('div'); d.textContent = str; return d.innerHTML; }

  function renderHero(){
    $('team-name-display').textContent = state.teamName;

    const inTournament = isTeamInTournament();
    const logoEmoji = $('team-logo-emoji');
    if (state.teamLogo) {
      logoEmoji.innerHTML = `<img src="${state.teamLogo}" alt="${state.teamName}" style="width:100%;height:100%;object-fit:cover;border-radius:inherit" />`;
    } else {
      logoEmoji.textContent = state.teamEmoji;
    }

    // Lock editing if team is in a tournament
    const editNameBtn = $('btn-edit-name');
    const changeLogoBtn = $('btn-change-logo');
    const colorDots = document.querySelectorAll('.tec-color-dot');
    if (inTournament) {
      if (editNameBtn) editNameBtn.style.display = 'none';
      if (changeLogoBtn) changeLogoBtn.style.display = 'none';
      colorDots.forEach(b => { b.style.pointerEvents = 'none'; b.style.opacity = '0.3'; });
      let badge = $('tournament-badge');
      if (!badge) {
        const nameEl = $('team-name-display');
        if (nameEl) {
          badge = document.createElement('span');
          badge.id = 'tournament-badge';
          badge.textContent = '🔒 EN TORNEO';
          badge.style.cssText = 'display:inline-block;font-size:.38rem;font-weight:700;letter-spacing:.12em;color:#f59e0b;border:1px solid rgba(251,191,36,.25);background:rgba(251,191,36,.08);border-radius:4px;padding:.1rem .35rem;margin-left:.4rem;vertical-align:middle';
          nameEl.parentNode?.appendChild(badge);
        }
      }
    } else {
      if (editNameBtn) editNameBtn.style.display = '';
      if (changeLogoBtn) changeLogoBtn.style.display = '';
      colorDots.forEach(b => { b.style.pointerEvents = ''; b.style.opacity = ''; });
      const badge = $('tournament-badge');
      if (badge) badge.remove();
    }

    const glow = $('team-hero-glow');
    if(glow) glow.style.background = `radial-gradient(ellipse at 25% 35%,${state.teamColor}15,transparent 65%)`;

    const logoWrap = $('team-logo-wrap');
    if(logoWrap){
      logoWrap.style.borderColor = state.teamColor + '55';
      logoWrap.style.boxShadow   = `0 0 30px ${state.teamColor}15, inset 0 0 20px ${state.teamColor}05`;
    }

    colorDots.forEach(b => {
      b.classList.toggle('active', b.dataset.color === state.teamColor);
    });
  }

  document.querySelectorAll('.tec-color-dot').forEach(btn => {
    btn.addEventListener('click', () => {
      if (isTeamInTournament()) { alert('No puedes cambiar el color mientras el equipo esté en un torneo'); return; }
      state.teamColor = btn.dataset.color; save(); syncToTeams(); syncToApi(); renderHero();
    });
  });

  $('btn-edit-name').addEventListener('click', () => {
    if (isTeamInTournament()) { alert('No puedes cambiar el nombre mientras el equipo esté en un torneo'); return; }
    $('team-name-input').value = state.teamName;
    $('modal-name').classList.remove('hidden');
  });

  $('btn-save-name').addEventListener('click', () => {
    const v = $('team-name-input').value.trim();
    if(v){ state.teamName = v; save(); syncToTeams(); syncToApi(); renderHero(); }
    $('modal-name').classList.add('hidden');
  });

  // ── Logo upload ──
  const logoInput = document.createElement('input');
  logoInput.type = 'file';
  logoInput.accept = 'image/*';
  logoInput.style.display = 'none';
  document.body.appendChild(logoInput);

  logoInput.addEventListener('change', (e) => {
    const file = e.target.files[0];
    if (!file) return;
    if (file.size > 500 * 1024) { alert('Máximo 500KB'); return; }
    const reader = new FileReader();
    reader.onload = (ev) => {
      state.teamLogo = ev.target.result;
      save(); syncToTeams(); syncToApi(); renderHero();
    };
    reader.readAsDataURL(file);
  });

  $('btn-change-logo').addEventListener('click', () => {
    if (isTeamInTournament()) { alert('No puedes cambiar el logo mientras el equipo esté en un torneo'); return; }
    logoInput.click();
  });

  // ── Fetch squad from API ──
  async function loadSquad() {
    const list = $('squad-list');
    const teamId = getActiveTeamId();
    if (!teamId) {
      list.innerHTML = '<p class="tec-empty">Aún no tienes un equipo. Crea uno en EQUIPOS.</p>';
      $('squad-count').textContent = '0 / 20';
      return;
    }
    try {
      const res = await fetch(`/api/team-requests?teamId=${teamId}&scope=squad`);
      const data = await res.json();
      if (!data.success || !data.squad) {
        list.innerHTML = '<p class="tec-empty">Error al cargar plantilla</p>';
        return;
      }
      const squad = data.squad;

      // Save mapped squad to localStorage for PartidoManager
      const POS_EMOJI = {GK:'🧤',CB:'🛡️',LB:'🛡️',RB:'🛡️',LWB:'🛡️',RWB:'🛡️',CDM:'⚙️',CM:'⚙️',CAM:'🎯',LM:'⚡',RM:'⚡',LW:'⚡',RW:'⚡',CF:'🎯',ST:'⚔️'};
      localStorage.setItem('tec_squad', JSON.stringify(squad.map(s => ({
        id: s.id,
        name: s.player_name,
        pos: s.player_position || '—',
        emoji: POS_EMOJI[s.player_position] || '👤',
        player_id: s.player_id,
        player_image: s.player_image || '',
        player_image_card: s.player_image_card || '',
      }))));

      $('squad-count').textContent = `${squad.length} / 20`;
      $('stat-players').textContent = squad.length;
      const pct = Math.min(squad.length / 20 * 100, 100);
      const bar = document.getElementById('stat-players-bar');
      if(bar) bar.style.width = pct + '%';

      if (!squad.length) {
        list.innerHTML = '<p class="tec-empty">Aún no hay jugadores. Invítalos desde el buscador.</p>';
        return;
      }

      const inTournament = isTeamInTournament();

      function cardHTML(p) {
        const posLabel = FIFA_POS[p.player_position] || p.player_position || '—';
        return `
          <div class="group relative flex-none w-36 rounded-[10px] overflow-hidden cursor-default transition-transform duration-300 hover:-translate-y-1 hover:scale-[1.02] aspect-[3/4]">
            <div class="squad-pcard-border"></div>
            <span class="squad-pcard-corner squad-pcard-corner--tl"></span>
            <span class="squad-pcard-corner squad-pcard-corner--tr"></span>
            <span class="squad-pcard-corner squad-pcard-corner--bl"></span>
            <span class="squad-pcard-corner squad-pcard-corner--br"></span>
            <div class="absolute inset-0 bg-gradient-to-b from-[#061a0e] to-[#030d07]">
              <img src="/images/fighters/cards/jugador_mistery_card.png" alt="${esc(p.player_name)}" class="w-full h-full object-cover object-top saturate-[.88] brightness-[.92] transition-all duration-[0.45s] group-hover:scale-105 group-hover:saturate-[1.05] group-hover:brightness-100" loading="lazy" />
              <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent via-30% to-[rgba(0,10,5,0.55)] to-[rgba(0,8,4,0.97)] pointer-events-none"></div>
            <a href="/player/${p.player_id}" class="absolute top-1 right-1 z-20 w-5 h-5 rounded-full bg-black/60 border border-white/20 flex items-center justify-center hover:bg-[#00ff88] hover:border-[#00ff88] transition-colors" title="Ver perfil">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-white"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </a>
              <div class="squad-pcard-lightning squad-pcard-lightning--l"></div>
              <div class="squad-pcard-lightning squad-pcard-lightning--r"></div>
            </div>
            <div class="squad-pcard-glow"></div>
            ${!inTournament ? `<button class="kick-btn absolute top-1 left-1 z-20 w-5 h-5 rounded-full bg-black/60 border border-white/20 flex items-center justify-center hover:bg-[#ef4444] hover:border-[#ef4444] transition-colors" data-id="${p.id}" data-name="${esc(p.player_name)}" title="Eliminar jugador"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" class="text-white"><path d="M18 6L6 18"/><path d="M6 6l12 12"/></svg></button>` : ''}
            <div class="absolute bottom-0 left-0 right-0 p-1.5 text-center z-10">
              <div class="squad-pcard-divider"></div>
              <span class="block font-cinzel text-[.45rem] font-bold tracking-wider text-[var(--color-theme-cream)] uppercase truncate drop-shadow-[0_0_12px_rgba(0,0,0,0.9)] transition-colors duration-300 group-hover:text-white">${esc(p.player_name)}</span>
              <span class="block font-cinzel text-[.35rem] tracking-widest text-white/55 uppercase truncate mt-px">${esc(posLabel)}${p.player_age ? ' · ' + p.player_age : ''}</span>
            </div>
          </div>
        `;
      }

      list.innerHTML = `<div class="flex gap-2.5 overflow-x-auto snap-x snap-mandatory pb-1 squad-row">${squad.map(cardHTML).join('')}</div>`;

      if (!inTournament) {
        list.querySelectorAll('.kick-btn').forEach(btn => {
          btn.addEventListener('click', () => kickPlayer(btn.dataset.id, btn.dataset.name));
        });
      }
    } catch {
      list.innerHTML = '<p class="tec-empty">Error de red</p>';
    }
  }

  // ── Search players from API ──
  let searchTimeout = null;
  $('player-search').addEventListener('input', e => {
    clearTimeout(searchTimeout);
    const q = e.target.value.trim();
    const res = $('search-results');
    if (!q) { res.innerHTML = '<p class="tec-empty">Escribe para buscar jugadores disponibles.</p>'; return; }
    searchTimeout = setTimeout(() => searchPlayers(q), 300);
  });

  async function searchPlayers(q) {
    const res = $('search-results');
    const teamId = getActiveTeamId();
    if (!teamId) {
      res.innerHTML = '<p class="tec-empty">Crea un equipo primero en la pestaña EQUIPOS.</p>';
      return;
    }
    try {
      const response = await fetch('/api/players', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'search', q }),
      });
      const data = await response.json();
      if (!data.success) {
        res.innerHTML = '<p class="tec-empty">Error al buscar</p>';
        return;
      }
      const players = data.players || [];

      if (!players.length) {
        res.innerHTML = '<p class="tec-empty">Sin resultados.</p>';
        return;
      }

      const squadRes = await fetch(`/api/team-requests?teamId=${teamId}&scope=squad`);
      const squadData = await squadRes.json();
      const squadPlayerIds = new Set((squadData.squad || []).map(s => s.player_id));

      res.innerHTML = players.map(p => {
        const posLabel = FIFA_POS[p.position] || p.position || '—';
        const alreadyInTeam = squadPlayerIds.has(p.id);
        return `
          <div class="tec-search-result">
            <div class="tec-search-avatar">${p.image_big ? `<img src="${p.image_big}" style="width:100%;height:100%;object-fit:cover;border-radius:9px" />` : '👤'}</div>
            <div class="flex-1 min-w-0">
              <p style="font-size:.65rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--cream)">${esc(p.name)}</p>
              <p style="font-size:.45rem;letter-spacing:.12em;text-transform:uppercase;color:rgba(251,191,36,.5)">${esc(posLabel)}${p.age ? ' · ' + p.age + ' años' : ''}</p>
            </div>
            ${alreadyInTeam
              ? '<span style="font-family:var(--font-display);font-size:.4rem;font-weight:600;letter-spacing:.08em;color:#34d399;border:1px solid rgba(52,211,153,.25);background:rgba(6,78,59,.6);border-radius:6px;padding:.12rem .5rem">✓ EN PLANTILLA</span>'
              : `<button class="tec-invite-btn" data-player-id="${p.id}" data-player-name="${esc(p.name)}">INVITAR</button>`
            }
          </div>
        `;
      }).join('');

      res.querySelectorAll('.tec-invite-btn').forEach(btn => {
        btn.addEventListener('click', () => invitePlayer(btn.dataset.playerId, btn.dataset.playerName, btn));
      });
    } catch {
      res.innerHTML = '<p class="tec-empty">Error de red</p>';
    }
  }

  // ── Invite player via API ──
  async function invitePlayer(playerId, playerName, btn) {
    const teamId = getActiveTeamId();
    if (!teamId) { alert('Selecciona un equipo primero'); return; }
    btn.textContent = 'INVITANDO...';
    btn.disabled = true;
    try {
      const res = await fetch('/api/team-requests', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'invite', playerId, teamId }),
      });
      const data = await res.json();
      if (data.success) {
        btn.textContent = '✓ INVITADO';
        btn.style.borderColor = '#34d399';
        btn.style.color = '#34d399';
        loadSquad();
        loadInvites();
      } else {
        alert(data.error || 'Error al invitar');
        btn.textContent = 'INVITAR';
        btn.disabled = false;
      }
    } catch {
      alert('Error de red');
      btn.textContent = 'INVITAR';
      btn.disabled = false;
    }
  }

  // ── Kick player ──
  async function kickPlayer(requestId, playerName) {
    if (!confirm(`¿Eliminar a ${playerName} del equipo?`)) return;
    try {
      const res = await fetch('/api/team-requests', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'kick', id: requestId }),
      });
      const data = await res.json();
      if (data.success) {
        loadSquad();
      } else {
        alert(data.error || 'Error al eliminar jugador');
      }
    } catch {
      alert('Error de red');
    }
  }

  // ── Load pending invites ──
  async function loadInvites() {
    const list = $('invites-list');
    try {
      const res = await fetch('/api/team-requests?scope=pending');
      const data = await res.json();
      if (!data.success || !data.requests) {
        list.innerHTML = '<p class="tec-empty">Error al cargar</p>';
        return;
      }
      const invites = data.requests;
      if (!invites.length) {
        list.innerHTML = '<p class="tec-empty">No hay invitaciones pendientes.</p>';
        return;
      }
      list.innerHTML = invites.map(p => {
        const posLabel = FIFA_POS[p.player_position] || p.player_position || '—';
        return `
          <div class="tec-invite-item">
            <div class="tec-search-avatar">${p.player_image ? `<img src="${p.player_image}" style="width:100%;height:100%;object-fit:cover;border-radius:9px" />` : '👤'}</div>
            <div class="flex-1 min-w-0">
              <p style="font-size:.62rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--cream)">${esc(p.player_name)}</p>
              <p style="font-size:.45rem;letter-spacing:.08em;text-transform:uppercase;color:rgba(232,220,200,.25)">${esc(posLabel)}</p>
            </div>
            <span class="tec-invite-status tec-invite-status--pending">PENDIENTE</span>
          </div>
        `;
      }).join('');
    } catch {
      list.innerHTML = '<p class="tec-empty">Error de red</p>';
    }
  }

  document.querySelectorAll('[data-close]').forEach(btn => {
    btn.addEventListener('click', () => {
      $('modal-name').classList.add('hidden');
    });
  });
  document.querySelectorAll('.tec-overlay').forEach(ov => {
    ov.addEventListener('click', e => { if(e.target === ov) ov.classList.add('hidden'); });
  });

  renderHero(); loadSquad(); loadInvites();
})();
</script>
